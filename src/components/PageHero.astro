---
/*
 * The opening of every inner page. Always the dark band, so the header can sit
 * transparent over it and the page reads as one continuous object from the top.
 *
 * Three variants, chosen by which photographs are allowed to carry type:
 *
 *   photo  The image IS the background. Only for images whose scrim is baked
 *          and measured by scripts/make-images.mjs (the manifest records the
 *          ratio). Passing an unscrimmed image here throws at build time.
 *   split  Type on the navy, the photograph inset beside it. For every other
 *          image, which is most of them.
 *   plain  Type only. Legal pages, credits, 404.
 *
 * A `figure` slot replaces the inset photograph with anything else set beside
 * the copy (the industries mosaic). It lays out as `split`.
 */
import manifest from '../data/images.json';
import Img from './Img.astro';

interface Crumb { label: string; href?: string }
interface Props {
  eyebrow: string;
  /** May contain one <em> for the accent word. Passed through set:html. */
  title: string;
  lede?: string;
  image?: string;
  variant?: 'photo' | 'split' | 'plain';
  crumbs?: Crumb[];
}
const hasFigure = Astro.slots.has('figure');
const { eyebrow, title, lede, image, variant = image || hasFigure ? 'split' : 'plain', crumbs } = Astro.props;

if (variant === 'photo') {
  const m = manifest.images.find((i) => i.slug === image);
  if (!m || !('scrim' in m) || !m.scrim) {
    throw new Error(
      `PageHero: "${image}" has no measured scrim, so it cannot carry type as a background. ` +
      `Use variant="split", or add a scrim to it in src/data/images.json.`,
    );
  }
}
---
<section class:list={['page-hero', `page-hero--${variant}`]} aria-labelledby="page-h">
  {variant === 'photo' && image && (
    <div class="ph-bg" aria-hidden="true">
      <Img slug={image} sizes="100vw" alt="" loading="eager" fetchpriority="high" />
    </div>
  )}
  <div class="ph-glow" aria-hidden="true"></div>

  <div class="container ph-grid">
    <div class="ph-copy on-invert">
      {crumbs && (
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            {crumbs.map((c) => (
              <li>{c.href ? <a class="link-plain" href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
            ))}
          </ol>
        </nav>
      )}
      <p class="eyebrow">{eyebrow}</p>
      <h1 id="page-h" set:html={title} />
      {lede && <p class="lede ph-lede">{lede}</p>}
      <div class="ph-actions"><slot /></div>
    </div>

    {hasFigure && <div class="ph-figure"><slot name="figure" /></div>}
    {variant === 'split' && image && !hasFigure && (
      <div class="ph-figure">
        <div class="media ph-media">
          <Img slug={image} sizes="(min-width: 64rem) 36rem, 100vw" loading="eager" fetchpriority="high" />
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--surface-invert);
    color: var(--ink-invert);
    margin-top: calc((var(--header-h) + var(--header-inset)) * -1);
    padding-block: calc(var(--header-h) + clamp(3rem, 2rem + 4vw, 6rem)) clamp(3.5rem, 2.5rem + 4vw, 6.5rem);
  }
  .page-hero--photo { padding-block-end: clamp(5rem, 3rem + 6vw, 9rem); min-height: min(44rem, 88svh); display: flex; align-items: flex-end; }
  .page-hero--photo .container { width: 100%; }

  .ph-bg { position: absolute; inset: 0; z-index: -2; }
  /* On a photograph, only the ink its scrim was measured for. */
  .page-hero--photo :is(.eyebrow, .ph-lede, .crumbs ol, .crumbs a) { color: var(--ink-invert); }

  /* On a phone the photograph is a box across the top, served as its own crop
     with its own measured scrim, and the copy starts inside its faded foot. */
  @media (max-width: 47.99rem) {
    .page-hero--photo {
      --hero-media-h: min(88vw, 26rem);
      min-height: 0;
      display: block;
      padding-top: calc(var(--hero-media-h) - 6.5rem);
    }
    .page-hero--photo .ph-bg { bottom: auto; height: var(--hero-media-h); }
  }
  .ph-bg :global(picture), .ph-bg :global(img) { width: 100%; height: 100%; }
  .ph-bg :global(img) { object-fit: cover; }

  /* One soft warm light source, top right, screen-blended so it lifts rather
     than tints. On the photo variant it sits over the image's own darkness. */
  .ph-glow {
    position: absolute;
    z-index: -1;
    width: 42rem;
    height: 30rem;
    top: -16rem;
    right: -12rem;
    border-radius: 50%;
    background: oklch(34% 0.07 62);
    filter: blur(100px);
    mix-blend-mode: screen;
    pointer-events: none;
  }
  .page-hero--photo .ph-glow { display: none; }

  .ph-grid { display: grid; gap: var(--space-7); align-items: center; }
  @media (min-width: 64rem) {
    .page-hero--split .ph-grid { grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: var(--space-8); }
  }
  .ph-copy { max-width: 44rem; }
  .page-hero h1 { color: var(--ink-invert); max-width: 16ch; }
  .page-hero--plain h1 { max-width: 20ch; }
  .ph-lede { margin-top: var(--space-5); color: var(--muted-invert); max-width: 50ch; }
  .ph-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-6); }
  .ph-actions:empty { display: none; }

  .ph-media { aspect-ratio: 4 / 3; border-radius: var(--r-lg); box-shadow: var(--shadow-3); }
  .ph-media::after {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 4px;
    background: var(--brand-ramp);
    z-index: 1;
  }
  .ph-media :global(picture) { height: 100%; }

  /* --- breadcrumbs ------------------------------------------------------------ */
  .crumbs ol {
    list-style: none;
    margin: 0 0 var(--space-5);
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--muted-invert);
  }
  .crumbs li { display: inline-flex; align-items: center; gap: var(--space-2); }
  .crumbs li + li::before { content: "/"; opacity: 0.5; }
  .crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    color: var(--muted-invert);
  }
  .crumbs a:hover { color: var(--ink-invert); }
  .crumbs [aria-current] { color: var(--ink-invert); }
</style>
