---
import { site, serviceLines, packages } from '../data/site';
import Icon from './Icon.astro';

interface Props {
  /** The page opens on a dark hero, so the bar may start transparent over it. */
  overHero?: boolean;
}
const { overHero = false } = Astro.props;

const nav = [
  { label: 'Industries', href: '/industries/' },
  { label: 'Packages', href: '/packages/' },
  { label: 'About', href: '/about/' },
  { label: 'Contact', href: '/contact/' },
];

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const money = (n: number) => n.toLocaleString('en-US');
---
{/*
  THE HEADER HAS THREE STATES, and the safe one is the default.

  1. SOLID. Paper ground, navy ink, hairline under it. This is what renders
     with no JavaScript, on every page, always legible over anything.
  2. OVER THE HERO. Transparent, light ink, light mark — but only when the page
     has a dark hero AND the script has confirmed we are at the top. If the
     script never runs, the bar never goes transparent, so it can never end up
     as white text over a white page.
  3. SCROLLED. The one glass surface on the site: paper at 86% with the single
     site-wide blur, over whatever is scrolling underneath.

  The Services mega-menu opens on hover and on focus-within with no script at
  all; the chevron button exists so keyboard and touch users can open it
  without first navigating to /services/, and it carries aria-expanded.
*/}
<header class="site-header" data-hero={overHero ? 'dark' : undefined}>
  <div class="container bar">
    <a class="brand link-plain" href="/" aria-label={`${site.shortName}, home`}>
      <img class="mark mark--dark" src="/brand/mark-128.png" width="165" height="128" alt="" loading="lazy" decoding="async" />
      <img class="mark mark--light" src="/brand/mark-light-128.png" width="165" height="128" alt="" loading="lazy" decoding="async" />
      <span class="brand-name" aria-hidden="true">
        <span class="brand-a">Reliance</span>
        <span class="brand-b">Business Partners</span>
      </span>
    </a>

    <nav class="nav" aria-label="Primary">
      <ul class="nav-list">
        <li class="has-mega">
          <a class="nav-link link-plain" href="/services/" aria-current={isCurrent('/services/') ? 'page' : undefined}>Services</a>
          <button class="mega-toggle" type="button" aria-expanded="false" aria-controls="mega-services">
            <Icon name="chevron-down" size={16} stroke={2} />
            <span class="visually-hidden">Show the six services</span>
          </button>
          <div class="mega" id="mega-services">
            <div class="mega-inner">
              <ul class="mega-grid">
                {serviceLines.map((s) => (
                  <li>
                    <a class="mega-item link-plain" href={`/services/${s.slug}/`}>
                      <span class="icon-tile"><Icon name={s.icon} /></span>
                      <span class="mega-text">
                        <span class="mega-title">{s.title}</span>
                        <span class="mega-blurb">{s.blurb}</span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
              <a class="mega-feature link-plain" href="/packages/">
                <span class="mega-kicker">Company incorporation</span>
                <span class="mega-price display">from LKR {money(packages[0].price)}</span>
                <span class="mega-note">Three packages, every item listed, every fee published.</span>
                <span class="link-arrow">Compare packages <Icon name="arrow-right" size={16} stroke={2} /></span>
              </a>
            </div>
          </div>
        </li>
        {nav.map((item) => (
          <li>
            <a class="nav-link link-plain" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="actions">
      <a class="tel link-plain tnum" href={site.phoneHref}>
        <Icon name="phone" size={16} stroke={2} />
        {site.phone}
      </a>
      <a class="btn btn--primary cta" href="/#estimate">Estimate your fees</a>

      <details class="menu">
        <summary aria-label="Menu"><span class="bars" aria-hidden="true"></span></summary>
        <div class="menu-panel">
          <div class="container menu-inner">
            <p class="menu-label">Services</p>
            <ul class="menu-services">
              {serviceLines.map((s) => (
                <li><a class="link-plain" href={`/services/${s.slug}/`}><Icon name={s.icon} size={20} />{s.title}</a></li>
              ))}
            </ul>
            <ul class="menu-main">
              <li><a class="link-plain" href="/">Home</a></li>
              {nav.map((item) => <li><a class="link-plain" href={item.href}>{item.label}</a></li>)}
            </ul>
            <div class="menu-actions">
              <a class="btn btn--primary btn--block btn--lg" href="/#estimate">Estimate your fees</a>
              <a class="btn btn--secondary btn--block tnum" href={site.phoneHref}>{site.phone}</a>
              <a class="btn btn--secondary btn--block" href={`mailto:${site.email}`}>{site.email}</a>
            </div>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  if (header) {
    // --- state 2 and 3: transparent at the top of a dark hero, glass once scrolled.
    const hero = header.dataset.hero === 'dark';
    const setState = () => {
      const top = window.scrollY < 12;
      header.classList.toggle('is-top', hero && top);
      header.classList.toggle('is-scrolled', !top);
    };
    setState();
    window.addEventListener('scroll', setState, { passive: true });

    // --- the mega-menu toggle, for keyboard and touch -------------------------------
    const toggle = header.querySelector<HTMLButtonElement>('.mega-toggle');
    const item = header.querySelector<HTMLElement>('.has-mega');
    if (toggle && item) {
      const set = (open: boolean) => {
        item.classList.toggle('is-open', open);
        toggle.setAttribute('aria-expanded', String(open));
      };
      toggle.addEventListener('click', () => set(!item.classList.contains('is-open')));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { set(false); } });
      document.addEventListener('click', (e) => { if (!item.contains(e.target as Node)) set(false); });
    }

    // --- the mobile menu: close on navigation or Escape, lock the page behind it ---
    const menu = header.querySelector<HTMLDetailsElement>('.menu');
    if (menu) {
      menu.addEventListener('toggle', () => {
        document.documentElement.classList.toggle('menu-open', menu.open);
        header.classList.toggle('is-menu', menu.open);
      });
      menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { menu.open = false; }));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && menu.open) menu.open = false; });
    }
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    padding-top: env(safe-area-inset-top);
    background: var(--surface);
    border-bottom: 1px solid var(--line);
    transition: background-color var(--dur-control) var(--ease-out),
                border-color var(--dur-control) var(--ease-out),
                box-shadow var(--dur-control) var(--ease-out);
  }

  /* 3. scrolled: the site's one glass surface. */
  .site-header.is-scrolled {
    background: var(--glass-fill);
    border-bottom-color: transparent;
    box-shadow: inset 0 -1px 0 0 var(--glass-under), var(--shadow-1);
  }
  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    .site-header.is-scrolled {
      backdrop-filter: blur(var(--blur)) saturate(1.5);
      -webkit-backdrop-filter: blur(var(--blur)) saturate(1.5);
    }
  }
  @supports not (backdrop-filter: blur(1px)) {
    .site-header.is-scrolled { background: var(--glass-opaque); }
  }
  @media (prefers-reduced-transparency: reduce) {
    .site-header.is-scrolled { background: var(--glass-opaque); backdrop-filter: none; -webkit-backdrop-filter: none; }
  }

  /* An open menu drops the glass, and this is load-bearing. backdrop-filter
     makes the header the containing block for its position: fixed children, so
     with the glass on, the full-screen menu panel was laid out against the
     64px bar instead of the viewport: once the page was scrolled it rendered
     far above the screen while the page behind it was locked. The visitor saw
     a frozen page. */
  .site-header.is-menu {
    background: var(--surface);
    border-bottom-color: var(--line);
    box-shadow: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  /* 2. over the hero: transparent, light ink. */
  .site-header.is-top:not(.is-menu) {
    background: transparent;
    border-bottom-color: oklch(100% 0 0 / 0.12);
  }
  .mark--light { display: none; }
  .site-header.is-top:not(.is-menu) .mark--dark { display: none; }
  .site-header.is-top:not(.is-menu) .mark--light { display: block; }
  .site-header.is-top:not(.is-menu) :is(.brand-a, .nav-link, .tel, .mega-toggle) { color: var(--ink-invert); }
  /* Only ink-invert over a photograph: it is the ink make-images measures there. */
  .site-header.is-top:not(.is-menu) .brand-b { color: var(--ink-invert); }
  .site-header.is-top:not(.is-menu) .bars,
  .site-header.is-top:not(.is-menu) .bars::before,
  .site-header.is-top:not(.is-menu) .bars::after { background: var(--ink-invert); }
  .site-header.is-top:not(.is-menu) :focus-visible {
    outline-color: var(--focus-ring-inner);
    box-shadow: 0 0 0 4px var(--focus-ring);
  }

  .bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-5);
    height: var(--header-h);
  }

  /* --- brand ------------------------------------------------------------- */
  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex: none;
    line-height: 0;
    min-height: var(--tap-min);
  }
  .mark { width: auto; height: 32px; }
  .brand-name { display: grid; gap: 2px; line-height: 1; }
  .brand-a {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 650;
    letter-spacing: -0.025em;
    color: var(--ink);
  }
  .brand-b {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }

  /* --- nav ----------------------------------------------------------------- */
  .nav { display: none; margin-inline: auto; }
  .nav-list { display: flex; align-items: center; gap: var(--space-2); list-style: none; margin: 0; padding: 0; }
  .nav-list > li { position: relative; display: flex; align-items: center; }
  /* The Services item is NOT the positioning context for its panel: the bar
     is. A panel hung off the menu item with a fixed offset runs past the right
     edge at 1024px, and even while hidden it would widen the page. Anchored to
     the bar, it spans exactly the content column at every width. */
  .nav-list > li.has-mega { position: static; }
  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    padding-inline: var(--space-3);
    color: var(--ink-soft);
    font-size: var(--text-sm);
    font-weight: 600;
    position: relative;
    transition: color var(--dur-hover) var(--ease-out);
  }
  .nav-link::after {
    content: "";
    position: absolute;
    left: var(--space-3);
    right: var(--space-3);
    bottom: 8px;
    height: 2px;
    border-radius: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-control) var(--ease-out);
  }
  .nav-link:hover { color: var(--ink); }
  .nav-link:hover::after, .nav-link[aria-current="page"]::after { transform: scaleX(1); }
  .nav-link[aria-current="page"] { color: var(--ink); }

  .mega-toggle {
    display: grid;
    place-items: center;
    width: 28px;
    min-height: var(--tap-min);
    margin-inline-start: -8px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink-soft);
    cursor: pointer;
  }
  .mega-toggle :global(svg) { transition: transform var(--dur-control) var(--ease-out); }
  .has-mega:is(:hover, :focus-within, .is-open) .mega-toggle :global(svg) { transform: rotate(180deg); }

  /* --- mega menu ------------------------------------------------------------ */
  .mega {
    position: absolute;
    top: calc(100% - 6px);
    left: max(var(--gutter), env(safe-area-inset-left));
    right: max(var(--gutter), env(safe-area-inset-right));
    opacity: 0;
    visibility: hidden;
    transform: translate3d(0, -6px, 0);
    transition: opacity var(--dur-control) var(--ease-out),
                transform var(--dur-control) var(--ease-out),
                visibility 0s linear var(--dur-control);
  }
  /* A bridge across the gap, so the pointer can travel from the link into the
     panel without the hover ending halfway. */
  .mega::before { content: ""; position: absolute; left: 0; right: 0; top: -28px; height: 28px; }
  .has-mega:is(:hover, :focus-within, .is-open) .mega {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }
  .mega-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 19rem;
    gap: var(--space-4);
    padding: var(--space-4);
    background: var(--surface-raised);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-3);
  }
  .mega-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-1);
  }
  .mega-item {
    display: flex;
    gap: var(--space-4);
    padding: var(--space-3);
    border-radius: var(--r-sm);
    color: var(--ink);
    transition: background-color var(--dur-hover) var(--ease-out);
  }
  .mega-item:hover { background: var(--surface-sunken); color: var(--ink); }
  .mega-text { display: grid; gap: 2px; }
  .mega-title { font-weight: 700; font-size: var(--text-sm); }
  .mega-blurb { font-size: var(--text-xs); color: var(--muted); line-height: 1.45; }

  .mega-feature {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    border-radius: var(--r-md);
    background: var(--surface-invert);
    color: var(--ink-invert);
    position: relative;
    overflow: hidden;
  }
  .mega-feature::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: var(--brand-ramp);
  }
  .mega-kicker {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--muted-invert);
  }
  .mega-price { font-size: 1.9rem; line-height: 1.05; color: var(--ink-invert); }
  .mega-note { font-size: var(--text-xs); color: var(--muted-invert); line-height: 1.5; margin-bottom: auto; }
  .mega-feature .link-arrow { color: var(--accent-lift); margin-top: var(--space-4); }

  /* --- actions -------------------------------------------------------------- */
  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-inline-start: auto;
    flex: none;
  }
  .tel {
    display: none;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap-min);
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .tel :global(svg) { color: var(--accent-ink); }
  .site-header.is-top:not(.is-menu) .tel :global(svg) { color: var(--accent-lift); }
  .cta { display: none; }

  /* --- mobile menu: <details>, so it works with no JavaScript ---------------- */
  .menu { flex: none; }
  .menu summary {
    display: grid;
    place-items: center;
    width: var(--tap-min);
    height: var(--tap-min);
    border-radius: var(--r-sm);
    cursor: pointer;
    list-style: none;
  }
  .menu summary::-webkit-details-marker { display: none; }
  .bars, .bars::before, .bars::after {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--ink);
    border-radius: 2px;
    transition: transform var(--dur-control) var(--ease-out), opacity var(--dur-hover);
  }
  .bars { position: relative; }
  .bars::before, .bars::after { content: ""; position: absolute; left: 0; }
  .bars::before { top: -7px; }
  .bars::after { top: 7px; }
  .menu[open] .bars { background: transparent; }
  .menu[open] .bars::before { transform: translateY(7px) rotate(45deg); }
  .menu[open] .bars::after { transform: translateY(-7px) rotate(-45deg); }

  .menu-panel {
    position: fixed;
    left: 0;
    right: 0;
    top: calc(var(--header-h) + env(safe-area-inset-top));
    bottom: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--surface);
    border-top: 1px solid var(--line);
    padding-block: var(--space-5) var(--space-8);
  }
  .menu-inner { display: grid; gap: var(--space-6); }
  .menu-label {
    font-size: var(--text-eyebrow);
    font-weight: 700;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--accent-ink);
    margin-bottom: calc(var(--space-4) * -1);
  }
  .menu-services, .menu-main { list-style: none; margin: 0; padding: 0; display: grid; }
  .menu-services a {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 52px;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-weight: 600;
  }
  .menu-services a :global(svg) { color: var(--accent-ink); flex: none; }
  .menu-main a {
    display: flex;
    align-items: center;
    min-height: 56px;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    color: var(--ink);
    border-bottom: 1px solid var(--line);
  }
  .menu-actions { display: grid; gap: var(--space-3); }

  /* The panel drops in, and its groups follow a beat apart. */
  @media (prefers-reduced-motion: no-preference) {
    .menu[open] .menu-panel { animation: menu-in 0.32s var(--ease-out) backwards; }
    .menu[open] .menu-inner > * { animation: menu-item-in 0.45s var(--ease-out) backwards; }
    .menu[open] .menu-inner > :nth-child(2) { animation-delay: 40ms; }
    .menu[open] .menu-inner > :nth-child(3) { animation-delay: 90ms; }
    .menu[open] .menu-inner > :nth-child(4) { animation-delay: 140ms; }
  }
  @keyframes menu-in { from { opacity: 0; transform: translate3d(0, -10px, 0); } }
  @keyframes menu-item-in { from { opacity: 0; transform: translate3d(0, 14px, 0); } }

  :global(html.menu-open) { overflow: hidden; }

  /* Below 22rem the two-line name and the menu button start to fight. */
  @media (max-width: 22rem) { .brand-b { display: none; } }

  @media (min-width: 64rem) {
    .mark { height: 38px; }
    .brand-a { font-size: 1.5rem; }
    .nav { display: block; }
    .cta { display: inline-flex; }
    .menu { display: none; }
  }
  @media (min-width: 80rem) {
    .tel { display: inline-flex; }
  }
</style>
