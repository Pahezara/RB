---
import { site, packages, whatsappHref } from '../data/site';
import { categories, servicesIn } from '../data/services';
import Icon from './Icon.astro';

interface Props {
  /** The page opens on a dark hero, so the bar may start transparent over it. */
  overHero?: boolean;
}
const { overHero = false } = Astro.props;

/* The [CONTENT] menu, tightened for first-time visitors (2026-10-23): Services
   leads, because it is what people come for; Pricing is added, because the
   published fees are the firm's clearest differentiator; Home is the logo, as
   on every site people already know. Services renders with its mega menu. */
const before: { label: string; href: string }[] = [];
const after = [
  { label: 'Pricing', href: '/packages/' },
  { label: 'About', href: '/about/' },
  { label: 'Management', href: '/management/' },
  { label: 'Insights', href: '/insights/' },
  { label: 'Contact Us', href: '/contact/' },
];
const wa = whatsappHref('Hello Reliance Business Partners, I would like to discuss my requirements.');

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const money = (n: number) => n.toLocaleString('en-US');
---
{/*
  THE HEADER HAS THREE STATES, and the safe one is the default.

  1. SOLID. Paper ground, navy ink, hairline under it. This is what renders
     with no JavaScript, on every page, always legible over anything.
  2. OVER THE HERO. Transparent, light ink, light mark — but only when the page
     has a dark hero AND the script has confirmed we are at the top. If the
     script never runs, the bar never goes transparent, so it can never end up
     as white text over a white page.
  3. SCROLLED. The one glass surface on the site: paper at 86% with the single
     site-wide blur, over whatever is scrolling underneath.

  The Services mega-menu opens on hover and on focus-within with no script at
  all; the chevron button exists so keyboard and touch users can open it
  without first navigating to /services/, and it carries aria-expanded.
*/}
{/* The top strip (redesigned 2026-10-23): a quiet line in the dark of the
    hero rather than a second toolbar. The tagline on the left, the four direct
    routes on the right, small and evenly spaced. The estimate moved into the
    header itself. It scrolls away; the header below it stays. Hidden on phones,
    where the menu carries all of it. */}
<div class="topbar">
  <div class="container topbar-in">
    <p class="tb-left"><span class="tb-dot" aria-hidden="true"></span><span>{site.tagline}<span class="tb-wide">: {site.taglineSub}</span></span></p>
    <ul class="tb-right">
      <li><a class="link-plain tnum" href={site.phoneHref}><Icon name="phone" size={13} stroke={2} /> {site.phone}</a></li>
      <li><a class="link-plain" href={`mailto:${site.email}`}><Icon name="mail" size={13} stroke={2} /> {site.email}</a></li>
      <li><a class="link-plain" href={wa} target="_blank" rel="noopener"><Icon name="message-circle" size={13} stroke={2} /> WhatsApp</a></li>
      <li><a class="link-plain" href={site.social.linkedin} rel="noopener"><Icon name="briefcase-business" size={13} stroke={2} /> LinkedIn</a></li>
    </ul>
  </div>
</div>

<header class="site-header" data-hero={overHero ? 'dark' : undefined}>
  <div class="container bar">
    <a class="brand link-plain" href="/" aria-label={`${site.shortName}, home`}>
      <img class="mark mark--dark" src="/brand/mark-128.png" width="165" height="128" alt="" loading="lazy" decoding="async" />
      <img class="mark mark--light" src="/brand/mark-light-128.png" width="165" height="128" alt="" loading="lazy" decoding="async" />
      <span class="brand-name" aria-hidden="true">
        <span class="brand-a">Reliance</span>
        <span class="brand-b">Business Partners</span>
      </span>
    </a>

    <nav class="nav" aria-label="Primary">
      <ul class="nav-list">
        {before.map((item) => (
          <li>
            <a class="nav-link link-plain" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
        <li class="has-mega">
          <a class="nav-link link-plain" href="/services/" aria-current={isCurrent('/services/') ? 'page' : undefined}>Services</a>
          <button class="mega-toggle" type="button" aria-expanded="false" aria-controls="mega-services">
            <Icon name="chevron-down" size={16} stroke={2} />
            <span class="visually-hidden">Show all services</span>
          </button>
          <div class="mega" id="mega-services">
            <div class="mega-inner">
              <div class="mega-cols">
                {categories.map((c) => (
                  <div class="mega-col">
                    <a class="mega-cat link-plain" href={`/services/#${c.slug}`}>
                      <span class="icon-tile"><Icon name={c.icon} size={18} /></span>
                      {c.title}
                    </a>
                    <ul>
                      {servicesIn(c.slug).map((sv) => (
                        <li><a class="mega-link link-plain" href={`/services/${sv.slug}/`}>{sv.title}</a></li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
              <div class="mega-foot">
                <a class="mega-feature link-plain" href="/packages/">
                  <span class="mega-kicker">Company incorporation</span>
                  <span class="mega-price display">from LKR {money(packages[0].price)}</span>
                  <span class="link-arrow">Compare packages <Icon name="arrow-right" size={16} stroke={2} /></span>
                </a>
                <a class="mega-plain link-plain" href="/investors/"><Icon name="hand-coins" size={18} /> Investors and business owners</a>
                <a class="mega-plain link-plain" href="/industries/"><Icon name="factory" size={18} /> Industries we support</a>
                <a class="mega-plain link-plain" href="/services/"><Icon name="layers" size={18} /> View all services</a>
              </div>
            </div>
          </div>
        </li>
        {after.map((item) => (
          <li>
            <a class="nav-link link-plain" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="actions">
      <a class="est link-plain" href="/estimate/" aria-current={isCurrent('/estimate/') ? 'page' : undefined}><Icon name="calculator" size={16} stroke={2} /> Get an estimate</a>
      <a class="btn btn--primary cta" href={wa} target="_blank" rel="noopener"><Icon name="message-circle" size={16} stroke={2} /> Discuss Your Requirements</a>
      <a class="btn btn--primary cta-compact" href={wa} target="_blank" rel="noopener" aria-label="Discuss your requirements on WhatsApp"><Icon name="message-circle" size={20} stroke={2} /></a>

      <details class="menu">
        <summary aria-label="Menu"><span class="bars" aria-hidden="true"></span></summary>
        <div class="menu-panel">
          <div class="container menu-inner">
            <ul class="menu-main">
              <li><a class="link-plain" href="/">Home</a></li>
              <li>
                <a class="link-plain" href="/services/">Services</a>
                <div class="menu-cats">
                  {categories.map((c) => (
                    <details class="menu-cat">
                      <summary><Icon name={c.icon} size={20} />{c.title}<Icon name="chevron-down" size={18} stroke={2} class="menu-chev" /></summary>
                      <ul>
                        {servicesIn(c.slug).map((sv) => <li><a class="link-plain" href={`/services/${sv.slug}/`}>{sv.title}</a></li>)}
                      </ul>
                    </details>
                  ))}
                </div>
              </li>
              {after.map((item) => <li><a class="link-plain" href={item.href}>{item.label}</a></li>)}
            </ul>
            <div class="menu-actions">
              <a class="btn btn--primary btn--block btn--lg" href={wa} target="_blank" rel="noopener"><Icon name="message-circle" size={18} stroke={2} /> Discuss Your Requirements</a>
              <a class="btn btn--secondary btn--block" href="/estimate/">Get an instant quotation</a>
              <a class="btn btn--secondary btn--block tnum" href={site.phoneHref}>{site.phone}</a>
            </div>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  if (header) {
    // --- state 2 and 3: transparent at the top of a dark hero, glass once scrolled.
    const hero = header.dataset.hero === 'dark';
    const setState = () => {
      const top = window.scrollY < 12;
      header.classList.toggle('is-top', hero && top);
      header.classList.toggle('is-scrolled', !top);
    };
    setState();
    window.addEventListener('scroll', setState, { passive: true });

    // --- the mega-menu toggle, for keyboard and touch -------------------------------
    const toggle = header.querySelector<HTMLButtonElement>('.mega-toggle');
    const item = header.querySelector<HTMLElement>('.has-mega');
    if (toggle && item) {
      const set = (open: boolean) => {
        item.classList.toggle('is-open', open);
        toggle.setAttribute('aria-expanded', String(open));
      };
      toggle.addEventListener('click', () => set(!item.classList.contains('is-open')));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { set(false); } });
      document.addEventListener('click', (e) => { if (!item.contains(e.target as Node)) set(false); });
    }

    // --- the mobile menu: close on navigation or Escape, lock the page behind it ---
    const menu = header.querySelector<HTMLDetailsElement>('.menu');
    if (menu) {
      menu.addEventListener('toggle', () => {
        document.documentElement.classList.toggle('menu-open', menu.open);
        header.classList.toggle('is-menu', menu.open);
      });
      menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { menu.open = false; }));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && menu.open) menu.open = false; });
    }
  }
</script>

<style>
  /* --- the top strip --------------------------------------------------------- */
  .topbar { display: none; position: relative; z-index: 101; background: var(--surface-invert); color: var(--muted-invert); font-size: 0.75rem; }
  .topbar::after { content: ""; position: absolute; inset: auto 0 0 0; height: 1px; background: linear-gradient(90deg, transparent, var(--line-invert) 15%, var(--line-invert) 85%, transparent); }
  @media (min-width: 64rem) { .topbar { display: block; } }
  .topbar-in { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); min-height: 2.25rem; }
  .tb-left { display: inline-flex; align-items: center; gap: var(--space-2); margin: 0; letter-spacing: 0.01em; }
  .tb-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--brand-ramp); box-shadow: 0 0 0 3px oklch(70% 0.17 50 / 0.18); }
  .tb-right { display: flex; align-items: center; list-style: none; margin: 0; padding: 0; }
  .tb-right li + li { border-left: 1px solid var(--line-invert); }
  .topbar a { display: inline-flex; align-items: center; gap: 0.4rem; min-height: 2.25rem; padding-inline: var(--space-4); color: var(--muted-invert); font-weight: 500; white-space: nowrap; transition: color var(--dur-hover) var(--ease-out); }
  .tb-right li:last-child a { padding-right: 0; }
  .topbar a:hover { color: var(--ink-invert); }
  .topbar :global(svg) { color: var(--accent-lift); flex: none; }
  .topbar .tb-wide { display: none; }
  @media (min-width: 80rem) { .topbar .tb-wide { display: inline; } }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    padding-top: env(safe-area-inset-top);
    background: var(--surface);
    border-bottom: 1px solid var(--line);
    transition: background-color var(--dur-control) var(--ease-out),
                border-color var(--dur-control) var(--ease-out),
                box-shadow var(--dur-control) var(--ease-out);
  }

  /* 3. scrolled: the site's one glass surface. */
  .site-header.is-scrolled {
    background: var(--glass-fill);
    border-bottom-color: transparent;
    box-shadow: inset 0 -1px 0 0 var(--glass-under), var(--shadow-1);
  }
  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    .site-header.is-scrolled {
      backdrop-filter: blur(var(--blur)) saturate(1.5);
      -webkit-backdrop-filter: blur(var(--blur)) saturate(1.5);
    }
  }
  @supports not (backdrop-filter: blur(1px)) {
    .site-header.is-scrolled { background: var(--glass-opaque); }
  }
  @media (prefers-reduced-transparency: reduce) {
    .site-header.is-scrolled { background: var(--glass-opaque); backdrop-filter: none; -webkit-backdrop-filter: none; }
  }

  /* An open menu drops the glass, and this is load-bearing. backdrop-filter
     makes the header the containing block for its position: fixed children, so
     with the glass on, the full-screen menu panel was laid out against the
     64px bar instead of the viewport: once the page was scrolled it rendered
     far above the screen while the page behind it was locked. The visitor saw
     a frozen page. */
  .site-header.is-menu {
    background: var(--surface);
    border-bottom-color: var(--line);
    box-shadow: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  /* 2. over the hero: transparent, light ink. */
  .site-header.is-top:not(.is-menu) {
    background: transparent;
    border-bottom-color: transparent;
  }
  .mark--light { display: none; }
  .site-header.is-top:not(.is-menu) .mark--dark { display: none; }
  .site-header.is-top:not(.is-menu) .mark--light { display: block; }
  .site-header.is-top:not(.is-menu) :is(.brand-a, .nav-link, .tel, .mega-toggle, .est) { color: var(--ink-invert); }
  .site-header.is-top:not(.is-menu) .nav-list { background: oklch(100% 0 0 / 0.06); border-color: var(--line-invert); }
  .site-header.is-top:not(.is-menu) .nav-link:hover { background: oklch(100% 0 0 / 0.1); color: var(--ink-invert); }
  .site-header.is-top:not(.is-menu) .nav-link[aria-current="page"] { background: var(--ink-invert); color: var(--ink); }
  .site-header.is-top:not(.is-menu) .est :global(svg) { color: var(--accent-lift); }
  /* Only ink-invert over a photograph: it is the ink make-images measures there. */
  .site-header.is-top:not(.is-menu) .brand-b { color: var(--ink-invert); }
  .site-header.is-top:not(.is-menu) .bars,
  .site-header.is-top:not(.is-menu) .bars::before,
  .site-header.is-top:not(.is-menu) .bars::after { background: var(--ink-invert); }
  .site-header.is-top:not(.is-menu) :focus-visible {
    outline-color: var(--focus-ring-inner);
    box-shadow: 0 0 0 4px var(--focus-ring);
  }

  .bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-5);
    height: var(--header-h);
  }

  /* --- brand ------------------------------------------------------------- */
  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex: none;
    line-height: 0;
    min-height: var(--tap-min);
  }
  .mark { width: auto; height: 32px; }
  .brand-name { display: grid; gap: 3px; line-height: 1; font-family: var(--font-wordmark); }
  .brand-a {
    font-family: var(--font-wordmark);
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: 0.005em;
    color: var(--ink);
  }
  .brand-b {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }

  /* --- nav ----------------------------------------------------------------- */
  .nav { display: none; margin-inline: auto; }
  /* The menu sits in a rail: one pill holding the links, the current page
     filled. It reads as a single control, centred between the mark and the
     actions, and keeps its shape over the hero and on paper. */
  .nav-list {
    display: flex; align-items: center; gap: 2px; list-style: none; margin: 0; padding: 4px;
    border: 1px solid var(--line); border-radius: var(--r-pill); background: oklch(100% 0 0 / 0.55);
    transition: background-color var(--dur-control) var(--ease-out), border-color var(--dur-control) var(--ease-out);
  }
  .nav-list > li { position: relative; display: flex; align-items: center; }
  /* The Services item is NOT the positioning context for its panel: the bar
     is. A panel hung off the menu item with a fixed offset runs past the right
     edge at 1024px, and even while hidden it would widen the page. Anchored to
     the bar, it spans exactly the content column at every width. */
  .nav-list > li.has-mega { position: static; }
  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding-inline: 0.85rem;
    border-radius: var(--r-pill);
    color: var(--ink-soft);
    font-size: 0.8125rem;
    font-weight: 550;
    letter-spacing: -0.005em;
    white-space: nowrap;
    transition: color var(--dur-hover) var(--ease-out), background-color var(--dur-hover) var(--ease-out);
  }
  .nav-link:hover { color: var(--ink); background: var(--surface-sunken); }
  .nav-link[aria-current="page"] { color: var(--ink-invert); background: var(--ink); }
  .has-mega .nav-link { padding-right: 0.35rem; }

  .mega-toggle {
    display: grid;
    place-items: center;
    width: 26px;
    min-height: 2.25rem;
    margin-inline-end: 4px;
    border-radius: var(--r-pill);
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink-soft);
    cursor: pointer;
  }
  .mega-toggle :global(svg) { transition: transform var(--dur-control) var(--ease-out); }
  .has-mega:is(:hover, :focus-within, .is-open) .mega-toggle :global(svg) { transform: rotate(180deg); }

  /* --- mega menu ------------------------------------------------------------ */
  .mega {
    position: absolute;
    top: calc(100% - 6px);
    left: max(var(--gutter), env(safe-area-inset-left));
    right: max(var(--gutter), env(safe-area-inset-right));
    opacity: 0;
    visibility: hidden;
    transform: translate3d(0, -6px, 0);
    transition: opacity var(--dur-control) var(--ease-out),
                transform var(--dur-control) var(--ease-out),
                visibility 0s linear var(--dur-control);
  }
  /* A bridge across the gap, so the pointer can travel from the link into the
     panel without the hover ending halfway. */
  .mega::before { content: ""; position: absolute; left: 0; right: 0; top: -28px; height: 28px; }
  .has-mega:is(:hover, :focus-within, .is-open) .mega {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }
  .mega-inner {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
    background: var(--surface-raised);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-3);
    max-height: calc(100svh - var(--header-h) - 2rem);
    overflow-y: auto;
  }
  .mega-cols { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: var(--space-5); }
  .mega-cat {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--tap-min);
    margin-bottom: var(--space-2);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--line);
    font-weight: 700;
    font-size: var(--text-sm);
    line-height: 1.25;
    color: var(--ink);
  }
  .mega-cat .icon-tile { width: 2.25rem; height: 2.25rem; flex: none; }
  .mega-cat:hover { color: var(--accent-ink); }
  .mega-col ul { list-style: none; margin: 0; padding: 0; display: grid; }
  .mega-link {
    display: flex;
    align-items: center;
    min-height: 2.25rem;
    padding: var(--space-1) 0;
    font-size: var(--text-xs);
    line-height: 1.35;
    color: var(--ink-soft);
    transition: color var(--dur-hover) var(--ease-out), transform var(--dur-hover) var(--ease-out);
  }
  .mega-link:hover { color: var(--accent-ink); transform: translate3d(3px, 0, 0); }
  .mega-foot {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
    align-items: stretch;
  }
  .mega-feature {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--r-md);
    background: var(--surface-invert);
    color: var(--ink-invert);
    position: relative;
    overflow: hidden;
  }
  .mega-feature::before { content: ""; position: absolute; inset: 0 0 auto 0; height: 3px; background: var(--brand-ramp); }
  .mega-feature:hover { color: var(--ink-invert); }
  .mega-kicker { font-size: var(--text-xs); font-weight: 700; letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; color: var(--muted-invert); width: 100%; }
  .mega-price { font-size: 1.35rem; line-height: 1.1; color: var(--ink-invert); }
  .mega-feature .link-arrow { color: var(--accent-lift); margin-left: auto; }
  .mega-plain {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--r-md);
    background: var(--surface-sunken);
    color: var(--ink);
    font-weight: 600;
    font-size: var(--text-sm);
    line-height: 1.3;
  }
  .mega-plain :global(svg) { color: var(--accent-ink); flex: none; }
  .mega-plain:hover { color: var(--ink); background: var(--accent-tint); }

  /* --- actions -------------------------------------------------------------- */
  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-inline-start: auto;
    flex: none;
  }
  .tel {
    display: none;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap-min);
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .tel :global(svg) { color: var(--accent-ink); }
  .site-header.is-top:not(.is-menu) .tel :global(svg) { color: var(--accent-lift); }
  .est {
    display: none; align-items: center; gap: 0.4rem; min-height: var(--tap-min);
    color: var(--ink); font-size: 0.8125rem; font-weight: 600; white-space: nowrap;
    transition: color var(--dur-hover) var(--ease-out);
  }
  .est :global(svg) { color: var(--accent-ink); }
  .est:hover { color: var(--accent-ink); }
  .site-header.is-top:not(.is-menu) .est:hover { color: var(--accent-lift); }
  .cta, .cta-compact { border-radius: var(--r-pill); }
  .cta { display: none; min-height: 2.5rem; padding: 0.5rem 1.1rem; font-size: 0.8125rem; }
  .cta-compact { width: 44px; min-height: 44px; padding: 0; place-items: center; }

  /* --- mobile menu: <details>, so it works with no JavaScript ---------------- */
  .menu { flex: none; }
  .menu > summary {
    display: grid;
    place-items: center;
    width: var(--tap-min);
    height: var(--tap-min);
    border-radius: var(--r-sm);
    cursor: pointer;
    list-style: none;
  }
  .menu > summary::-webkit-details-marker { display: none; }
  .bars, .bars::before, .bars::after {
    display: block;
    width: 22px;
    height: 2px;
