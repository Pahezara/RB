---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Img from '../../components/Img.astro';
import Icon from '../../components/Icon.astro';
import { engagement, whatsappHref } from '../../data/site';
import { categories, servicesIn, services, startingPoints } from '../../data/services';

const title = 'Business Services in Sri Lanka and Beyond | RBPL';
const description =
  'Company formation, accounting, payroll, secretarial, tax, ERP, Power BI, advisory, funding and approvals: every service Reliance Business Partners offers.';
const wa = whatsappHref('Hello Reliance Business Partners, I would like to discuss my requirements.');
---
<Base title={title} description={description} overHero>
  <PageHero
    eyebrow="Services"
    title="Everything your business needs, <em>in five groups.</em>"
    lede="Pick one service or combine several. Either way, you get a written scope and fee before any work starts."
    image="ind-professional"
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Services' }]}
  >
    <a class="btn btn--primary btn--lg" href={wa} target="_blank" rel="noopener"><Icon name="message-circle" size={18} stroke={2} /> Discuss Your Requirements</a>
    <a class="btn btn--ghost btn--lg" href="/estimate/">Get an instant quotation</a>
  </PageHero>

  <nav class="jump" aria-label="Service categories">
    <div class="container">
      <ul>
        {categories.map((c) => (
          <li><a class="link-plain" href={`#${c.slug}`}><Icon name={c.icon} size={18} /> {c.title}</a></li>
        ))}
      </ul>
    </div>
  </nav>

  {/* [CONTENT] "Choose a starting point". */}
  <section class="section" aria-labelledby="begin-h">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">Not sure where to begin?</p>
          <h2 id="begin-h">Choose a <em>starting point.</em></h2>
        </div>
        <p class="intro">
          {services.length} services in five groups. Start from what your business needs
          next, and we will connect the rest.
        </p>
      </div>
      <ul class="needs">
        {startingPoints.map((p) => (
          <li>
            <a class="need link-plain" href={p.href}>
              <span class="icon-tile"><Icon name={p.icon} /></span>
              <span class="need-q">&ldquo;{p.need}&rdquo;</span>
              <span class="need-next">{p.next} <Icon name="arrow-right" size={16} stroke={2} /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {categories.map((c, ci) => (
    <section id={c.slug} class:list={['section', 'cat', ci % 2 === 0 && 'band']} aria-labelledby={`${c.slug}-h`}>
      <div class="container">
        <div class:list={['cat-head', ci % 2 === 1 && 'cat-head--flip']}>
          <div class="media cat-media">
            <Img slug={c.image} sizes="(min-width: 64rem) 34rem, 100vw" alt="" />
          </div>
          <div class="cat-copy">
            <p class="cat-n tnum">{String(ci + 1).padStart(2, '0')} / 05</p>
            <p class="eyebrow">{c.title}</p>
            <h2 id={`${c.slug}-h`}>{c.headline}</h2>
            <p class="lede">{c.body}</p>
          </div>
        </div>
        <ul class="cat-grid">
          {servicesIn(c.slug).map((s) => (
            <li>
              <a class="card svc link-plain" href={`/services/${s.slug}/`}>
                <span class="icon-tile"><Icon name={s.icon} /></span>
                <h3>{s.title}</h3>
                <p>{s.blurb}</p>
                <span class="link-arrow">Explore <Icon name="arrow-right" size={16} stroke={2} /></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <section class="section" aria-labelledby="eng-h">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">How we start</p>
          <h2 id="eng-h">One relationship for <em>connected business needs.</em></h2>
        </div>
        <p class="intro">
          A new company needs more than registration. A growing business needs more
          than historical accounts. An investor needs more than a promising
          opportunity. We help connect the financial, operational, technology and
          compliance work behind your next decision.
        </p>
      </div>
      <ol class="steps steps--3">
        {engagement.map((e) => (
          <li class="step">
            <span class="step-n">{e.n}</span>
            <h3>{e.title}</h3>
            <p>{e.detail}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .jump {
    position: sticky;
    top: var(--header-h);
    z-index: 50;
    background: var(--surface-raised);
    border-bottom: 1px solid var(--line);
  }
  .jump ul { list-style: none; margin: 0; padding: 0; display: flex; gap: var(--space-1); overflow-x: auto; scrollbar-width: none; }
  .jump ul::-webkit-scrollbar { display: none; }
  @media (min-width: 64rem) {
    .jump ul { justify-content: center; gap: 0; }
    .jump a { padding-inline: var(--space-3); font-size: 0.875rem; }
  }
  .jump a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 52px;
    padding-inline: var(--space-3);
    white-space: nowrap;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink-soft);
    border-bottom: 2px solid transparent;
  }
  .jump a:hover { color: var(--ink); border-bottom-color: var(--accent); }
  .jump a :global(svg) { flex: none; color: var(--accent-ink); }

  .needs { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4); }
  @media (min-width: 40rem) { .needs { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 72rem) { .needs { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .need {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    height: 100%;
    padding: var(--pad-card);
    background: var(--surface-raised);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    color: var(--ink);
    transition: transform var(--dur-control) var(--ease-out), box-shadow var(--dur-control) var(--ease-out), border-color var(--dur-hover);
  }
  .need:hover { transform: translate3d(0, -4px, 0); box-shadow: var(--shadow-2); border-color: var(--line-strong); color: var(--ink); }
  .need-q { font-size: var(--text-h4); font-weight: 600; line-height: 1.35; letter-spacing: -0.01em; }
  .need-next { margin-top: auto; display: inline-flex; align-items: center; gap: var(--space-2); font-size: var(--text-sm); font-weight: 650; color: var(--accent-ink); }

  .cat { scroll-margin-top: calc(var(--header-h) + 52px); }
  .cat-head { display: grid; gap: var(--space-6); align-items: center; margin-bottom: var(--space-7); }
  @media (min-width: 64rem) {
    .cat-head { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-9); }
    .cat-head--flip .cat-media { order: 2; }
  }
  .cat-media { aspect-ratio: 16 / 10; border-radius: var(--r-lg); box-shadow: var(--shadow-2); }
  .cat-media :global(picture) { height: 100%; }
  .cat-n { font-size: var(--text-xs); font-weight: 700; letter-spacing: var(--tracking-eyebrow); color: var(--muted); margin-bottom: var(--space-4); }
  .cat-copy .lede { margin-top: var(--space-5); }

  .cat-grid { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4); }
  @media (min-width: 40rem) { .cat-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .cat-grid { grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: var(--space-5); } }
  .svc { height: 100%; }
  .svc h3 { font-size: var(--text-h4); font-family: var(--font-sans); font-weight: 700; letter-spacing: -0.01em; }
  .svc p { color: var(--muted); font-size: var(--text-sm); }
  .svc .link-arrow { margin-top: auto; padding-top: var(--space-2); }

  @media (min-width: 68rem) { .steps--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); --cols: 3; } }
</style>
