---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Img from '../../components/Img.astro';
import Icon from '../../components/Icon.astro';
import { serviceLines, engagement, packages } from '../../data/site';

const title = 'Services — Reliance Business Partners';
const description =
  'Accounting and BPO, tax and assurance, business advisory, payroll, Power BI and corporate secretarial, from one firm of professionals in Nugegoda, Colombo.';
const money = (n: number) => n.toLocaleString('en-US');
---
<Base title={title} description={description} overHero>
  <PageHero
    eyebrow="Services"
    title="Six disciplines. <em>One firm.</em>"
    lede="Most clients start with one of these and end up with three. That is the point of having them under one roof: the ledger the accountant keeps is the ledger the tax computation is built from."
    image="ind-professional"
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Services' }]}
  >
    <a class="btn btn--primary btn--lg" href="/contact/">Talk to the team <Icon name="arrow-right" size={18} stroke={2} /></a>
    <a class="btn btn--ghost btn--lg" href="/packages/">Incorporation packages</a>
  </PageHero>

  {/* One editorial row per line, photograph alternating sides. */}
  <section class="section" aria-label="The six services">
    <div class="container">
      <ol class="lines">
        {serviceLines.map((s, i) => (
          <li class:list={['line', i % 2 === 1 && 'line--flip']} id={s.slug}>
            <a class="media line-media hoverable" href={`/services/${s.slug}/`} tabindex="-1" aria-hidden="true">
              <Img slug={s.image} sizes="(min-width: 64rem) 36rem, 100vw" alt="" />
            </a>
            <div class="line-body">
              <div class="line-top">
                <span class="icon-tile"><Icon name={s.icon} /></span>
                <span class="line-n tnum">{String(i + 1).padStart(2, '0')} / 06</span>
              </div>
              <h2 class="line-h"><a class="link-plain" href={`/services/${s.slug}/`}>{s.title}</a></h2>
              <p class="line-lead">{s.lead}</p>
              <ul class="ticks line-covers">
                {s.covers.map((c) => <li>{c}</li>)}
              </ul>
              {'note' in s && s.note && <p class="line-note"><Icon name="scale" size={18} />{s.note}</p>}
              <div class="row line-actions">
                {/* Never lowercased: the titles carry acronyms (BPO, Power BI). */}
                <a class="link-arrow" href={`/services/${s.slug}/`}>Explore this service <Icon name="arrow-right" size={16} stroke={2} /></a>
                {'packagesHref' in s && s.packagesHref && (
                  <a class="price-chip link-plain" href={s.packagesHref}>From LKR {money(packages[0].price)}</a>
                )}
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* How any engagement starts. */}
  <section class="section band" aria-labelledby="eng-h">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">How we start</p>
          <h2 id="eng-h">Three steps, and the fee is <em>in writing</em> before the first piece of work.</h2>
        </div>
        <p class="intro">
          The same way in for every one of the six lines. For a company
          incorporation, the packages page has the whole sequence and every fee.
        </p>
      </div>
      <ol class="steps steps--3">
        {engagement.map((e) => (
          <li class="step">
            <span class="step-n">{e.n}</span>
            <h3>{e.title}</h3>
            <p>{e.detail}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .lines { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(4rem, 3rem + 4vw, 7.5rem); }
  .line { display: grid; gap: var(--space-6); align-items: center; scroll-margin-top: calc(var(--header-h) + 2rem); }
  @media (min-width: 64rem) {
    .line { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-9); }
    .line--flip .line-media { order: 2; }
  }
  .line-media { display: block; aspect-ratio: 5 / 4; border-radius: var(--r-lg); }
  .line-media :global(picture) { height: 100%; }
  .line-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-5); }
  .line-n { font-size: var(--text-xs); font-weight: 700; letter-spacing: var(--tracking-eyebrow); color: var(--muted); }
  .line-h { font-size: var(--text-h2); }
  .line-h a { color: var(--ink); }
  .line-h a:hover { color: var(--accent-ink); }
  .line-lead { margin-top: var(--space-4); color: var(--ink-soft); font-size: var(--text-lede); line-height: 1.55; }
  .line-covers { margin-top: var(--space-6); padding-top: var(--space-5); border-top: 1px solid var(--line); }
  @media (min-width: 40rem) { .line-covers { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-6); } }
  .line-note {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    margin-top: var(--space-5);
    padding: var(--space-4);
    border-radius: var(--r-sm);
    background: var(--accent-tint);
    font-size: var(--text-sm);
  }
  .line-note :global(svg) { flex: none; color: var(--accent-ink); margin-top: 2px; }
  .line-actions { margin-top: var(--space-6); gap: var(--space-5); }
  .price-chip {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    padding: 0 var(--space-4);
    border-radius: var(--r-pill);
    background: var(--surface-invert);
    color: var(--ink-invert);
    font-size: var(--text-xs);
    font-weight: 700;
  }
  .price-chip:hover { background: var(--surface-invert-2); color: var(--ink-invert); }

  @media (min-width: 68rem) { .steps--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); --cols: 3; } }
</style>
