---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, faqs, packages, credentials, platforms, extras, whatsappHref } from '../data/site';
import { categories, servicesIn, services, serviceBySlug } from '../data/services';

/*
 * HOME, third pass (2026-10-23). The client found the clean version "boring",
 * so this one keeps its clear order (promise, situation, reach, price, process,
 * proof) and gives each part a signature moment:
 *
 *   hero     full-bleed cinema: the five service-group photographs crossfade
 *            behind the copy, driven by a dock of five tabs with live progress,
 *            and the headline's last line turns over every few seconds.
 *   ribbon   all 24 services running past on the brand orange.
 *   paths    four photographic panels that open as you move across them.
 *   reach    a dot-matrix Sri Lanka, drawn at build time from a coastline,
 *            with the Nugegoda office and a slow wave out across the island.
 *   prices   the three packages as cards, the most complete one lit.
 *   how      three steps with outlined numerals.
 *   why      a dark bento with a light that follows the pointer.
 *
 * Every fact still comes from src/data; nothing here is invented (D1).
 */
const title = 'Business Services in Sri Lanka | Reliance Business Partners';
const description =
  'Company registration, accounting, payroll, tax and advisory in Sri Lanka. One team in Nugegoda, and fees you can see before you call.';

const wa = whatsappHref('Hello Reliance Business Partners, I would like to discuss my requirements.');
const money = (n: number) => n.toLocaleString('en-US');
const bare = (t: string) => t.replace(/ in Sri Lanka$/, '');

/* Short tab labels for the five service groups, for narrow screens. */
const short: Record<string, string> = { start: 'Start', finance: 'Finance', systems: 'Systems', invest: 'Growth', approvals: 'Approvals' };

/* The last line of the headline, in turn. The real sentence is read once by
   assistive technology from a visually hidden copy. */
const turns = ['registered right.', 'run smoothly.', 'grown with intent.', 'sold on your terms.'];

/* Where are you today? Four situations, three services each. */
const paths = [
  { title: 'Starting a business', body: 'Register your company in Sri Lanka, Colombo Port City or the UAE, and get every registration that follows in place.', svc: ['company-registration', 'port-city', 'uae-company-formation'], cta: 'Start here', href: '/services/company-registration/', img: 'colombo-golden' },
  { title: 'Running a business', body: 'Books, payroll, tax and company filings kept up to date every month, without hiring a finance team.', svc: ['accounting', 'payroll', 'secretarial'], cta: 'Get monthly support', href: '/services/accounting/', img: 'work-desk' },
  { title: 'Growing a business', body: 'Better systems, clearer numbers and a solid plan for the funding behind your next step.', svc: ['erp', 'analytics', 'funding'], cta: 'Plan your growth', href: '/services/advisory/', img: 'svc-advisory' },
  { title: 'Buying, selling or fixing one', body: 'Due diligence before you invest, a well-prepared sale, or a practical plan when results are slipping.', svc: ['due-diligence', 'business-sale', 'turnaround'], cta: 'Talk in confidence', href: '/investors/', img: 'ind-professional' },
].map((p) => ({ ...p, svc: p.svc.map(serviceBySlug) }));

const steps = [
  { title: 'Tell us what you need', body: 'WhatsApp, call or e-mail. Plain words are fine; you do not need the technical term.' },
  { title: 'Get the scope and fee in writing', body: 'You know exactly what will be done, and what it costs, before any work starts.' },
  { title: 'We get it done', body: 'Monthly, yearly or one-off, exactly as agreed, with updates along the way.' },
];

const top = faqs.slice(0, 6);

/* Customise your requirement: a short questionnaire for anyone a standard
   package does not fit. It has no server; the answers are written into a
   WhatsApp or e-mail message the visitor sends from their own app (D10). */
const web = extras.find((e) => e.slug === 'website')!;
const quiz = {
  stage: ['Starting a new company', 'Already registered', 'Setting up from overseas'],
  needs: ['Company registration', 'Company secretarial', 'Accounting and bookkeeping', 'Payroll', 'Tax', 'Other registrations and approvals', 'Advisory or funding'],
  site: ['No website needed', `New website (from LKR ${money(web.price)})`, 'Redesign of an existing site', 'Not sure yet'],
  when: ['This month', 'Within three months', 'Just exploring'],
};
const quizHello = 'Hello Reliance Business Partners, I would like a customised quotation.';

/* --- the island, as dots ----------------------------------------------------
   A simplified coastline (latitude, longitude), projected flat at 100 units a
   degree, then filled with a 9-unit grid of dots by a point-in-polygon test.
   Built once, at build time; the page ships plain SVG circles. */
const coast: [number, number][] = [
  [9.83, 80.22], [9.79, 80.03], [9.67, 79.92], [9.52, 80.1], [9.3, 80.04], [9.1, 79.92],
  [8.98, 79.9], [8.75, 79.93], [8.5, 79.88], [8.22, 79.73], [8.0, 79.82], [7.6, 79.8],
  [7.2, 79.83], [6.93, 79.85], [6.6, 79.95], [6.3, 80.03], [6.05, 80.18], [5.94, 80.45],
  [5.92, 80.6], [6.02, 80.8], [6.12, 81.1], [6.25, 81.35], [6.45, 81.62], [6.85, 81.83],
  [7.3, 81.85], [7.72, 81.7], [8.0, 81.5], [8.3, 81.4], [8.57, 81.23], [8.9, 81.02],
  [9.27, 80.82], [9.55, 80.55], [9.75, 80.35],
];
const LON0 = 79.55, LAT0 = 9.95, K = 100;
const proj = (lat: number, lon: number) => [(lon - LON0) * K, (LAT0 - lat) * K] as const;
const poly = coast.map(([la, lo]) => proj(la, lo));
const inside = (x: number, y: number) => {
  let hit = false;
  for (let a = 0, b = poly.length - 1; a < poly.length; b = a++) {
    const [xa, ya] = poly[a], [xb, yb] = poly[b];
    if ((ya > y) !== (yb > y) && x < ((xb - xa) * (y - ya)) / (yb - ya) + xa) hit = !hit;
  }
  return hit;
};
const office = proj(6.87, 79.89);   // Nugegoda
const dots: { x: number; y: number; heat: number; tw: number }[] = [];
for (let y = 4.5, row = 0; y < 410; y += 9, row++) {
  for (let x = 4.5 + (row % 2) * 4.5; x < 240; x += 9) {
    if (!inside(x, y)) continue;
    const d = Math.hypot(x - office[0], y - office[1]);
    dots.push({ x, y, heat: Math.max(0, 1 - d / 95), tw: (Math.round(x * 7 + y * 13) % 11) === 0 ? 1 : 0 });
  }
}
/* Label positions as percentages of the figure, so they stay HTML text. */
const VB = { x: -30, y: -10, w: 300, h: 430 };
const pct = ([x, y]: readonly [number, number]) => `left:${(((x - VB.x) / VB.w) * 100).toFixed(2)}%;top:${(((y - VB.y) / VB.h) * 100).toFixed(2)}%`;
---
<Base title={title} description={description} overHero>

  {/* ================================================================== HERO */}
  <section class="hero" aria-labelledby="hero-h" data-slider>
    <div class="hero-bg" aria-hidden="true">
      {categories.map((c, i) => (
        <div class:list={['hb', { 'is-on': i === 0 }]} data-bg={i}>
          <Img slug={c.slide} sizes="100vw" alt="" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} />
        </div>
      ))}
    </div>
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="hero-grain" aria-hidden="true"></div>

    <div class="container hero-in">
      <div class="hero-copy on-invert">
        <p class="hero-pill"><span class="dot-live" aria-hidden="true"></span> {site.tagline} <span class="pill-sep" aria-hidden="true">·</span> since {site.founded}</p>
        <h1 id="hero-h" class="hero-h">
          <span class="visually-hidden">Your business, registered, run, grown and sold with one trusted partner.</span>
          <span class="hh-1" aria-hidden="true">Your business,</span>
          <span class="rot" aria-hidden="true">{turns.map((t, i) => <span style={`--i:${i}`}>{t}</span> )}</span>
        </h1>
        <p class="hero-lede">
          One team for company registration, accounting, payroll, tax, systems and
          advisory, from our office in Nugegoda. Fees published before you call.
        </p>
        <div class="hero-actions">
          <a class="btn btn--primary btn--lg" href="/estimate/"><Icon name="calculator" size={18} stroke={2} /> Get a free estimate</a>
          <a class="btn btn--ghost btn--lg" href={wa} target="_blank" rel="noopener"><Icon name="message-circle" size={18} stroke={2} /> Talk on WhatsApp</a>
        </div>
        <ul class="hero-proof" aria-label="At a glance">
          <li><b class="tnum">17</b> professionals</li>
          <li><b class="tnum">{services.length}</b> services</li>
          <li><b class="tnum">LKR {money(packages[0].price)}</b> incorporation from</li>
        </ul>
      </div>

      {/* The dock: five service groups, each with its own photograph behind the hero. */}
      <div class="dock" role="tablist" aria-label="Our services" data-ctrl hidden>
        {categories.map((c, i) => (
          <button type="button" role="tab" class="dock-tab" id={`tab-${c.slug}`} aria-controls={`pane-${c.slug}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-dot={i}>
            <span class="dock-bar" aria-hidden="true"><span></span></span>
            <span class="dock-n tnum" aria-hidden="true">0{i + 1}</span>
            <span class="dock-l dock-l--long">{c.title}</span><span class="dock-l dock-l--short">{short[c.slug]}</span>
          </button>
        ))}
      </div>

      <div class="deck on-invert">
        {categories.map((c, i) => (
          <article class="deck-pane" id={`pane-${c.slug}`} role="tabpanel" aria-labelledby={`tab-${c.slug}`} data-slide>
            <p class="deck-k"><Icon name={c.icon} size={15} /> {c.title}</p>
            <h2 class="deck-h">{c.headline}</h2>
            <ul class="deck-list">
              {servicesIn(c.slug).slice(0, 4).map((s) => (
                <li><a class="link-plain" href={`/services/${s.slug}/`}>{bare(s.title)}<Icon name="arrow-up-right" size={14} stroke={2} /></a></li>
              ))}
            </ul>
            <a class="deck-more link-plain" href={`/services/#${c.slug}`}>All {servicesIn(c.slug).length} services in this group <Icon name="arrow-right" size={14} stroke={2} /></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ================================================================== RIBBON */}
  <div class="ribbon" aria-hidden="true">
    <div class="ribbon-track">
      {[0, 1].map(() => (
        <div class="ribbon-set">
          {services.map((s) => <span>{bare(s.title)}<i>✦</i></span>)}
        </div>
      ))}
    </div>
  </div>

  {/* ================================================================== PATHS */}
  <section class="section" aria-labelledby="paths-h">
    <div class="container">
      <div class="head head--split">
        <div>
          <p class="kicker"><span class="tnum">01</span> Where are you today?</p>
          <h2 id="paths-h">Pick your situation. <em>We take it from there.</em></h2>
        </div>
        <p class="head-aside">Not sure which fits? <a href="/services/">Browse all {services.length} services</a> or <a href={wa} target="_blank" rel="noopener">just ask us</a>.</p>
      </div>
      <ul class="panels">
        {paths.map((p, i) => (
          <li class="panel">
            <div class="panel-bg" aria-hidden="true"><Img slug={p.img} sizes="(min-width: 64rem) 40rem, 100vw" alt="" /></div>
            <div class="panel-in on-invert">
              <span class="panel-n tnum">0{i + 1}</span>
              <h3>{p.title}</h3>
              <div class="panel-more"><div>
                <p>{p.body}</p>
                <ul class="panel-svcs">
                  {p.svc.map((s) => <li><a class="chip link-plain" href={`/services/${s.slug}/`}><Icon name={s.icon} size={14} /> {bare(s.title)}</a></li>)}
                </ul>
                <a class="link-arrow" href={p.href}>{p.cta} <Icon name="arrow-right" size={16} stroke={2} /></a>
              </div></div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ================================================================== REACH */}
  <section class="section reach on-invert" aria-labelledby="reach-h">
    <div class="reach-glow" aria-hidden="true"></div>
    <div class="container reach-in">
      <div class="reach-copy">
        <p class="kicker kicker--dark"><span class="tnum">02</span> Local roots</p>
        <h2 id="reach-h">One office in Nugegoda. <em>Clients across Sri Lanka.</em></h2>
        <p class="reach-lede">
          Our team works from our office in Nugegoda, Colombo. From here we support
          businesses across the island, and owners who run their Sri Lankan company
          from overseas.
        </p>
        <dl class="figs">
          {credentials.map((f) => (
            <div>
              <dt class="visually-hidden">{f.label}</dt>
              <dd><span class="fig-n tnum" data-count={f.count ? f.n : undefined}>{f.n}</span><span class="fig-l" aria-hidden="true">{f.label}</span></dd>
            </div>
          ))}
        </dl>
        <ul class="places">
          <li><a class="link-plain" href="/contact/"><Icon name="map-pin" size={16} /> {site.address.street}, {site.address.locality}</a></li>
          <li><a class="link-plain tnum" href={site.phoneHref}><Icon name="phone" size={16} /> {site.phone}</a></li>
        </ul>
      </div>

      <figure class="map" aria-label="Map of Sri Lanka showing our office in Nugegoda">
        <svg viewBox={`${VB.x} ${VB.y} ${VB.w} ${VB.h}`} role="presentation" focusable="false">
          <g class="map-dots">
            {dots.map((d) => (
              <circle cx={d.x} cy={d.y} r="2.7" class:list={[{ 'is-tw': d.tw && !d.heat, hot: d.heat > 0 }]} fill-opacity={d.heat > 0 ? (0.25 + 0.75 * d.heat).toFixed(2) : undefined} />
            ))}
          </g>
          <circle class="map-wave" cx={office[0]} cy={office[1]} r="40" />
          <circle class="map-wave map-wave--2" cx={office[0]} cy={office[1]} r="40" />
          <circle class="map-ring" cx={office[0]} cy={office[1]} r="6" />
          <circle class="map-ring map-ring--2" cx={office[0]} cy={office[1]} r="6" />
          <circle class="map-pin" cx={office[0]} cy={office[1]} r="6" />
        </svg>
        <span class="map-label map-label--office" style={pct(office)}><b>Nugegoda</b> our office</span>
      </figure>
    </div>
  </section>

  {/* ================================================================== PRICES */}
  <section class="section" aria-labelledby="price-h">
    <div class="container">
      <div class="head head--split">
        <div>
          <p class="kicker"><span class="tnum">03</span> Prices on the table</p>
          <h2 id="price-h">Register your company <em>from LKR {money(packages[0].price)}.</em></h2>
        </div>
        <p class="head-aside">Every item listed, every fee published, and the first year’s secretarial retainer included in each package.</p>
      </div>
      <ul class="plans">
        {packages.map((p, i) => {
          const hi = i === packages.length - 1;
          return (
            <li class:list={['plan', { 'plan--hi on-invert': hi }]}>
              <p class="plan-top"><span class="plan-name">{p.name}</span>{hi && <span class="plan-tag">Most complete</span>}</p>
              <p class="plan-price"><small>LKR</small> <span class="tnum">{money(p.price)}</span></p>
              <p class="plan-sum">{p.summary}</p>
              <p class="plan-meta"><Icon name="check" size={14} stroke={2.25} /> {p.includes.length} items · one director · +LKR {money(p.perDirector)} each extra</p>
              <a class:list={['btn btn--block', hi ? 'btn--primary' : 'btn--dark']} href={`/estimate/?package=${p.slug}`}>Estimate with {p.name} <Icon name="arrow-right" size={16} stroke={2} /></a>
            </li>
          );
        })}
      </ul>
      <p class="plans-foot">
        <span>Need a website, POS, tax filings or payroll as well?</span>
        <a class="link-arrow" href="/estimate/">Build your full estimate <Icon name="arrow-right" size={16} stroke={2} /></a>
        <a class="link-arrow" href="/packages/">Compare every item <Icon name="arrow-right" size={16} stroke={2} /></a>
        <a class="link-arrow" href="#customise">Customise your requirement <Icon name="arrow-down" size={16} stroke={2} /></a>
      </p>

      <form id="customise" class="quiz" aria-labelledby="quiz-h" data-quiz data-wa={site.whatsapp} data-email={site.email}>
        <div class="quiz-intro on-invert">
          <p class="kicker kicker--dark">Not a standard package?</p>
          <h3 id="quiz-h">Customise your requirement.</h3>
          <p>Answer a few quick questions. We reply with a scope and fee built for your business, in writing, before any work starts.</p>
          <ol class="quiz-steps" aria-hidden="true"><li>Your stage</li><li>What you need</li><li>Web design</li><li>Timing</li></ol>
        </div>
        <div class="quiz-body">
          <fieldset>
            <legend><span class="q-n tnum">1</span> Where is your business today?</legend>
            <div class="opts">{quiz.stage.map((o, i) => <label class="opt"><input type="radio" name="stage" value={o} checked={i === 0} /><span>{o}</span></label>)}</div>
          </fieldset>
          <fieldset>
            <legend><span class="q-n tnum">2</span> What do you need? <small>Tick all that apply</small></legend>
            <div class="opts">{quiz.needs.map((o) => <label class="opt"><input type="checkbox" name="needs" value={o} /><span>{o}</span></label>)}</div>
          </fieldset>
          <fieldset class="q-web">
            <legend><span class="q-n tnum">3</span> Web design</legend>
            <div class="opts">{quiz.site.map((o, i) => <label class="opt"><input type="radio" name="site" value={o} checked={i === 0} /><span>{o}</span></label>)}</div>
          </fieldset>
          <div class="q-row">
            <fieldset>
              <legend><span class="q-n tnum">4</span> When do you want to start?</legend>
              <div class="opts">{quiz.when.map((o, i) => <label class="opt"><input type="radio" name="when" value={o} checked={i === 1} /><span>{o}</span></label>)}</div>
            </fieldset>
            <label class="q-dirs"><span><span class="q-n tnum">5</span> Directors</span><input type="number" name="directors" min="1" max="20" value="1" inputmode="numeric" /></label>
          </div>
          <label class="q-note"><span>Anything else we should know? <small>Optional</small></span><textarea name="note" rows="3" maxlength="600" placeholder="For example: the type of business, number of staff, the software you use."></textarea></label>
          <div class="q-send">
            <a class="btn btn--primary" data-quiz-wa href={whatsappHref(quizHello)} target="_blank" rel="noopener"><Icon name="message-circle" size={16} stroke={2} /> Send on WhatsApp</a>
            <a class="btn btn--secondary" data-quiz-mail href={`mailto:${site.email}?subject=${encodeURIComponent('Customised quotation request')}`}><Icon name="mail" size={16} stroke={2} /> Send by e-mail</a>
            <p class="q-fine">Your answers open in your own WhatsApp or e-mail app. Nothing is stored on this website.</p>
          </div>
        </div>
      </form>
    </div>
  </section>

  {/* ================================================================== HOW */}
  <section class="section band" aria-labelledby="how-h">
    <div class="container">
      <div class="head">
        <p class="kicker"><span class="tnum">04</span> How it works</p>
        <h2 id="how-h">Three steps, <em>no surprises.</em></h2>
      </div>
      <ol class="how">
        {steps.map((s, i) => (
          <li class="how-step">
            <span class="how-n tnum" aria-hidden="true">0{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ================================================================== WHY */}
  <section class="section why on-invert" aria-labelledby="why-h">
    <div class="container">
      <div class="head">
        <p class="kicker kicker--dark"><span class="tnum">05</span> Why Reliance</p>
        <h2 id="why-h">Practical people, <em>clear answers.</em></h2>
      </div>
      <div class="bento" data-spot>
        <div class="tile tile--wide">
          <Icon name="users-round" size={22} />
          <h3>One point of contact</h3>
          <p>From the day your company is registered to its monthly accounts and annual filings, you deal with one team that already knows your business.</p>
        </div>
        <div class="tile">
          <Icon name="badge-check" size={22} />
          <h3>Qualified directors</h3>
          <p>Chartered and management accountants lead the work. <a href="/management/">Meet them</a>.</p>
        </div>
        <div class="tile">
          <Icon name="receipt" size={22} />
          <h3>Fees in the open</h3>
          <p>Published incorporation prices, and a written fee for everything else before work starts.</p>
        </div>
        <div class="tile tile--wide">
          <Icon name="layers" size={22} />
          <h3>Works in your software</h3>
          <p>We work in the accounting, payroll and reporting systems below, and can help you choose and set one up.</p>
          <ul class="soft">{platforms.map((p) => <li>{p}</li>)}<li>eHRIS</li></ul>
        </div>
        <div class="tile tile--accent tile--full">
          <Icon name="handshake" size={22} />
          <div>
            <h3>Backed by Chartered Accountants</h3>
            <p>Tax and audit run through our affiliated practices, <a href={site.affiliate.href} rel="noopener">{site.affiliate.name}</a> and Sanjeewa Associates.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ================================================================== FAQ */}
  <section id="faq" class="section" aria-labelledby="faq-h">
    <div class="container faq-grid">
      <div class="faq-side">
        <p class="kicker"><span class="tnum">06</span> Questions</p>
        <h2 id="faq-h">Good to <em>know.</em></h2>
        <p class="lead">Anything else is one message away.</p>
        <a class="btn btn--dark" href={wa} target="_blank" rel="noopener"><Icon name="message-circle" size={18} stroke={2} /> Ask on WhatsApp</a>
      </div>
      <div class="faq">
        {top.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <div class="answer"><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* --- the hero dock ---------------------------------------------------------
     Five tabs drive the panel and the photograph behind the hero. Autoplay at
     seven seconds, paused on hover, focus, off screen, a hidden tab or reduced
     motion; a deliberate choice stops it for good. Without JavaScript the dock
     stays hidden and all five panels stack. */
  const root = document.querySelector<HTMLElement>('[data-slider]');
  if (root) {
    const panes = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    const bgs = Array.from(root.querySelectorAll<HTMLElement>('[data-bg]'));
    const DUR = 7000;
    let i = 0, timer = 0, hover = false, inView = true, stopped = reduce;

    root.classList.add('is-live');
    root.querySelectorAll<HTMLElement>('[data-ctrl]').forEach((el) => { el.hidden = false; });
    root.style.setProperty('--slide-dur', `${DUR}ms`);

    const show = (n: number, focus = false) => {
      i = (n + panes.length) % panes.length;
      panes.forEach((p, k) => { p.hidden = k !== i; });
      bgs.forEach((b, k) => b.classList.toggle('is-on', k === i));
      tabs.forEach((t, k) => { t.setAttribute('aria-selected', String(k === i)); t.tabIndex = k === i ? 0 : -1; });
      if (focus) tabs[i].focus();
      tabs[i].scrollIntoView({ block: 'nearest', inline: 'nearest' });
      root.classList.remove('is-ticking'); void root.offsetWidth; root.classList.add('is-ticking');
    };
    const running = () => !stopped && !hover && inView && !document.hidden;
    const schedule = () => {
      window.clearTimeout(timer);
      root.classList.toggle('is-paused', !running());
      if (running()) timer = window.setTimeout(() => { show(i + 1); schedule(); }, DUR);
    };

    tabs.forEach((t) => {
      t.addEventListener('click', () => { stopped = true; show(Number(t.dataset.dot)); schedule(); });
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
          e.preventDefault(); stopped = true; show(i + (e.key === 'ArrowRight' ? 1 : -1), true); schedule();
        }
      });
    });
    const deck = root.querySelector<HTMLElement>('.deck')!;
    deck.addEventListener('pointerenter', () => { hover = true; schedule(); });
    deck.addEventListener('pointerleave', () => { hover = false; schedule(); });
    root.addEventListener('focusin', () => { hover = true; schedule(); });
    root.addEventListener('focusout', (e) => { if (!root.contains(e.relatedTarget as Node)) { hover = false; schedule(); } });
    document.addEventListener('visibilitychange', schedule);
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => { inView = e.isIntersecting; schedule(); }, { threshold: 0.25 }).observe(root);
    }
    let x0: number | null = null;
    deck.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    deck.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 50) { stopped = true; show(i + (dx < 0 ? 1 : -1)); schedule(); }
      x0 = null;
    });
    // first paint: no scrollIntoView jump
    panes.forEach((p, k) => { p.hidden = k !== 0; });
    root.classList.add('is-ticking');
    schedule();
  }

  /* --- customise your requirement: the answers become the message ---------- */
  const quiz = document.querySelector<HTMLFormElement>('[data-quiz]');
  if (quiz) {
    const wa = quiz.querySelector<HTMLAnchorElement>('[data-quiz-wa]')!;
    const mail = quiz.querySelector<HTMLAnchorElement>('[data-quiz-mail]')!;
    const write = () => {
      const f = new FormData(quiz);
      const needs = f.getAll('needs').join(', ') || 'Not sure yet';
      const note = String(f.get('note') || '').trim();
      const text = [
        'Hello Reliance Business Partners, I would like a customised quotation.',
        '',
        `Stage: ${f.get('stage')}`,
        `Services: ${needs}`,
        `Web design: ${f.get('site')}`,
        `Directors: ${f.get('directors') || 1}`,
        `Start: ${f.get('when')}`,
        ...(note ? ['', note] : []),
      ].join('\n');
      wa.href = `https://wa.me/${quiz.dataset.wa}?text=${encodeURIComponent(text)}`;
      mail.href = `mailto:${quiz.dataset.email}?subject=${encodeURIComponent('Customised quotation request')}&body=${encodeURIComponent(text)}`;
    };
    quiz.addEventListener('input', write);
    quiz.addEventListener('change', write);
    quiz.addEventListener('submit', (e) => e.preventDefault());
    write();
  }

  /* --- the map's wave starts once it is on screen --------------------------- */
  const map = document.querySelector<HTMLElement>('.map');
  if (map && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(([e]) => {
      if (e.isIntersecting) { map.classList.add('is-in'); io.disconnect(); }
    }, { threshold: 0.35 });
    io.observe(map);
  } else map?.classList.add('is-in');

  /* --- the bento's light follows the pointer -------------------------------- */
  const spot = document.querySelector<HTMLElement>('[data-spot]');
  if (spot && !reduce && window.matchMedia('(hover: hover)').matches) {
    spot.addEventListener('pointermove', (e) => {
      for (const t of spot.children as HTMLCollectionOf<HTMLElement>) {
        const r = t.getBoundingClientRect();
        t.style.setProperty('--mx', `${e.clientX - r.left}px`);
        t.style.setProperty('--my', `${e.clientY - r.top}px`);
      }
    });
  }

  /* --- figures count up once; the real numbers are already in the HTML ---- */
  const nums = document.querySelectorAll<HTMLElement>('[data-count]');
  if (nums.length && !reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        io.unobserve(e.target);
        const el = e.target as HTMLElement;
        const end = Number(el.dataset.count);
        const t0 = performance.now();
        const tick = (t: number) => {
          const p = Math.min(1, (t - t0) / 1200);
          el.textContent = String(Math.round(end * (1 - Math.pow(1 - p, 3))));
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }
    }, { threshold: 0.6 });
    nums.forEach((n) => io.observe(n));
  }
</script>

