---
import Base from '../layouts/Base.astro';
import Estimator from '../components/Estimator.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, faqs, credentials, whatsappHref } from '../data/site';
import { categories, servicesIn, services, startingPoints, serviceBySlug } from '../data/services';

/* [CONTENT] Homepage: title and meta description. */
const title = 'Business Services in Sri Lanka | Reliance Business Partners';
const description =
  'Start, manage and grow your business with RBPL. Explore company registration, outsourced accounting, ERP and investment support in Sri Lanka and beyond.';

const wa = whatsappHref('Hello Reliance Business Partners, I would like to discuss my requirements.');
const waIntl = whatsappHref('Hello Reliance Business Partners, I would like to plan a business setup in Sri Lanka.');
const ownerLinks = ['funding', 'due-diligence', 'business-sale'].map(serviceBySlug);

if (credentials.find((c) => c.label === 'Specialist services')?.n !== services.length) {
  throw new Error('index.astro: the credentials count the wrong number of services');
}

/*
 * The page follows the structure of sa.lk, the affiliated practice's site, at
 * SAJ's request (2026-10-15): a photographic hero, four action cards rising
 * over its foot, the business journey in stages, an image-and-text company
 * block, service cards, "why choose us" with figures, and the systems the firm
 * works in. The words are RBPL's own: [CONTENT] and src/data.
 */

/* The journey, in eight stages. Each stage names services the firm offers and
   links to the page for one of them; none of it is a new claim. */
const journey = [
  { n: '01', title: 'Setup and market entry', body: 'Company registration in Sri Lanka, Colombo Port City setup or a UAE company.', href: '/services/company-registration/' },
  { n: '02', title: 'Registrations', body: 'Customs registration, trademark and logo registration, and the tax and banking steps that follow incorporation.', href: '/services/customs-registration/' },
  { n: '03', title: 'Books and records', body: 'Bookkeeping, reconciliations and management accounts in eFS, QuickBooks, Xero, Zoho, Odoo or ERPNext.', href: '/services/accounting/' },
  { n: '04', title: 'Payroll and compliance', body: 'Monthly payroll and statutory schedules, corporate secretarial filings and the beneficial ownership register.', href: '/services/payroll/' },
  { n: '05', title: 'Tax and assurance', body: 'Tax planning and computations, and audit coordination through the affiliated practices.', href: '/services/tax/' },
  { n: '06', title: 'Systems and controls', body: 'ERP, Power BI dashboards, SOPs, internal controls and fixed asset registers.', href: '/services/erp/' },
  { n: '07', title: 'Growth and funding', body: 'Business plans, feasibility studies, financial models and investor or lender preparation.', href: '/services/funding/' },
  { n: '08', title: 'Change and exit', body: 'Due diligence, valuations, business sale or divestment, and turnaround support.', href: '/services/business-sale/' },
];

/* [CONTENT] Accounting: "work with eFS, QuickBooks, Xero, Zoho, Odoo and
   ERPNext"; Power BI from the analytics page; eHRIS from the payroll brief.
   Plain descriptions of the tools, and no partner status is claimed. */
const stack = [
  { name: 'eFS', kind: 'ERP and accounting', body: 'Financials and inventory in a localised cloud ERP.' },
  { name: 'eHRIS', kind: 'HR and payroll', body: 'Employee records, attendance and payroll in one cloud system.' },
  { name: 'QuickBooks', kind: 'Cloud accounting', body: 'Bookkeeping, invoicing and bank feeds.' },
  { name: 'Xero', kind: 'Cloud accounting', body: 'Bookkeeping, bank reconciliation and reporting.' },
  { name: 'Zoho Books', kind: 'Cloud accounting', body: 'Invoicing, expenses and tax ledgers.' },
  { name: 'Odoo', kind: 'ERP', body: 'Accounting, inventory, sales and CRM together.' },
  { name: 'ERPNext', kind: 'ERP', body: 'Open-source planning, stock and distribution.' },
  { name: 'Power BI', kind: 'Analytics', body: 'Dashboards built from your own figures.' },
];
---
<Base title={title} description={description} overHero>

  {/* ================================================================== 1. HERO
      One photograph, the Port of Colombo, with its baked and measured scrim
      (slide-start in src/data/images.json). The five service groups have their
      own slider further down, so the page does not carry two carousels. */}
  <section class="hero" aria-labelledby="hero-h">
    <div class="hero-bg" aria-hidden="true">
      <Img slug="slide-start" sizes="100vw" alt="" loading="eager" fetchpriority="high" />
    </div>

    <div class="container">
      <div class="hero-copy on-invert">
        <p class="eyebrow"><span>{site.shortName}<span class="eb-wide"> (Pvt) Ltd</span></span></p>
        <h1 id="hero-h" class="hero-h">
          <span class="line"><span>Build your business with a partner who</span></span>
          <span class="line"><span><em>sees the whole picture.</em></span></span>
        </h1>
        <p class="lede hero-lede">
          From company formation and day-to-day finance to systems, funding readiness
          and business transformation, Reliance Business Partners brings the support
          you need into one coordinated relationship.
        </p>
        <div class="row hero-actions">
          <a class="btn btn--primary btn--lg" href={wa} target="_blank" rel="noopener"><Icon name="message-circle" size={18} stroke={2} /> Discuss Your Requirements</a>
          <a class="btn btn--ghost btn--lg" href="/estimate/"><Icon name="calculator" size={18} stroke={2} /> Get an Estimate</a>
        </div>

        <p class="hero-trust">Established in {site.founded} <span aria-hidden="true">|</span> Local and international business support</p>
      </div>
    </div>
  </section>

  {/* ================================================================== 2. QUICK CARDS
      [CONTENT] "What does your business need next", as four cards rising over
      the foot of the hero. */}
  <section class="quick" aria-labelledby="quick-h">
    <div class="container">
      <h2 id="quick-h" class="visually-hidden">What does your business need next?</h2>
      <ul class="quick-grid">
        {startingPoints.map((p, i) => (
          <li>
            <a class="qc link-plain" href={p.href}>
              <span class="qc-top">
                <span class="icon-tile"><Icon name={p.icon} /></span>
                <span class="qc-badge">{p.need.replace(/^I want to |^I need |^My business needs /, '').replace(/^./, (c) => c.toUpperCase())}</span>
              </span>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
              <span class="link-arrow">{p.next} <Icon name="arrow-right" size={16} stroke={2} /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>


  {/* ================================================================== 3. SERVICE SHOWCASE
      Five slides, one per service group: photograph, headline, description,
      every service in the group, and the two next steps. Tabs, arrows, swipe
      and pause; autoplay stops on hover, focus, off screen and under reduced
      motion. Without JavaScript all five slides simply stack. */}
  <section class="section show" aria-labelledby="show-h" data-slider>
    <div class="container">
      <div class="section-head section-head--center">
        <p class="pill-k">What we do</p>
        <h2 id="show-h">Five groups of services, <em>one coordinated relationship.</em></h2>
      </div>

      <div class="show-tabs" role="tablist" aria-label="Service groups" data-ctrl hidden>
        {categories.map((c, i) => (
          <button type="button" role="tab" class="tab" id={`tab-${c.slug}`} aria-controls={`slide-${c.slug}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-dot={i}>
            <Icon name={c.icon} size={18} /> <span>{c.title}</span><span class="tab-bar" aria-hidden="true"></span>
          </button>
        ))}
      </div>

      <div class="show-stage" role="region" aria-roledescription="carousel" aria-label="What we do">
        {categories.map((c, i) => (
          <article class="show-slide" id={`slide-${c.slug}`} role="tabpanel" aria-labelledby={`tab-${c.slug}`} aria-roledescription="slide" data-slide>
            <div class="media show-media">
              <Img slug={c.image} sizes="(min-width: 64rem) 46rem, 100vw" alt="" />
              <span class="show-count tnum">{String(i + 1).padStart(2, '0')} / {String(categories.length).padStart(2, '0')}</span>
            </div>
            <div class="show-body">
              <p class="show-k"><Icon name={c.icon} size={16} /> {c.title}</p>
              <h3>{c.headline}</h3>
              <p class="show-p">{c.body}</p>
              <ul class="show-list">
                {servicesIn(c.slug).map((sv) => (
                  <li><a class="link-plain" href={`/services/${sv.slug}/`}><Icon name={sv.icon} size={16} /> {sv.title}</a></li>
                ))}
              </ul>
              <div class="row show-actions">
                <a class="btn btn--dark" href={`/services/#${c.slug}`}>Explore {c.title.toLowerCase()} <Icon name="arrow-right" size={18} stroke={2} /></a>
                <a class="btn btn--secondary" href="/estimate/"><Icon name="calculator" size={18} stroke={2} /> Get an estimate</a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="show-ctrl" hidden data-ctrl>
        <button type="button" class="ctl" aria-label="Previous slide" data-prev><Icon name="chevron-left" size={20} stroke={2} /></button>
        <button type="button" class="ctl" aria-label="Pause the slides" data-toggle><Icon name="pause" size={16} stroke={2} class="i-pause" /><Icon name="play" size={16} stroke={2} class="i-play" /></button>
        <button type="button" class="ctl" aria-label="Next slide" data-next><Icon name="chevron-right" size={20} stroke={2} /></button>
      </div>
    </div>
  </section>

  {/* ================================================================== 3. QUOTATION
      [CONTENT] "under this can we include a quotation based on the rates shared?" */}
  <Estimator overlap={false} />
  <div class="container full-est">
    <a class="full-est-a link-plain" href="/estimate/">
      <span class="icon-tile"><Icon name="calculator" /></span>
      <span>
        <strong>Need a website, a POS system, filings or other registrations too?</strong>
        <span>Build the full estimate, line by line, and send it in one message.</span>
      </span>
      <Icon name="arrow-right" size={20} stroke={2} class="full-est-go" />
    </a>
  </div>

  {/* ================================================================== 4. JOURNEY */}
  <section class="section" aria-labelledby="journey-h">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="pill-k">Lifecycle coverage</p>
        <h2 id="journey-h">Your business journey with <em>Reliance Business Partners.</em></h2>
        <p class="intro">From the first registration to growth, funding and change, with one coordinated relationship at every stage.</p>
      </div>
      <ol class="journey">
        {journey.map((j) => (
          <li>
            <a class="stage link-plain" href={j.href}>
              <span class="stage-n">Stage {j.n}</span>
              <h3>{j.title}</h3>
              <p>{j.body}</p>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ================================================================== 5. OUR COMPANY */}
  <section class="section band" aria-labelledby="co-h">
    <div class="container company">
      <div class="media co-media">
        <Img slug="svc-advisory" sizes="(min-width: 64rem) 40rem, 100vw" alt="" />
        <span class="co-badge on-invert"><strong class="tnum">{site.founded}</strong> Established</span>
      </div>
      <div class="co-copy">
        <p class="pill-k">Our company</p>
        <h2 id="co-h">One relationship for <em>connected business needs.</em></h2>
        <p class="lede">
          A new company needs more than registration. A growing business needs more
          than historical accounts. An investor needs more than a promising
          opportunity. We help connect the financial, operational, technology and
          compliance work behind your next decision.
        </p>
        <ul class="co-ticks">
          <li><Icon name="circle-check" size={20} /> <span><strong>Setup and compliance:</strong> registration, secretarial filings and the beneficial ownership register</span></li>
          <li><Icon name="circle-check" size={20} /> <span><strong>Finance:</strong> accounting, payroll, and tax through the affiliated practices</span></li>
          <li><Icon name="circle-check" size={20} /> <span><strong>Growth:</strong> systems, advisory, funding and business change</span></li>
        </ul>
        <a class="btn btn--dark" href="/about/">More About Us <Icon name="arrow-right" size={18} stroke={2} /></a>
      </div>
    </div>
  </section>

  {/* ================================================================== 6. SERVICES */}
  <section id="services" class="section" aria-labelledby="services-h">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="pill-k">Our services</p>
        <h2 id="services-h">Specialist support <em>where it matters.</em></h2>
        <p class="intro">{services.length} services in five groups, engaged individually or combined into an agreed programme of support.</p>
      </div>
      <ul class="svc-grid">
        {categories.map((c, i) => (
          <li class={`svc svc--${i}`}>
            <span class="svc-icon"><Icon name={c.icon} size={26} /></span>
            <p class="svc-k">{c.title}</p>
            <h3>{c.headline}</h3>
            <p class="svc-p">{c.body}</p>
            <ul class="plus">
              {servicesIn(c.slug).slice(0, 4).map((s) => <li><a class="link-plain" href={`/services/${s.slug}/`}>{s.title}</a></li>)}
            </ul>
            <a class="link-arrow" href={`/services/#${c.slug}`}>All {servicesIn(c.slug).length} services <Icon name="arrow-right" size={16} stroke={2} /></a>
          </li>
        ))}
      </ul>
      <div class="center-btn">
        <a class="btn btn--dark btn--lg" href="/services/">More Services <Icon name="arrow-right" size={18} stroke={2} /></a>
      </div>
    </div>
  </section>

  {/* ================================================================== 7. WHY CHOOSE US */}
  <section class="section band--dark on-invert why" aria-labelledby="why-h">
    <div class="why-glow" aria-hidden="true"></div>
    <div class="container why-grid">
      <div>
        <p class="pill-k pill-k--dark">Why choose us</p>
        <h2 id="why-h">Supporting businesses with <em>coordinated, practical expertise.</em></h2>
        <p class="why-p">
          We begin with your objectives, identify the work required and define the
          responsibilities and deliverables before an engagement starts.
        </p>
        <div class="feats">
          <div class="feat">
            <span class="icon-tile"><Icon name="receipt" /></span>
            <h3>Published fees</h3>
            <p>Incorporation packages and filing rates are on the site, and the estimate adds them up before you call.</p>
          </div>
          <div class="feat">
            <span class="icon-tile"><Icon name="badge-check" /></span>
            <h3>Qualified people</h3>
            <p>Chartered and management accountants lead the work, with specialists engaged where required.</p>
          </div>
        </div>
        <a class="btn btn--primary" href="/about/">Discover More <Icon name="arrow-right" size={18} stroke={2} /></a>
      </div>
      <dl class="figs">
        {credentials.map((c) => (
          <div class="fig">
            <dt class="visually-hidden">{c.label}</dt>
            <dd>
              <span class="fig-n tnum" data-count={c.count ? c.n : undefined}>{c.n}</span>
              <span class="fig-l" aria-hidden="true">{c.label}</span>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  {/* ================================================================== 8. TWO AUDIENCES */}
  <section class="section band" aria-label="International businesses and business owners">
    <div class="container duo">
      <article class="aud aud--intl">
        <div class="media aud-media"><Img slug="ind-trade" sizes="(min-width: 64rem) 40rem, 100vw" alt="" /></div>
        <div class="aud-body on-invert">
          <p class="eyebrow">International businesses</p>
          <h2>For international businesses <em>considering Sri Lanka.</em></h2>
          <p>
            Understand the setup route, plan your local operations and establish a
            dependable reporting process. RBPL helps international founders, overseas
            business owners and finance teams coordinate incorporation, accounting,
            payroll and corporate administration through a defined local engagement.
          </p>
          <a class="btn btn--primary" href={waIntl} target="_blank" rel="noopener">Plan Your Sri Lanka Business Setup <Icon name="arrow-right" size={18} stroke={2} /></a>
        </div>
      </article>
      <article class="aud aud--own">
        <div class="aud-body">
          <p class="eyebrow">Business owners</p>
          <h2>For owners planning <em>their next move.</em></h2>
          <p>
            Whether you want to bring in an investment partner, approach a lender or
            explore a sale, preparation matters. We help organise your financial
            information, examine the business proposition and coordinate discussions
            with relevant parties on an agreed basis.
          </p>
          <ul class="aud-links">
            {ownerLinks.map((s) => (
              <li><a class="link-plain" href={`/services/${s.slug}/`}><Icon name={s.icon} size={18} /> {s.title} <Icon name="arrow-right" size={16} stroke={2} class="aud-go" /></a></li>
            ))}
          </ul>
          <div class="row">
            <a class="btn btn--dark" href="/investors/">Discuss an Investment or Business Sale <Icon name="arrow-right" size={18} stroke={2} /></a>
          </div>
        </div>
      </article>
    </div>
  </section>

  {/* ================================================================== 9. SYSTEMS */}
  <section class="section" aria-labelledby="stack-h">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="pill-k">Digital enablement</p>
        <h2 id="stack-h">Accounting, ERP and payroll <em>systems we work in.</em></h2>
        <p class="intro">Your records stay in the system your business uses. We implement, migrate and maintain them where that is in scope.</p>
      </div>
      <ul class="stack">
        {stack.map((t, i) => (
          <li class:list={['tool', i < 2 && 'tool--lead']}>
            <span class="tool-k">{t.kind}</span>
            <h3>{t.name}</h3>
            <p>{t.body}</p>
          </li>
        ))}
      </ul>
      <p class="stack-note">Product names are their owners’ trademarks. The firm works in these systems; it does not claim a partnership with their vendors.</p>
    </div>
  </section>

  {/* ================================================================== 10. AFFILIATION */}
  <section class="section band" aria-labelledby="affil-h">
    <div class="container">
      <div class="affil">
        <span class="affil-mark" aria-hidden="true"><Icon name="handshake" size={28} /></span>
        <div>
          <p class="eyebrow">A wider professional relationship</p>
          <h2 id="affil-h">Affiliated with <em>{site.affiliate.name}.</em></h2>
          <p>
            RBPL is affiliated with {site.affiliate.name} ({site.affiliate.role}). Tax
            and assurance services described in our corporate profile are conducted
            through {site.affiliate.name}, subject to the agreed engagement and
            professional requirements. We help coordinate the appropriate support while
            making each service provider’s role clear.
          </p>
        </div>
        <a class="btn btn--secondary" href={site.affiliate.href} rel="noopener">Explore {site.affiliate.name} <Icon name="external-link" size={16} stroke={2} /></a>
      </div>
    </div>
  </section>

  {/* ================================================================== 11. FAQ */}
  <section id="faq" class="section" aria-labelledby="faq-h">
    <div class="container faq-grid">
      <div class="faq-side">
        <p class="pill-k">Questions</p>
        <h2 id="faq-h">The things people <em>ask first.</em></h2>
        <p class="lede faq-lede">Anything not answered here is one message away.</p>
        <div class="row faq-actions">
          <a class="btn btn--dark" href={wa} target="_blank" rel="noopener">Ask us on WhatsApp <Icon name="arrow-right" size={18} stroke={2} /></a>
        </div>
      </div>
      <div class="faq">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <div class="answer"><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<script>
  /* --- the service showcase ---------------------------------------------------
     Without JavaScript every slide is shown, stacked. With it, one at a time,
     driven by the tabs, the arrows, swipe and a seven-second autoplay that
     stops on hover, focus, off screen, a hidden tab, pause, or reduced motion. */
  const root = document.querySelector<HTMLElement>('[data-slider]');
  if (root) {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]')!;
    const stage = root.querySelector<HTMLElement>('.show-stage')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const DUR = 7000;
    let i = 0, timer = 0, userPaused = reduce, hover = false, inView = false;

    root.classList.add('is-live');
    root.querySelectorAll<HTMLElement>('[data-ctrl]').forEach((el) => { el.hidden = false; });
    root.style.setProperty('--slide-dur', `${DUR}ms`);

    const show = (n: number, focusTab = false) => {
      i = (n + slides.length) % slides.length;
      slides.forEach((el, k) => { el.hidden = k !== i; });
      tabs.forEach((t, k) => {
        t.setAttribute('aria-selected', String(k === i));
        t.tabIndex = k === i ? 0 : -1;
      });
      if (focusTab) tabs[i].focus();
      tabs[i].scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });
      root.classList.remove('is-ticking'); void root.offsetWidth; root.classList.add('is-ticking');
    };
    const running = () => !userPaused && !hover && inView && !document.hidden;
    const schedule = () => {
      window.clearTimeout(timer);
      root.classList.toggle('is-paused', !running());
      if (running()) timer = window.setTimeout(() => { show(i + 1); schedule(); }, DUR);
    };
    const setPaused = (p: boolean) => {
      userPaused = p;
      toggle.setAttribute('aria-label', p ? 'Play the slides' : 'Pause the slides');
      toggle.classList.toggle('is-play', p);
      schedule();
    };

    tabs.forEach((t) => {
      t.addEventListener('click', () => { show(Number(t.dataset.dot)); schedule(); });
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') { e.preventDefault(); show(i + 1, true); schedule(); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); show(i - 1, true); schedule(); }
      });
    });
    root.querySelector('[data-prev]')!.addEventListener('click', () => { show(i - 1); schedule(); });
    root.querySelector('[data-next]')!.addEventListener('click', () => { show(i + 1); schedule(); });
    toggle.addEventListener('click', () => setPaused(!userPaused));
    stage.addEventListener('pointerenter', () => { hover = true; schedule(); });
    stage.addEventListener('pointerleave', () => { hover = false; schedule(); });
    stage.addEventListener('focusin', () => { hover = true; schedule(); });
    stage.addEventListener('focusout', (e) => { if (!stage.contains(e.relatedTarget as Node)) { hover = false; schedule(); } });
    document.addEventListener('visibilitychange', schedule);
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => { inView = e.isIntersecting; schedule(); }, { threshold: 0.35 }).observe(stage);
    }
    let x0: number | null = null;
    stage.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    stage.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 50) { show(i + (dx < 0 ? 1 : -1)); schedule(); }
      x0 = null;
    });

    setPaused(userPaused);
    show(0);
  }

  /* --- the figures count up once on first view; the real numbers are in the HTML */
  const nums = document.querySelectorAll<HTMLElement>('[data-count]');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (nums.length && !still && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        io.unobserve(e.target);
        const el = e.target as HTMLElement;
        const end = Number(el.dataset.count);
        const t0 = performance.now();
        const tick = (t: number) => {
          const p = Math.min(1, (t - t0) / 1100);
          el.textContent = String(Math.round(end * (1 - Math.pow(1 - p, 3))));
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }
    }, { threshold: 0.6 });
    nums.forEach((n) => io.observe(n));
  }
</script>

<style>
  /* small pill label above section headings, after sa.lk */
  .pill-k {
    display: inline-flex;
    align-items: center;
    padding: 0.3rem 0.85rem;
    border-radius: var(--r-pill);
    background: var(--accent-tint);
    color: var(--accent-ink);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    margin-bottom: var(--space-4);
  }
  .pill-k--dark { background: var(--surface-invert-2); color: var(--accent-lift); }
  .section-head--center .pill-k { margin-inline: auto; }
  .center-btn { display: flex; justify-content: center; margin-top: var(--space-7); }

  /* ================================================================== HERO */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--surface-invert);
    color: var(--ink-invert);
    margin-top: calc((var(--header-h) + var(--header-inset)) * -1);
    padding-top: calc(var(--header-h) + clamp(3rem, 2rem + 5vw, 7rem));
    padding-bottom: clamp(7rem, 5rem + 5vw, 10rem);
    min-height: min(52rem, 92svh);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .hero-bg { position: absolute; inset: 0; z-index: -1; }
  .hero-bg :global(picture), .hero-bg :global(img) { width: 100%; height: 100%; }
  .hero-bg :global(img) { object-fit: cover; transform-origin: 70% 50%; }
  @media (prefers-reduced-motion: no-preference) {
    .hero-bg :global(img) { animation: hero-push 2.4s var(--ease-out) both; }
  }
  @keyframes hero-push { from { transform: scale(1.06); } to { transform: scale(1); } }
  .hero-trust { margin-top: var(--space-5); font-size: var(--text-xs); font-weight: 700; letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; color: var(--ink-invert); }
  .hero-trust span { margin-inline: var(--space-2); opacity: 0.6; }

  .hero-copy { max-width: 44rem; }
  .hero-h {
    font-size: clamp(2.3rem, 1.3rem + 3.6vw, 4.4rem);
    line-height: 1.03;
    letter-spacing: -0.032em;
    font-weight: 650;
    color: var(--ink-invert);
  }
  .hero-h .line { display: block; overflow: hidden; padding-bottom: 0.08em; }
  .hero-h .line > span { display: inline-block; animation: rise 1.1s var(--ease-out) both; }
  .hero-h .line:nth-child(2) > span { animation-delay: 0.12s; }
  @keyframes rise { from { transform: translate3d(0, 105%, 0); } to { transform: none; } }
  .hero-h em { color: var(--accent-lift); }
  .hero :is(.eyebrow, .lede) { color: var(--ink-invert); }
  .hero-lede { margin-top: var(--space-5); max-width: 50ch; }
  .hero-actions { margin-top: var(--space-6); gap: var(--space-3); }

  /* phone: the photograph is a banner, and every word sits below it on navy */
  @media (max-width: 47.99rem) {
    .hero {
      --hero-media-h: min(76vw, 21rem);
      min-height: 0;
      justify-content: flex-start;
      padding-top: calc(var(--hero-media-h) + var(--space-2));
      padding-bottom: 5rem;
    }
    .hero-bg { bottom: auto; height: var(--hero-media-h); }
    .hero-bg::after { content: ""; position: absolute; inset: auto 0 0 0; height: 35%; background: linear-gradient(to bottom, transparent, var(--surface-invert)); pointer-events: none; }
    .hero-h { font-size: clamp(2rem, 1.2rem + 4.4vw, 2.6rem); line-height: 1.05; }
    .hero-lede { font-size: 1.0625rem; }
    .hero-actions .btn { flex: 1 1 100%; }
    .eb-wide { display: none; }
  }

  /* ================================================================== QUICK CARDS */
  .quick { position: relative; z-index: 2; margin-top: clamp(-6rem, -4rem - 2vw, -4rem); }
  .quick-grid { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4); }
  @media (min-width: 40rem) { .quick-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 72rem) { .quick-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-5); } }
  .qc {
    display: flex; flex-direction: column; gap: var(--space-3); height: 100%;
    padding: var(--pad-card); background: var(--surface-raised); border: 1px solid var(--line);
    border-radius: var(--r-lg); box-shadow: var(--shadow-3); color: var(--ink);
    transition: transform var(--dur-control) var(--ease-out), box-shadow var(--dur-control) var(--ease-out);
  }
  .qc:hover { transform: translate3d(0, -4px, 0); color: var(--ink); }
  .qc-top { display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-1); }
  .qc-badge { padding: 0.25rem 0.6rem; border-radius: var(--r-pill); background: var(--surface-invert); color: var(--ink-invert); font-size: var(--text-xs); font-weight: 700; line-height: 1.3; }
  .qc h3 { font-size: var(--text-h4); font-family: var(--font-sans); font-weight: 700; letter-spacing: -0.01em; }
  .qc p { color: var(--muted); font-size: var(--text-sm); }
  .qc .link-arrow { margin-top: auto; }


  /* ================================================================== SHOWCASE */
  .show-tabs {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
    overflow-x: auto;
    scrollbar-width: none;
    scroll-snap-type: x proximity;
  }
  .show-tabs::-webkit-scrollbar { display: none; }
  .show-tabs[hidden] { display: none; }
  @media (min-width: 72rem) { .show-tabs { justify-content: center; } }
  .tab {
    position: relative;
    overflow: hidden;
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap-min);
    padding: 0 var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: var(--surface-raised);
    color: var(--ink-soft);
    font-weight: 600;
    font-size: var(--text-sm);
    white-space: nowrap;
    cursor: pointer;
    scroll-snap-align: center;
    transition: background-color var(--dur-hover) var(--ease-out), color var(--dur-hover) var(--ease-out), border-color var(--dur-hover);
  }
  .tab :global(svg) { color: var(--accent-ink); flex: none; }
  .tab:hover { border-color: var(--ink); color: var(--ink); }
  .tab[aria-selected="true"] { background: var(--surface-invert); border-color: var(--surface-invert); color: var(--ink-invert); }
  .tab[aria-selected="true"] :global(svg) { color: var(--accent-lift); }
  /* the selected tab's progress, along its foot */
  .tab-bar { position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: var(--accent); transform: scaleX(0); transform-origin: left; }
  .tab[aria-selected="true"] .tab-bar { transform: scaleX(1); }
  .is-ticking:not(.is-paused) .tab[aria-selected="true"] .tab-bar { animation: tick var(--slide-dur, 7s) linear both; }
  @keyframes tick { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  .show-stage { display: grid; gap: var(--space-6); }
  /* live: every slide shares one cell, so the stage never jumps in height */
  .is-live .show-stage { gap: 0; }
  .is-live .show-slide { grid-area: 1 / 1; }
  .is-live .show-slide[hidden] { display: grid; visibility: hidden; opacity: 0; }
  /* on phones each slide takes its own height: the longest list would leave the others half empty */
  @media (max-width: 63.99rem) { .is-live .show-slide[hidden] { display: none; } }
  .show-slide {
    display: grid;
    background: var(--surface-raised);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow: var(--shadow-2);
    transition: opacity 0.6s var(--ease-out);
  }
  .is-live .show-slide:not([hidden]) .show-media :global(img) { animation: show-zoom 7s linear both; }
  .is-live .show-slide:not([hidden]) .show-body > * { animation: show-rise 0.6s var(--ease-out) backwards; }
  .is-live .show-slide:not([hidden]) .show-body > :nth-child(2) { animation-delay: 60ms; }
  .is-live .show-slide:not([hidden]) .show-body > :nth-child(3) { animation-delay: 120ms; }
  .is-live .show-slide:not([hidden]) .show-body > :nth-child(4) { animation-delay: 180ms; }
  .is-live .show-slide:not([hidden]) .show-body > :nth-child(5) { animation-delay: 240ms; }
  @keyframes show-zoom { from { transform: scale(1.06); } to { transform: scale(1); } }
  @keyframes show-rise { from { opacity: 0; transform: translate3d(0, 12px, 0); } }
  @media (min-width: 64rem) { .show-slide { grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); } }
  .show-media { position: relative; aspect-ratio: 16 / 10; border-radius: 0; }
  @media (min-width: 64rem) { .show-media { aspect-ratio: auto; min-height: 30rem; } }
  .show-media :global(picture) { height: 100%; }
  .show-count {
    position: absolute; left: var(--space-4); top: var(--space-4);
    padding: 0.35rem 0.75rem; border-radius: var(--r-pill);
    background: var(--surface-invert); color: var(--ink-invert);
    font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.06em;
  }
  .show-body { display: flex; flex-direction: column; gap: var(--space-4); padding: clamp(1.5rem, 1.1rem + 1.6vw, 3rem); }
  .show-k { display: inline-flex; align-items: center; gap: var(--space-2); font-size: var(--text-xs); font-weight: 700; letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; color: var(--accent-ink); }
  .show-body h3 { font-size: var(--text-h2); line-height: 1.1; }
  .show-p { color: var(--ink-soft); font-size: var(--text-lede); line-height: 1.55; }
  .show-list { list-style: none; margin: 0; padding: 0; display: grid; border-top: 1px solid var(--line); }
  @media (min-width: 40rem) { .show-list { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-5); } }
  .show-list a { display: flex; align-items: center; gap: var(--space-2); min-height: var(--tap-min); border-bottom: 1px solid var(--line); color: var(--ink); font-size: var(--text-sm); font-weight: 600; line-height: 1.3; }
  .show-list a :global(svg) { color: var(--accent-ink); flex: none; }
  .show-list a:hover { color: var(--accent-ink); }
  .show-actions { margin-top: auto; padding-top: var(--space-2); gap: var(--space-3); }

  .show-ctrl { display: flex; justify-content: center; gap: var(--space-2); margin-top: var(--space-5); }
  .show-ctrl[hidden] { display: none; }
  .ctl {
    display: grid; place-items: center; width: var(--tap-min); height: var(--tap-min); padding: 0;
    border: 1px solid var(--line-strong); border-radius: var(--r-pill); background: var(--surface-raised);
    color: var(--ink); cursor: pointer;
    transition: border-color var(--dur-hover) var(--ease-out), background-color var(--dur-hover) var(--ease-out);
  }
  .ctl:hover { border-color: var(--ink); background: var(--surface-sunken); }
  .ctl :global(.i-play) { display: none; }
  .ctl.is-play :global(.i-play) { display: block; }
  .ctl.is-play :global(.i-pause) { display: none; }
  @media (max-width: 39.99rem) { .show-actions .btn { flex: 1 1 100%; } }

  /* ================================================================== FULL ESTIMATE LINK */
  .full-est { margin-top: calc(var(--space-6) * -1); margin-bottom: var(--space-5); }
  .full-est-a {
    display: flex; align-items: center; gap: var(--space-4);
    padding: var(--space-4) var(--space-5); border-radius: var(--r-md);
    background: var(--accent-tint); color: var(--ink);
    transition: transform var(--dur-control) var(--ease-out);
  }
  .full-est-a:hover { color: var(--ink); transform: translate3d(0, -2px, 0); }
  .full-est-a > span:nth-child(2) { display: grid; gap: 2px; }
  .full-est-a strong { font-size: var(--text-sm); }
  .full-est-a > span:nth-child(2) > span { font-size: var(--text-sm); color: var(--ink-soft); }
  .full-est-a .icon-tile { background: var(--surface-raised); flex: none; }
  .full-est-a :global(.full-est-go) { margin-left: auto; flex: none; color: var(--accent-ink); }

  /* ================================================================== JOURNEY */
  .journey { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4); counter-reset: none; }
  @media (min-width: 40rem) { .journey { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 72rem) { .journey { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-5); } }
  .stage {
    display: grid; align-content: start; gap: var(--space-2); height: 100%;
    padding: var(--pad-card); background: var(--surface-raised); border: 1px solid var(--line);
    border-left: 3px solid var(--accent); border-radius: var(--r-md); color: var(--ink);
    transition: transform var(--dur-control) var(--ease-out), box-shadow var(--dur-control) var(--ease-out);
  }
  .stage:hover { transform: translate3d(0, -3px, 0); box-shadow: var(--shadow-2); color: var(--ink); }
  .stage-n { font-size: var(--text-xs); font-weight: 700; letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; color: var(--accent-ink); }
  .stage h3 { font-size: var(--text-h4); font-family: var(--font-sans); font-weight: 700; letter-spacing: -0.01em; }
  .stage p { color: var(--muted); font-size: var(--text-sm); }

  /* ================================================================== COMPANY */
  .company { display: grid; gap: var(--space-7); align-items: center; }
  @media (min-width: 64rem) { .company { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-9); } }
  .co-media { aspect-ratio: 5 / 4; border-radius: var(--r-lg); box-shadow: var(--shadow-2); overflow: visible; }
  .co-media :global(picture) { height: 100%; border-radius: inherit; overflow: hidden; display: block; }
  .co-badge {
    position: absolute; right: var(--space-5); bottom: var(--space-5);
    display: grid; gap: 2px; padding: var(--space-4) var(--space-5);
    border-radius: var(--r-md); background: var(--surface-invert); color: var(--ink-invert);
    font-size: var(--text-xs); font-weight: 700; letter-spacing: var(--tracking-eyebrow); text-transform: uppercase;
    box-shadow: var(--shadow-3);
  }
  .co-badge strong { font-size: 2rem; letter-spacing: var(--tracking-tight); text-transform: none; color: var(--accent-lift); line-height: 1; }
  .co-copy .lede { margin-top: var(--space-5); }
  .co-ticks { list-style: none; margin: var(--space-6) 0; padding: 0; display: grid; gap: var(--space-3); }
  .co-ticks li { display: flex; gap: var(--space-3); align-items: flex-start; color: var(--ink-soft); font-size: var(--text-sm); }
  .co-ticks li strong { color: var(--ink); }
  .co-ticks :global(svg) { flex: none; color: var(--accent-ink); margin-top: 1px; }

  /* ================================================================== SERVICES */
  .svc-grid { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4); }
  @media (min-width: 40rem) { .svc-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) {
    .svc-grid { grid-template-columns: repeat(6, minmax(0, 1fr)); gap: var(--space-5); }
    .svc { grid-column: span 2; }
    .svc--3, .svc--4 { grid-column: span 3; }
  }
  @media (min-width: 40rem) and (max-width: 63.99rem) { .svc--4 { grid-column: 1 / -1; } }
  .svc {
    display: flex; flex-direction: column; gap: var(--space-3);
    padding: clamp(1.5rem, 1.2rem + 1vw, 2.25rem);
    background: var(--surface-sunken); border-radius: var(--r-lg);
    transition: background-color var(--dur-control) var(--ease-out), box-shadow var(--dur-control) var(--ease-out);
  }
  .svc:hover { background: var(--surface-raised); box-shadow: var(--shadow-2); }
  .svc-icon { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: var(--r-md); background: var(--surface-raised); color: var(--accent-ink); box-shadow: var(--shadow-1); margin-bottom: var(--space-2); }
  .svc-k { font-size: var(--text-xs); font-weight: 700; letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; color: var(--accent-ink); }
  .svc h3 { font-size: var(--text-h3); }
  .svc-p { color: var(--ink-soft); font-size: var(--text-sm); }
  .plus { list-style: none; margin: var(--space-2) 0; padding: 0; display: grid; }
  .plus a { display: flex; align-items: center; gap: var(--space-3); min-height: 2.5rem; color: var(--ink); font-size: var(--text-sm); font-weight: 600; }
  .plus a::before { content: "+"; flex: none; width: 1rem; color: var(--accent-ink); font-weight: 700; font-size: 1.1rem; line-height: 1; }
  .plus a:hover { color: var(--accent-ink); }
  .svc .link-arrow { margin-top: auto; }

  /* ================================================================== WHY */
  .why { position: relative; isolation: isolate; overflow: hidden; }
  .why-glow { position: absolute; z-index: -1; width: 46rem; height: 30rem; left: -20rem; top: -12rem; border-radius: 50%; background: oklch(30% 0.06 245); filter: blur(120px); mix-blend-mode: screen; }
  .why-grid { display: grid; gap: var(--space-7); align-items: center; }
  @media (min-width: 64rem) { .why-grid { grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: var(--space-9); } }
  .why-p { margin-top: var(--space-5); color: var(--muted-invert); max-width: 56ch; }
  .feats { display: grid; gap: var(--space-4); margin: var(--space-6) 0; }
  @media (min-width: 40rem) { .feats { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .feat { display: grid; gap: var(--space-2); padding: var(--pad-card); background: var(--surface-invert-2); border: 1px solid var(--line-invert); border-radius: var(--r-md); }
  .feat h3 { font-size: var(--text-h4); font-family: var(--font-sans); font-weight: 700; color: var(--ink-invert); letter-spacing: -0.01em; }
  .feat p { color: var(--muted-invert); font-size: var(--text-sm); }
  .figs { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); }
  .fig { padding: clamp(1.25rem, 1rem + 1vw, 2rem); background: var(--surface-invert-2); border: 1px solid var(--line-invert); border-radius: var(--r-lg); }
  .fig:nth-child(1), .fig:nth-child(4) { background: var(--accent); border-color: transparent; }
  .fig dd { margin: 0; display: grid; gap: var(--space-2); }
  .fig-n { font-family: var(--font-display); font-size: var(--text-figure); font-weight: 650; line-height: 1; letter-spacing: var(--tracking-display); color: var(--ink-invert); }
  .fig-l { font-size: var(--text-sm); color: var(--muted-invert); }
  .fig:nth-child(1) :is(.fig-n, .fig-l), .fig:nth-child(4) :is(.fig-n, .fig-l) { color: var(--ink-on-accent); }

  /* ================================================================== AUDIENCES */
  .duo { display: grid; gap: var(--space-5); }
  @media (min-width: 64rem) { .duo { grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); } }
  .aud { border-radius: var(--r-lg); overflow: hidden; display: flex; flex-direction: column; }
  .aud--intl { background: var(--surface-invert); }
  .aud-media { aspect-ratio: 16 / 7; border-radius: 0; }
  .aud-media :global(picture) { height: 100%; }
  .aud--own { background: var(--surface-raised); border: 1px solid var(--line); justify-content: center; }
  .aud-body { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-4); padding: clamp(1.5rem, 1.2rem + 1.4vw, 2.75rem); flex: 1; }
  .aud-body h2 { font-size: var(--text-h3); line-height: 1.2; }
  .aud-body p { color: var(--ink-soft); font-size: var(--text-sm); }
  .aud--intl .aud-body p { color: var(--muted-invert); }
  .aud-body .btn, .aud-body .row { margin-top: auto; }
  .aud--own .aud-body { justify-content: center; flex: 0 1 auto; margin-block: auto; }
  .aud--own .aud-body .row { margin-top: var(--space-3); }
  .aud-links { list-style: none; margin: 0; padding: 0; width: 100%; display: grid; border-top: 1px solid var(--line); }
  .aud-links a { display: flex; align-items: center; gap: var(--space-3); min-height: 3rem; border-bottom: 1px solid var(--line); color: var(--ink); font-weight: 600; font-size: var(--text-sm); }
  .aud-links a :global(svg) { color: var(--accent-ink); flex: none; }
  .aud-links a :global(.aud-go) { margin-left: auto; transition: transform var(--dur-hover) var(--ease-out); }
  .aud-links a:hover { color: var(--accent-ink); }
  .aud-links a:hover :global(.aud-go) { transform: translate3d(3px, 0, 0); }

  /* ================================================================== SYSTEMS */
  .stack { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4); }
  @media (min-width: 40rem) { .stack { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .stack { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-5); } }
  .tool { display: grid; align-content: start; gap: var(--space-2); padding: var(--pad-card); background: var(--surface-raised); border: 1px solid var(--line); border-radius: var(--r-md); transition: border-color var(--dur-hover) var(--ease-out), box-shadow var(--dur-control) var(--ease-out); }
  .tool:hover { border-color: var(--line-strong); box-shadow: var(--shadow-1); }
  .tool--lead { background: var(--surface-invert); border-color: transparent; }
  .tool-k { font-size: var(--text-xs); font-weight: 700; letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; color: var(--accent-ink); }
  .tool--lead .tool-k { color: var(--accent-lift); }
  .tool h3 { font-size: var(--text-h3); }
  .tool--lead h3 { color: var(--ink-invert); }
  .tool p { color: var(--muted); font-size: var(--text-sm); }
  .tool--lead p { color: var(--muted-invert); }
