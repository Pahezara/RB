---
import Base from '../layouts/Base.astro';
import Estimator from '../components/Estimator.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, faqs, platforms, credentials, directors, team, whatsappHref } from '../data/site';
import { categories, servicesIn, services, startingPoints, serviceBySlug } from '../data/services';

/* [CONTENT] Homepage: title and meta description. */
const title = 'Business Services in Sri Lanka | Reliance Business Partners';
const description =
  'Start, manage and grow your business with RBPL. Explore company registration, outsourced accounting, ERP and investment support in Sri Lanka and beyond.';

const wa = whatsappHref('Hello Reliance Business Partners, I would like to discuss my requirements.');
const waIntl = whatsappHref('Hello Reliance Business Partners, I would like to plan a business setup in Sri Lanka.');
const ownerLinks = ['funding', 'due-diligence', 'business-sale'].map(serviceBySlug);
const catSizes = categories.map((_, i) => (i < 2 ? '(min-width: 64rem) 40rem, 100vw' : '(min-width: 64rem) 26rem, 100vw'));

/* "J M N Sanjeewa" -> "JS": first given initial, then the surname. */
const initials = (name: string) => {
  const parts = name.replace(/^Mr\.?\s*/, '').replace(/\./g, ' ').trim().split(/\s+/);
  return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
};
if (credentials.find((c) => c.label === 'Specialist services')?.n !== services.length) {
  throw new Error('index.astro: the credentials rail counts the wrong number of services');
}
---
<Base title={title} description={description} overHero>

  {/* ================================================================== 1. HERO
      Five slides, one per service group, crossfading behind a headline that
      stays put. Every slide photograph carries its own baked, MEASURED scrim
      for the copy column, the header and the rail (see src/data/images.json,
      slide-*), so the type is legible on all five, not just the first.
      Without JavaScript the first slide simply stays; the rest of the groups
      are all in section 4. */}
  <section class="hero" aria-labelledby="hero-h" data-slider>
    <div class="hero-bg" aria-hidden="true">
      {categories.map((c, i) => (
        <div class:list={['slide-img', i === 0 && 'is-active']} data-slide-img>
          <Img slug={c.slide} sizes="100vw" alt="" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} />
        </div>
      ))}
    </div>

    <div class="container hero-grid">
      <div class="hero-copy on-invert">
        <p class="eyebrow"><span>{site.legalName}</span></p>
        <h1 id="hero-h" class="hero-h">
          <span class="line"><span>Build your business with a partner who</span></span>
          <span class="line"><span><em>sees the whole picture.</em></span></span>
        </h1>
        <p class="lede hero-lede">
          From company formation and day-to-day finance to systems, funding readiness
          and business transformation, Reliance Business Partners brings the support
          you need into one coordinated relationship.
        </p>
        <div class="row hero-actions">
          <a class="btn btn--primary btn--lg" href={wa} target="_blank" rel="noopener"><Icon name="message-circle" size={18} stroke={2} /> Discuss Your Requirements</a>
          <a class="btn btn--ghost btn--lg" href="#services">Explore Our Services</a>
        </div>
        <a class="hero-quote link-plain" href="#estimate"><Icon name="calculator" size={18} /> Registering a company? <span>Get an instant quotation</span> <Icon name="arrow-down" size={16} stroke={2} /></a>
        <p class="hero-trust">Established in {site.founded} <span aria-hidden="true">|</span> Local and international business support</p>
      </div>

      <div class="slider" role="region" aria-roledescription="carousel" aria-label="What we do">
        <div class="slides" aria-live="off">
          {categories.map((c, i) => (
            <article class="slide" role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${categories.length}: ${c.title}`} hidden={i !== 0} data-slide>
              <p class="slide-k"><span class="tnum">{String(i + 1).padStart(2, '0')}</span> / {String(categories.length).padStart(2, '0')} &middot; {c.title}</p>
              <h2 class="slide-h">{c.headline}</h2>
              <p class="slide-p">{c.body}</p>
              <ul class="slide-list">
                {servicesIn(c.slug).slice(0, 4).map((s) => <li><a class="link-plain" href={`/services/${s.slug}/`}>{s.title}</a></li>)}
              </ul>
              <a class="link-arrow" href={`/services/#${c.slug}`}>Explore {c.title.toLowerCase()} <Icon name="arrow-right" size={16} stroke={2} /></a>
            </article>
          ))}
        </div>
        <div class="slider-ctrl" hidden data-ctrl>
          <div class="dots">
            {categories.map((c, i) => (
              <button type="button" class="dot" aria-label={`Show slide ${i + 1}: ${c.title}`} aria-current={i === 0 ? 'true' : undefined} data-dot={i}><span></span></button>
            ))}
          </div>
          <div class="arrows">
            <button type="button" class="ctl" aria-label="Previous slide" data-prev><Icon name="chevron-left" size={18} stroke={2} /></button>
            <button type="button" class="ctl" aria-label="Pause the slides" data-toggle><Icon name="pause" size={16} stroke={2} class="i-pause" /><Icon name="play" size={16} stroke={2} class="i-play" /></button>
            <button type="button" class="ctl" aria-label="Next slide" data-next><Icon name="chevron-right" size={18} stroke={2} /></button>
          </div>
        </div>
      </div>
    </div>

    <div class="container">
      <dl class="creds on-invert">
        {credentials.map((c) => (
          <div class="cred">
            <dt class="visually-hidden">{c.label}</dt>
            <dd class="stat">
              <span class="stat-n tnum" data-count={c.count ? c.n : undefined}>{c.n}</span>
              <span class="stat-l" aria-hidden="true">{c.label}</span>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  {/* ================================================================== 2. QUOTATION
      [CONTENT] "under this can we include a quotation based on the rates
      shared?" — the estimator, directly under the hero's main action. */}
  <Estimator />

  {/* ================================================================== 3. WHAT YOU NEED NEXT */}
  <section class="section" aria-labelledby="next-h">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">Where to start</p>
          <h2 id="next-h">What does your business <em>need next?</em></h2>
        </div>
        <p class="intro">
          We work with entrepreneurs, established companies and international
          businesses exploring opportunities in Sri Lanka and beyond.
        </p>
      </div>
      <ul class="needs">
        {startingPoints.map((p, i) => (
          <li>
            <a class="need link-plain" href={p.href}>
              <span class="need-top">
                <span class="icon-tile"><Icon name={p.icon} /></span>
                <span class="need-n tnum">{String(i + 1).padStart(2, '0')}</span>
              </span>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
              <span class="link-arrow">{p.next} <Icon name="arrow-right" size={16} stroke={2} /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ================================================================== 4. ONE RELATIONSHIP */}
  <section class="section band--dark on-invert why" aria-labelledby="rel-h">
    <div class="why-glow" aria-hidden="true"></div>
    <div class="container rel-grid">
      <div>
        <p class="eyebrow">How we work</p>
        <h2 id="rel-h">One relationship for <em>connected business needs.</em></h2>
      </div>
      <div class="rel-copy">
        <p class="lede">
          A new company needs more than registration. A growing business needs more
          than historical accounts. An investor needs more than a promising
          opportunity. We help connect the financial, operational, technology and
          compliance work behind your next decision.
        </p>
        <p>
          Our services can be engaged individually or combined into an agreed
          programme of support. We begin with your objectives, identify the work
          required and define the responsibilities and deliverables before the
          engagement starts.
        </p>
        <ul class="chips rel-values" aria-label="Our values">
          {site.values.map((v) => <li>{v.name}</li>)}
        </ul>
      </div>
    </div>
  </section>

  {/* ================================================================== 5. SERVICES */}
  <section id="services" class="section" aria-labelledby="services-h">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">What we do</p>
          <h2 id="services-h">Specialist support <em>where it matters.</em></h2>
        </div>
        <p class="intro">
          {services.length} services in five groups, from forming the company to
          funding it, running it and protecting it.
        </p>
      </div>

      <ul class="cat-grid">
        {categories.map((c, i) => (
          <li class={`cat cat--${i}`}>
            <a class="cat-card link-plain" href={`/services/#${c.slug}`}>
              <div class="media cat-media">
                <Img slug={c.image} sizes={catSizes[i]} alt="" />
                <span class="cat-count">{servicesIn(c.slug).length} services</span>
              </div>
              <div class="cat-body">
                <span class="cat-k"><Icon name={c.icon} size={16} /> {c.title}</span>
                <h3>{c.headline}</h3>
                <p>{c.body}</p>
                <span class="link-arrow">See the services <Icon name="arrow-right" size={16} stroke={2} /></span>
              </div>
            </a>
          </li>
        ))}
      </ul>
      <div class="svc-all">
        <a class="btn btn--dark btn--lg" href="/services/">View All Services <Icon name="arrow-right" size={18} stroke={2} /></a>
      </div>
    </div>
  </section>

  {/* ================================================================== 6. TWO AUDIENCES */}
  <section class="section band" aria-label="International businesses and business owners">
    <div class="container duo">
      <article class="aud aud--intl">
        <div class="media aud-media"><Img slug="ind-trade" sizes="(min-width: 64rem) 40rem, 100vw" alt="" /></div>
        <div class="aud-body on-invert">
          <p class="eyebrow">International businesses</p>
          <h2>For international businesses <em>considering Sri Lanka.</em></h2>
          <p>
            Understand the setup route, plan your local operations and establish a
            dependable reporting process. RBPL helps international founders, overseas
            business owners and finance teams coordinate incorporation, accounting,
            payroll and corporate administration through a defined local engagement.
          </p>
          <a class="btn btn--primary" href={waIntl} target="_blank" rel="noopener">Plan Your Sri Lanka Business Setup <Icon name="arrow-right" size={18} stroke={2} /></a>
        </div>
      </article>
      <article class="aud aud--own">
        <div class="aud-body">
          <p class="eyebrow">Business owners</p>
          <h2>For owners planning <em>their next move.</em></h2>
          <p>
            Whether you want to bring in an investment partner, approach a lender or
            explore a sale, preparation matters. We help organise your financial
            information, examine the business proposition and coordinate discussions
            with relevant parties on an agreed basis.
          </p>
          <ul class="aud-links">
            {ownerLinks.map((s) => (
              <li><a class="link-plain" href={`/services/${s.slug}/`}><Icon name={s.icon} size={18} /> {s.title} <Icon name="arrow-right" size={16} stroke={2} class="aud-go" /></a></li>
            ))}
          </ul>
          <div class="row">
            <a class="btn btn--dark" href="/investors/">Discuss an Investment or Business Sale <Icon name="arrow-right" size={18} stroke={2} /></a>
          </div>
        </div>
      </article>
    </div>
  </section>

  {/* ================================================================== 7. PLATFORMS
      Set as TYPE, never as the vendors' logos: the firm works in these tools,
      it is not their partner. */}
  <section class="platforms" aria-labelledby="plat-h">
    <div class="container plat-head">
      <h2 id="plat-h" class="plat-title">Your books stay in the software <em>you already use.</em></h2>
    </div>
    <div class="marquee">
      <ul class="marquee-track">
        {platforms.map((p) => <li>{p}</li>)}
        {platforms.map((p) => <li aria-hidden="true">{p}</li>)}
      </ul>
      <ul class="marquee-track" aria-hidden="true">
        {platforms.map((p) => <li>{p}</li>)}
        {platforms.map((p) => <li>{p}</li>)}
      </ul>
    </div>
  </section>

  {/* ================================================================== 8. AFFILIATION */}
  <section class="section" aria-labelledby="affil-h">
    <div class="container">
      <div class="affil">
        <span class="affil-mark" aria-hidden="true"><Icon name="handshake" size={28} /></span>
        <div>
          <p class="eyebrow">A wider professional relationship</p>
          <h2 id="affil-h">Affiliated with <em>{site.affiliate.name}.</em></h2>
          <p>
            RBPL is affiliated with {site.affiliate.name} ({site.affiliate.role}). Tax
            and assurance services described in our corporate profile are conducted
            through {site.affiliate.name}, subject to the agreed engagement and
            professional requirements. We help coordinate the appropriate support while
            making each service provider’s role clear.
          </p>
        </div>
        <a class="btn btn--secondary" href={site.affiliate.href} rel="noopener">Explore {site.affiliate.name} <Icon name="external-link" size={16} stroke={2} /></a>
      </div>
    </div>
  </section>

  {/* ================================================================== 9. MANAGEMENT */}
  <section class="section band" aria-labelledby="board-h">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">Management</p>
          <h2 id="board-h">Qualified people, <em>answerable for the work.</em></h2>
        </div>
        <div>
          <p class="intro">
            Four directors with Chartered Accountancy, management accounting, company
            secretarial and investment advisory backgrounds, leading a team of {team.total}.
          </p>
          <a class="link-arrow how-link" href="/management/">Meet the directors <Icon name="arrow-right" size={16} stroke={2} /></a>
        </div>
      </div>
      <ul class="board">
        {directors.map((d) => (
          <li class="director">
            <span class="monogram display" aria-hidden="true">{initials(d.name)}</span>
            <h3>{d.name}</h3>
            <p class="creds-line">{d.creds}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ================================================================== 10. VISION
      The dusk skyline carries a measured scrim across the quote. */}
  <section class="vision on-invert" aria-labelledby="vision-h">
    <div class="vision-bg" aria-hidden="true">
      <Img slug="colombo-dusk" sizes="100vw" alt="" />
    </div>
    <div class="container vision-inner">
      <p class="eyebrow eyebrow--center" id="vision-h">Our vision</p>
      <blockquote class="vision-quote display">
        <p>&ldquo;{site.vision}&rdquo;</p>
      </blockquote>
      <p class="vision-by">{site.tagline} &middot; {site.taglineSub}</p>
    </div>
  </section>

  {/* ================================================================== 11. FAQ */}
  <section id="faq" class="section" aria-labelledby="faq-h">
    <div class="container faq-grid">
      <div class="faq-side">
        <p class="eyebrow">Questions</p>
        <h2 id="faq-h">The things people <em>ask first.</em></h2>
        <p class="lede faq-lede">Anything not answered here is one message away.</p>
        <div class="row faq-actions">
          <a class="btn btn--dark" href={wa} target="_blank" rel="noopener">Ask us on WhatsApp <Icon name="arrow-right" size={18} stroke={2} /></a>
        </div>
      </div>
      <div class="faq">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <div class="answer"><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<script>
  /* --- the hero slider ---------------------------------------------------------
     Crossfades the five slide photographs and their captions. Autoplays every
     seven seconds, pauses while the pointer or keyboard focus is in the
     caption, while the hero is scrolled out of view or the tab is hidden, or
     when the visitor presses pause; under reduced motion it never autoplays. */
  const root = document.querySelector<HTMLElement>('[data-slider]');
  if (root) {
    const imgs = Array.from(root.querySelectorAll<HTMLElement>('[data-slide-img]'));
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    const ctrl = root.querySelector<HTMLElement>('[data-ctrl]')!;
    const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]')!;
    const slider = root.querySelector<HTMLElement>('.slider')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const DUR = 7000;
    let i = 0;
    let timer = 0;
    let userPaused = reduce;
    let hover = false;
    let inView = true;

    ctrl.hidden = false;
    root.classList.add('is-live');
    root.style.setProperty('--slide-dur', `${DUR}ms`);

    const show = (n: number) => {
      i = (n + slides.length) % slides.length;
      imgs.forEach((el, k) => el.classList.toggle('is-active', k === i));
      slides.forEach((el, k) => { el.hidden = k !== i; });
      dots.forEach((d, k) => d.toggleAttribute('aria-current', k === i));
      // restart the progress bar on the current dot
      root.classList.remove('is-ticking'); void root.offsetWidth; root.classList.add('is-ticking');
    };
    const running = () => !userPaused && !hover && inView && !document.hidden;
    const schedule = () => {
      window.clearTimeout(timer);
      root.classList.toggle('is-paused', !running());
      if (running()) timer = window.setTimeout(() => { show(i + 1); schedule(); }, DUR);
    };
    const setPaused = (p: boolean) => {
      userPaused = p;
      toggle.setAttribute('aria-label', p ? 'Play the slides' : 'Pause the slides');
      toggle.classList.toggle('is-play', p);
      // announce changes only when the visitor is driving them
      root.querySelector('.slides')!.setAttribute('aria-live', p ? 'polite' : 'off');
      schedule();
    };

    dots.forEach((d) => d.addEventListener('click', () => { show(Number(d.dataset.dot)); schedule(); }));
    root.querySelector('[data-prev]')!.addEventListener('click', () => { show(i - 1); schedule(); });
    root.querySelector('[data-next]')!.addEventListener('click', () => { show(i + 1); schedule(); });
    toggle.addEventListener('click', () => setPaused(!userPaused));
    slider.addEventListener('pointerenter', () => { hover = true; schedule(); });
    slider.addEventListener('pointerleave', () => { hover = false; schedule(); });
    slider.addEventListener('focusin', () => { hover = true; schedule(); });
    slider.addEventListener('focusout', (e) => { if (!slider.contains(e.relatedTarget as Node)) { hover = false; schedule(); } });
    document.addEventListener('visibilitychange', schedule);
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => { inView = e.isIntersecting; schedule(); }, { threshold: 0.25 }).observe(root);
    }
    // swipe on touch screens
    let x0: number | null = null;
    slider.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    slider.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 40) { show(i + (dx < 0 ? 1 : -1)); schedule(); }
      x0 = null;
    });

    setPaused(userPaused);
    show(0);
  }

  /* --- the credentials counters -----------------------------------------------
     Count up once on first view. The real numbers are already in the HTML. */
  const nums = document.querySelectorAll<HTMLElement>('[data-count]');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (nums.length && !still && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        io.unobserve(e.target);
        const el = e.target as HTMLElement;
        const end = Number(el.dataset.count);
        const t0 = performance.now();
        const tick = (t: number) => {
          const p = Math.min(1, (t - t0) / 1100);
          el.textContent = String(Math.round(end * (1 - Math.pow(1 - p, 3))));
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }
    }, { threshold: 0.6 });
    nums.forEach((n) => io.observe(n));
  }
</script>

<style>
  /* ================================================================== HERO */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--surface-invert);
    color: var(--ink-invert);
    margin-top: calc((var(--header-h) + var(--header-inset)) * -1);
    padding-top: calc(var(--header-h) + clamp(3.5rem, 2rem + 6vw, 7.5rem));
    padding-bottom: calc(4rem + var(--space-6));
    min-height: min(58rem, 100svh);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .hero-bg { position: absolute; inset: 0; z-index: -1; }
  .slide-img {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.4s var(--ease-out);
  }
  .slide-img.is-active { opacity: 1; }
  .slide-img :global(picture), .slide-img :global(img) { width: 100%; height: 100%; }
  .slide-img :global(img) { object-fit: cover; transform-origin: 70% 50%; }
  /* A slow push-in on the current photograph, restarted with each slide. */
  @media (prefers-reduced-motion: no-preference) {
    .slide-img.is-active :global(img) { animation: hero-push 9s linear both; }
  }
  @keyframes hero-push { from { transform: scale(1.08); } to { transform: scale(1); } }

  .hero-grid { display: grid; gap: var(--space-7); align-items: end; }
  @media (min-width: 64rem) {
    .hero-grid { grid-template-columns: minmax(0, 1fr) 24rem; gap: var(--space-8); }
  }
  .hero-copy { max-width: 46rem; }
  .hero-h {
    font-size: clamp(2.3rem, 1.3rem + 3.6vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.032em;
    font-weight: 650;
    color: var(--ink-invert);
    max-width: none;
  }
  .hero-h .line { display: block; overflow: hidden; padding-bottom: 0.08em; }
  .hero-h .line > span { display: inline-block; animation: rise 1.1s var(--ease-out) both; }
  .hero-h .line:nth-child(2) > span { animation-delay: 0.12s; }
  @keyframes rise { from { transform: translate3d(0, 105%, 0); } to { transform: none; } }
  .hero-h em { color: var(--accent-lift); }

  /* ONLY the light ink sits on the photograph: it is the ink every slide's
     scrim was measured for. The accent line is display size, held to 3:1. */
  .hero :is(.eyebrow, .lede, .stat-l, .hero-trust) { color: var(--ink-invert); }
  .hero-lede { margin-top: var(--space-5); max-width: 50ch; }
  .hero-actions { margin-top: var(--space-6); gap: var(--space-3); }
  .hero-trust { margin-top: var(--space-3); font-size: var(--text-xs); font-weight: 700; letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; color: var(--ink-invert); }
  .hero-trust span { margin-inline: var(--space-2); opacity: 0.6; }
  .hero-quote {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    min-height: var(--tap-min);
    margin-top: var(--space-4);
    color: var(--ink-invert);
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .hero-quote span { text-decoration: underline; text-underline-offset: 0.25em; text-decoration-color: var(--accent); text-decoration-thickness: 2px; }
  .hero-quote:hover { color: var(--ink-invert); }
  .hero-quote:hover span { text-decoration-color: var(--ink-invert); }

  /* --- the caption card: solid, so it never depends on the photograph ------- */
  .slider {
    position: relative;
    padding: var(--space-6);
    background: var(--surface-raised);
