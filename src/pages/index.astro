---
import Base from '../layouts/Base.astro';
import Estimator from '../components/Estimator.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import {
  site, serviceLines, steps, faqs, packages, industries, pillars, platforms,
  credentials, directors, team,
} from '../data/site';

const title = 'Reliance Business Partners — accountants in Colombo';
const description =
  'Accounting, tax, payroll, advisory, Power BI and company secretarial from one firm in Nugegoda, Colombo. Incorporation from LKR 36,000, every fee published.';

const money = (n: number) => n.toLocaleString('en-US');
const svc = (slug: string) => serviceLines.find((s) => s.slug === slug)!;

/* The bento order. Secretarial leads because it is the one line with a
   published price, and the price is the strongest thing this site can say. */
const bento = ['secretarial', 'accounting', 'tax', 'advisory', 'payroll', 'analytics'].map(svc);

/* "Mr. J. M. N. Sanjeewa" -> "JS": first given initial, then the surname. */
const initials = (name: string) => {
  const parts = name.replace(/^Mr\.?\s*/, '').replace(/\./g, ' ').trim().split(/\s+/);
  return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
};
---
<Base title={title} description={description} overHero>

  {/* ================================================================== 1. HERO
      The night skyline carries a baked, MEASURED scrim (6.41:1 for the light
      ink across the copy column; see src/data/images.json). The copy sits
      bottom-left; the incorporation card sits bottom-right on desktop, which
      puts a real price in the first screen of the site. */}
  <section class="hero" aria-labelledby="hero-h">
    <div class="hero-bg" aria-hidden="true">
      <Img slug="colombo-night" sizes="100vw" alt="" loading="eager" fetchpriority="high" />
    </div>

    <div class="container hero-grid">
      <div class="hero-copy on-invert">
        <p class="eyebrow"><span><span class="eb-wide">A firm of professionals &middot; </span>Colombo &middot; Since {site.founded}</span></p>
        <h1 id="hero-h" class="hero-h">
          <span class="line"><span>Your business,</span></span>
          <span class="line"><span><em>in trusted hands.</em></span></span>
        </h1>
        <p class="lede hero-lede">
          Accounting, tax, payroll, advisory, Power BI reporting and company
          secretarial work &mdash; six disciplines under one umbrella, with the
          fees published in the open.
        </p>
        <div class="row hero-actions">
          <a class="btn btn--primary btn--lg" href="#estimate">Estimate your fees <Icon name="arrow-right" size={18} stroke={2} /></a>
          <a class="btn btn--ghost btn--lg" href="#services">Explore services</a>
        </div>
      </div>

      <a class="hero-card link-plain" href="/packages/">
        <span class="hc-top">
          <span class="icon-tile"><Icon name="file-signature" /></span>
          <span class="hc-kicker">Company incorporation</span>
        </span>
        <span class="hc-price display"><span class="hc-cur">LKR</span> {money(packages[0].price)}</span>
        <span class="hc-note">
          Basic package, one director: name approval, certificate of incorporation,
          TIN certificate and bank resolutions, first-year retainer included.
        </span>
        <span class="link-arrow">Compare all three packages <Icon name="arrow-right" size={16} stroke={2} /></span>
      </a>
    </div>

    <div class="container">
      <dl class="creds on-invert">
        {credentials.map((c) => (
          <div class="cred">
            <dt class="visually-hidden">{c.label}</dt>
            <dd class="stat">
              <span class="stat-n tnum" data-count={c.count ? c.n : undefined}>{c.n}</span>
              <span class="stat-l" aria-hidden="true">{c.label}</span>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  {/* ================================================================== 2. ESTIMATOR */}
  <Estimator />

  {/* ================================================================== 3. SERVICES
      A bento of the six lines. Photograph above, words below on the card:
      none of these images carries a measured scrim, so none carries type. */}
  <section id="services" class="section" aria-labelledby="services-h">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">What we do</p>
          <h2 id="services-h">Six disciplines. <em>One set of books.</em></h2>
        </div>
        <p class="intro">
          Most clients start with one of these and end up with three. Because it is
          the same firm, the ledger the accountant keeps is the ledger the tax
          computation is built from.
        </p>
      </div>

      <div class="bento">
        {bento.map((s, i) => (
          <a class:list={['tile', 'link-plain', `tile--${i}`]} href={`/services/${s.slug}/`}>
            <div class="media tile-media">
              <Img slug={s.image} sizes={i === 0 ? '(min-width: 64rem) 52rem, 100vw' : '(min-width: 64rem) 26rem, (min-width: 40rem) 50vw, 100vw'} alt="" />
              {'packagesHref' in s && s.packagesHref && (
                <span class="tile-badge">From LKR {money(packages[0].price)}</span>
              )}
            </div>
            <div class="tile-body">
              <span class="tile-top">
                <span class="icon-tile"><Icon name={s.icon} /></span>
                <span class="tile-n tnum">{String(i + 1).padStart(2, '0')}</span>
              </span>
              <h3>{s.title}</h3>
              <p>{s.blurb}</p>
              <span class="link-arrow">What this covers <Icon name="arrow-right" size={16} stroke={2} /></span>
            </div>
          </a>
        ))}
        <div class="tile tile--cta on-invert">
          <p class="eyebrow">Not sure where to start?</p>
          <p class="tile-cta-h display">Describe it in your own words. We will place it.</p>
          <a class="btn btn--primary" href="/contact/">Talk to the team <Icon name="arrow-right" size={18} stroke={2} /></a>
        </div>
      </div>
    </div>
  </section>

  {/* ================================================================== 4. WHY RELIANCE */}
  <section class="section band--dark why on-invert" aria-labelledby="why-h">
    <div class="why-glow" aria-hidden="true"></div>
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">Why Reliance</p>
          <h2 id="why-h">Everything a growing company needs, <em>under one umbrella.</em></h2>
        </div>
        <p class="intro">
          Established in {site.founded} as a limited liability company, with a team
          of {team.total} and a board of qualified professionals. Four things
          follow from that, and each of them can be checked.
        </p>
      </div>

      <ul class="pillars">
        {pillars.map((p, i) => (
          <li class={`pillar reveal reveal-${Math.min(i + 1, 4)}`}>
            <span class="icon-tile"><Icon name={p.icon} /></span>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </li>
        ))}
      </ul>

      <div class="values">
        <p class="values-label">The values the firm holds itself to</p>
        <ul class="chips">
          {site.values.map((v) => <li>{v}</li>)}
        </ul>
      </div>
    </div>
  </section>

  {/* ================================================================== 5. HOW IT WORKS */}
  <section id="how" class="section" aria-labelledby="how-h">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">Incorporating a company</p>
          <h2 id="how-h">Four steps, <em>priced before the first.</em></h2>
        </div>
        <div>
          <p class="intro">
            Most people registering a company have never done it before. This is the
            whole sequence, with nothing hidden in the middle of it.
          </p>
          <a class="link-arrow how-link" href="/packages/">See exactly what each package includes <Icon name="arrow-right" size={16} stroke={2} /></a>
        </div>
      </div>

      <ol class="steps">
        {steps.map((s, i) => (
          <li class={`step reveal reveal-${Math.min(i + 1, 4)}`}>
            <span class="step-n">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.detail}</p>
            <p class="step-meta">{s.who}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ================================================================== 6. INDUSTRIES */}
  <section id="industries" class="section band" aria-labelledby="ind-h">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">Sectorial expertise</p>
          <h2 id="ind-h">Fourteen sectors the firm <em>already knows.</em></h2>
        </div>
        <div>
          <p class="intro">
            Not a client list: the industries whose books, filings and seasons the
            firm has worked in, grouped into six families.
          </p>
          <a class="link-arrow how-link" href="/industries/">How we work with each <Icon name="arrow-right" size={16} stroke={2} /></a>
        </div>
      </div>

      <ul class="ind-grid">
        {industries.map((ind) => (
          <li>
            <a class="ind link-plain" href={`/industries/#${ind.slug}`}>
              <div class="media ind-media">
                <Img slug={ind.image} sizes="(min-width: 64rem) 26rem, (min-width: 40rem) 50vw, 100vw" alt="" />
              </div>
              <div class="ind-body">
                <h3>{ind.title}</h3>
                <p class="ind-sectors">{ind.sectors.join(' · ')}</p>
              </div>
              <span class="ind-go" aria-hidden="true"><Icon name="arrow-up-right" size={20} stroke={2} /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ================================================================== 7. PLATFORMS
      Set as TYPE, never as the vendors' logos: the firm works in these tools,
      it is not their partner. The track is duplicated for a seamless loop; the
      copy is hidden from assistive technology so the list is read once. */}
  <section class="platforms" aria-labelledby="plat-h">
    <div class="container plat-head">
      <h2 id="plat-h" class="plat-title">Your books stay in the software <em>you already use.</em></h2>
    </div>
    <div class="marquee">
      <ul class="marquee-track">
        {platforms.map((p) => <li>{p}</li>)}
        {platforms.map((p) => <li aria-hidden="true">{p}</li>)}
      </ul>
      <ul class="marquee-track" aria-hidden="true">
        {platforms.map((p) => <li>{p}</li>)}
        {platforms.map((p) => <li>{p}</li>)}
      </ul>
    </div>
  </section>

  {/* ================================================================== 8. THE BOARD
      No photographs of the directors exist, and no stock face will ever stand
      in for one. Each is set as a monogram and their credentials. */}
  <section class="section" aria-labelledby="board-h">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">Board of directors</p>
          <h2 id="board-h">Qualified people, <em>answerable for the work.</em></h2>
        </div>
        <div>
          <p class="intro">
            Chartered Accountants, Chartered Management Accountants and Registered
            Company Secretaries, leading a team of {team.total}.
          </p>
          <a class="link-arrow how-link" href="/about/">Read about the firm <Icon name="arrow-right" size={16} stroke={2} /></a>
        </div>
      </div>

      <ul class="board">
        {directors.map((d) => (
          <li class="director">
            <span class="monogram display" aria-hidden="true">{initials(d.name)}</span>
            <h3>{d.name}</h3>
            <p class="creds-line">{d.creds}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ================================================================== 9. VISION
      The dusk skyline carries a measured scrim (6.71:1 across the quote). */}
  <section class="vision on-invert" aria-labelledby="vision-h">
    <div class="vision-bg" aria-hidden="true">
      <Img slug="colombo-dusk" sizes="100vw" alt="" />
    </div>
    <div class="container vision-inner">
      <p class="eyebrow eyebrow--center" id="vision-h">Vision 2030</p>
      <blockquote class="vision-quote display">
        <p>&ldquo;{site.vision}&rdquo;</p>
      </blockquote>
      <p class="vision-by">{site.legalName}</p>
    </div>
  </section>

  {/* ================================================================== 10. FAQ */}
  <section id="faq" class="section" aria-labelledby="faq-h">
    <div class="container faq-grid">
      <div class="faq-side">
        <p class="eyebrow">Questions</p>
        <h2 id="faq-h">The things people <em>ask first.</em></h2>
        <p class="lede faq-lede">Anything not answered here is one call away.</p>
        <div class="row faq-actions">
          <a class="btn btn--dark" href="/contact/">Ask us directly <Icon name="arrow-right" size={18} stroke={2} /></a>
        </div>
      </div>
      <div class="faq">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <div class="answer"><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* ================================================================== 11. CTA */}
  <CtaBand />
</Base>

<script>
  /* Counts the credential numerals up from zero the first time they scroll into
     view. The real number is already in the HTML, so with this script blocked,
     or under reduced motion, the page simply shows it. */
  const nums = document.querySelectorAll<HTMLElement>('[data-count]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (nums.length && !reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        io.unobserve(e.target);
        const el = e.target as HTMLElement;
        const end = Number(el.dataset.count);
        const t0 = performance.now();
        const dur = 1100;
        const tick = (t: number) => {
          const p = Math.min(1, (t - t0) / dur);
          el.textContent = String(Math.round(end * (1 - Math.pow(1 - p, 3))));
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }
    }, { threshold: 0.6 });
    nums.forEach((n) => io.observe(n));
  }
</script>

<style>
  /* ================================================================== HERO */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--surface-invert);
    color: var(--ink-invert);
    margin-top: calc((var(--header-h) + var(--header-inset)) * -1);
    padding-top: calc(var(--header-h) + clamp(4rem, 2rem + 8vw, 9rem));
    min-height: min(56rem, 100svh);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .hero-bg { position: absolute; inset: 0; z-index: -1; }
  .hero-bg :global(picture), .hero-bg :global(img) { width: 100%; height: 100%; }
  .hero-bg :global(img) {
    object-fit: cover;
    transform-origin: 70% 50%;
    animation: hero-settle 2.4s var(--ease-out) both;
  }
  @keyframes hero-settle {
    from { transform: scale(1.08); }
    to   { transform: scale(1); }
  }

  .hero-grid { display: grid; gap: var(--space-7); align-items: end; }
  @media (min-width: 64rem) {
    .hero-grid { grid-template-columns: minmax(0, 1fr) 22rem; gap: var(--space-8); }
  }
  .hero-copy { max-width: 46rem; }

  .hero-h {
    font-size: var(--text-display);
    line-height: 0.98;
    letter-spacing: var(--tracking-display);
    font-weight: 380;
    color: var(--ink-invert);
    max-width: none;
  }
  /* Each line rises out of a mask on load. Transform only: the text is never
     invisible, so a browser that skips the animation shows it in place. */
  .hero-h .line { display: block; overflow: hidden; padding-bottom: 0.08em; }
  .hero-h .line > span { display: inline-block; animation: rise 1.1s var(--ease-out) both; }
  .hero-h .line:nth-child(2) > span { animation-delay: 0.12s; }
  @keyframes rise {
    from { transform: translate3d(0, 105%, 0); }
    to   { transform: none; }
  }
  .hero-h em { color: var(--accent-lift); }

  /* ONLY the light ink sits on the photograph. The scrim was measured for
     --ink-invert (and, under the italic line, for --accent-lift as large text);
     the muted and accent inks used elsewhere on the dark band were never
     measured against city lights, so they are not allowed here. The eyebrow's
     rule stays orange: it is a 2px bar, not text. */
  .hero :is(.eyebrow, .lede, .stat-l) { color: var(--ink-invert); }

  .hero-lede { margin-top: var(--space-6); max-width: 46ch; }
  @media (max-width: 39.99rem) { .eb-wide { display: none; } }
  .hero-actions { margin-top: var(--space-6); gap: var(--space-3); }

  .hero-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    background: var(--surface-raised);
    color: var(--ink);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-3);
    position: relative;
    overflow: hidden;
    transition: transform var(--dur-control) var(--ease-out);
    animation: rise-card 1.2s var(--ease-out) 0.25s both;
  }
  @keyframes rise-card {
    from { transform: translate3d(0, 24px, 0); }
    to   { transform: none; }
  }
  .hero-card::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 4px;
    background: var(--brand-ramp);
  }
  .hero-card:hover { transform: translate3d(0, -4px, 0); color: var(--ink); }
  .hc-top { display: flex; align-items: center; gap: var(--space-3); }
  .hc-kicker { font-size: var(--text-xs); font-weight: 700; letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; color: var(--muted); }
  .hc-price { font-size: clamp(2.4rem, 2rem + 1.4vw, 3.1rem); line-height: 1; letter-spacing: var(--tracking-display); color: var(--ink); }
  .hc-cur { font-family: var(--font-sans); font-size: max(0.8rem, 0.34em); font-weight: 700; letter-spacing: 0.06em; color: var(--muted); vertical-align: 0.6em; }
  .hc-note { font-size: var(--text-sm); color: var(--ink-soft); line-height: 1.5; }

  /* The credentials rail along the foot of the hero. */
  .creds {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: clamp(3rem, 2rem + 4vw, 5.5rem);
    border-top: 1px solid var(--line-invert);
  }
  @media (min-width: 52rem) { .creds { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .cred {
    padding: var(--space-5) var(--space-4) var(--space-5) 0;
  }
  /* Room for the estimator panel, which rises 4rem over the foot of the hero. */
  .hero { padding-bottom: calc(4rem + var(--space-6)); }
  .cred + .cred { padding-left: var(--space-5); border-left: 1px solid var(--line-invert); }
  @media (max-width: 51.99rem) {
    .cred:nth-child(3) { padding-left: 0; border-left: 0; }
    .cred:nth-child(n + 3) { border-top: 1px solid var(--line-invert); }
  }
  .creds dd { margin: 0; }

  /* ================================================================== SERVICES */
  .bento {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 40rem) { .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) {
    .bento { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-5); }
    .tile--0 { grid-column: span 2; }
    .tile--0 .tile-media { aspect-ratio: 16 / 7.6; }
    .tile--5 { grid-column: span 2; }
  }
  .tile {
    display: flex;
    flex-direction: column;
    background: var(--surface-raised);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    overflow: hidden;
    color: var(--ink);
    transition: transform var(--dur-control) var(--ease-out), box-shadow var(--dur-control) var(--ease-out), border-color var(--dur-hover);
  }
  a.tile:hover { transform: translate3d(0, -4px, 0); box-shadow: var(--shadow-2); border-color: var(--line-strong); color: var(--ink); }
  .tile-media { aspect-ratio: 16 / 10; border-radius: 0; }
  .tile-media :global(picture) { height: 100%; }
  .tile-badge {
    position: absolute;
    left: var(--space-4);
    bottom: var(--space-4);
    padding: 0.4rem 0.8rem;
    border-radius: var(--r-pill);
    background: var(--surface-raised);
    color: var(--ink);
    font-size: var(--text-xs);
    font-weight: 700;
    box-shadow: var(--shadow-2);
  }
  .tile-body { display: flex; flex-direction: column; gap: var(--space-3); padding: var(--pad-card); flex: 1; }
  .tile-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-1); }
  .tile-n { font-size: var(--text-xs); font-weight: 700; letter-spacing: var(--tracking-eyebrow); color: var(--muted); }
  .tile h3 { font-size: var(--text-h3); }
  .tile-body p { color: var(--muted); font-size: var(--text-sm); }
  .tile .link-arrow { margin-top: auto; padding-top: var(--space-3); }
  /* The analytics tile runs as a row on desktop: photograph left, words right.
     It is written after .tile on purpose; at equal specificity the later rule
     wins, and .tile sets the column direction. */
  @media (min-width: 64rem) {
    .tile.tile--5 { flex-direction: row; }
    .tile--5 .tile-media { aspect-ratio: auto; flex: 0 0 55%; }
    .tile--5 .tile-body { justify-content: center; padding: var(--space-6); }
  }

  .tile--cta {
    justify-content: center;
    gap: var(--space-4);
    padding: var(--space-6);
    background: var(--surface-invert);
    border-color: transparent;
    color: var(--ink-invert);
    position: relative;
  }
  .tile--cta::before { content: ""; position: absolute; inset: 0 0 auto 0; height: 4px; background: var(--brand-ramp); }
  .tile--cta .eyebrow { margin-bottom: 0; }
  .tile-cta-h { font-size: clamp(1.5rem, 1.25rem + 0.9vw, 1.95rem); line-height: 1.15; color: var(--ink-invert); letter-spacing: var(--tracking-tight); }
  .tile--cta .btn { align-self: flex-start; }
  @media (min-width: 40rem) and (max-width: 63.99rem) { .tile--cta { grid-column: span 2; } }

  /* ================================================================== WHY */
  .why { position: relative; isolation: isolate; overflow: hidden; }
  .why-glow {
    position: absolute;
    z-index: -1;
    width: 46rem;
    height: 30rem;
    left: -20rem;
    top: -12rem;
    border-radius: 50%;
    background: oklch(30% 0.06 245);
    filter: blur(120px);
    mix-blend-mode: screen;
  }
  .pillars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }
  @media (min-width: 40rem) { .pillars { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 72rem) { .pillars { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .pillar {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--pad-card);
