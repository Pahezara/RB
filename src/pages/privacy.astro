---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
const title = 'Privacy — Reliance Business Partners';
const description =
  'How Reliance Business Partners handles the information you send through this website, what is stored, and how to ask for it to be removed.';
---
<Base title={title} description={description}>
  <section class="section">
    <div class="container prose stack">
      <p class="eyebrow">Privacy</p>
      <h1>Privacy</h1>
      <p>
        This page describes what happens to information you send us through this website.
      </p>
      <h2>What this site collects</h2>
      <p>
        Nothing automatically. This site sets no cookies, runs no analytics and loads no third-party scripts. Nothing you do here is tracked.
      </p>
      <h2>The fee estimator</h2>
      <p>
        The estimator on the home page runs entirely in your own browser. What you select is never sent anywhere, never stored, and never reaches us. Close the tab and it is gone.
      </p>
      <h2>What you send us</h2>
      <p>
        The enquiry action opens your own e-mail application with the details you typed. Anything you then send reaches us as an ordinary e-mail, and is held in our e-mail system so we can reply and act on it.
      </p>
      <h2>What we do with it</h2>
      <p>
        We use it to answer you and to carry out work you instruct us to do. We do not sell it and we do not pass it to anyone else for marketing. Client information is held in confidence, which is one of the firm's stated values rather than a line added to a policy page.
      </p>
      <h2>Asking us to remove it</h2>
      <p>
        Write to <a href={`mailto:${site.email}`}>{site.email}</a> and ask. Where we are not required by law or by professional obligation to keep a record, we will delete it.
      </p>
      <h2>Contact</h2>
      <p>
        {site.legalName}, {site.address.street}, {site.address.locality}, Sri Lanka.
      </p>
    </div>
  </section>
</Base>
<style>
  h2 { font-size: var(--text-h3); margin-top: var(--space-5); }
</style>
