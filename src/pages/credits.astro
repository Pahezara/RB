---
/*
 * Image credits, and the licences of everything else this site is built from.
 *
 * Read straight from src/data/images.json, whose author, licence and source
 * fields are written by scripts/make-images.mjs from the Wikimedia Commons API
 * and never by hand. An image cannot reach a page without passing through
 * <Img>, which reads the same file, so it cannot reach a page without appearing
 * here either.
 *
 * CC BY and CC BY-SA require the creator, the licence, a link to it, and a note
 * of any changes. All four are on every row, whatever the licence, because the
 * cost of doing it for a CC0 photograph too is one line of type.
 */
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import manifest from '../data/images.json';

type Entry = (typeof manifest.images)[number] & {
  authorUrl?: string;
  crop?: number[];
  scrim?: unknown;
  portrait?: { crop?: number[] };
};
const images = manifest.images as Entry[];

/* What was done to each photograph, derived from the manifest entry itself. */
const changes = (img: Entry) => {
  const out: string[] = [];
  if (img.crop) out.push('cropped');
  if (img.scrim) out.push('darkened toward navy behind the text laid over it');
  if (img.portrait) out.push('given a separate crop for phones');
  out.push('resized and re-encoded as AVIF and WebP');
  const s = out.join(', ');
  return s[0].toUpperCase() + s.slice(1) + '.';
};

const byLicence = images.reduce<Record<string, number>>((acc, i) => {
  acc[i.license] = (acc[i.license] ?? 0) + 1;
  return acc;
}, {});
const shareAlike = images.filter((i) => i.license.startsWith('CC BY-SA'));

const title = 'Image credits — Reliance Business Partners';
const description =
  'The photographers whose work appears on this site, the licence each photograph is used under, and the fonts and icons the site is built with.';
---
<Base title={title} description={description} overHero>
  <PageHero
    variant="plain"
    eyebrow="Credits"
    title="The work of <em>other people.</em>"
    lede={`Every photograph on this site is used under an open licence, sourced through Wikimedia Commons. ${images.length} photographs, and who made each one.`}
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Credits' }]}
  />

  <section class="section" aria-labelledby="photos-h">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">Photography</p>
          <h2 id="photos-h">{images.length} photographs, <em>credited.</em></h2>
        </div>
        <div class="intro">
          <p>
            The photographs set the scene. None of them shows the firm's office,
            its people or its clients, and none should be read as doing so.
          </p>
          <ul class="chips lic-sum" aria-label="Licences used">
            {Object.entries(byLicence).map(([l, n]) => <li>{l} &middot; {n}</li>)}
          </ul>
        </div>
      </div>

      <ol class="credits">
        {images.map((img) => (
          <li class="credit">
            <div class="media credit-media">
              <Img slug={img.slug} sizes="(min-width: 40rem) 11rem, 100vw" alt="" />
            </div>
            <div class="credit-body">
              <p class="credit-use">{img.use.replace(/\s*\(.*\)$/, '')}</p>
              <h3 class="credit-h">{img.file.replace(/\.(jpe?g|png)$/i, '').replace(/_/g, ' ')}</h3>
              <dl class="credit-meta">
                <div>
                  <dt>By</dt>
                  <dd>{img.authorUrl ? <a href={img.authorUrl} rel="noopener nofollow">{img.author}</a> : img.author}</dd>
                </div>
                <div>
                  <dt>Licence</dt>
                  <dd>{img.licenseUrl ? <a href={img.licenseUrl} rel="noopener license">{img.license}</a> : img.license}</dd>
                </div>
                <div>
                  <dt>Source</dt>
                  <dd><a href={img.page} rel="noopener">Wikimedia Commons</a></dd>
                </div>
                <div>
                  <dt>Changes</dt>
                  <dd>{changes(img)}</dd>
                </div>
              </dl>
            </div>
          </li>
        ))}
      </ol>

      {shareAlike.length > 0 && (
        <p class="sa-note">
          {shareAlike.length === 1 ? 'One photograph is' : `${shareAlike.length} photographs are`} licensed
          ShareAlike. The adapted {shareAlike.length === 1 ? 'version' : 'versions'} served on this site {shareAlike.length === 1 ? 'is' : 'are'} offered
          under the same licence as the original.
        </p>
      )}
    </div>
  </section>

  <section class="section band" aria-labelledby="type-h">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Type and icons</p>
        <h2 id="type-h">What the pages are <em>set in.</em></h2>
      </div>
      <ul class="kit">
        <li class="kit-card">
          <p class="kit-sample kit-sample--serif" aria-hidden="true">Aa</p>
          <h3>Newsreader</h3>
          <p>
            The display serif, by Production Type. Used under the{' '}
            <a href="https://openfontlicense.org/" rel="noopener license">SIL Open Font License 1.1</a>,
            cut down to the sizes and weights this site uses and served from this site.
          </p>
        </li>
        <li class="kit-card">
          <p class="kit-sample" aria-hidden="true">Aa</p>
          <h3>Schibsted Grotesk</h3>
          <p>
            The text face, designed for Schibsted. Used under the{' '}
            <a href="https://openfontlicense.org/" rel="noopener license">SIL Open Font License 1.1</a>,
            and served from this site.
          </p>
        </li>
        <li class="kit-card">
          <p class="kit-sample kit-sample--icon" aria-hidden="true"><Icon name="landmark" size={44} stroke={1.5} /></p>
          <h3>Lucide</h3>
          <p>
            The icons, by Lucide Icons and contributors. Used under the{' '}
            <a href="https://lucide.dev/license" rel="noopener license">ISC License</a>,
            and drawn into each page when it is built.
          </p>
        </li>
      </ul>
      <p class="kit-note">
        The Reliance Business Partners name and mark belong to the firm and are not
        covered by any of the licences above.
      </p>
    </div>
  </section>
</Base>

<style>
  .lic-sum { margin-top: var(--space-4); }

  .credits { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4); }
  @media (min-width: 64rem) { .credits { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5); } }
  .credit {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-4);
    background: var(--surface-raised);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
  }
  @media (min-width: 40rem) { .credit { grid-template-columns: 11rem minmax(0, 1fr); gap: var(--space-5); } }
  .credit-media { aspect-ratio: 4 / 3; border-radius: var(--r-sm); }
  @media (min-width: 40rem) { .credit-media { aspect-ratio: 1; } }
  .credit-media :global(picture) { height: 100%; }
  .credit-use {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--accent-ink);
  }
  .credit-h {
    margin-top: var(--space-2);
    font-size: 1.2rem;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
  .credit-meta { margin: var(--space-4) 0 0; display: grid; gap: var(--space-2); font-size: var(--text-sm); }
  .credit-meta div { display: grid; grid-template-columns: 5.5rem minmax(0, 1fr); gap: var(--space-3); }
  .credit-meta dt { color: var(--muted); }
  .credit-meta dd { margin: 0; color: var(--ink); overflow-wrap: anywhere; }
  .sa-note { margin-top: var(--space-6); max-width: 48rem; color: var(--ink-soft); font-size: var(--text-sm); }

  .kit { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4); }
  @media (min-width: 52rem) { .kit { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-5); } }
  .kit-card {
    padding: clamp(1.5rem, 1.2rem + 1vw, 2.25rem);
    background: var(--surface-raised);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }
  .kit-sample { font-family: var(--font-sans); font-size: 3.5rem; line-height: 1; color: var(--ink); height: 3.5rem; }
  .kit-sample--serif { font-family: var(--font-display); font-style: italic; color: var(--accent-ink); }
  .kit-sample--icon { color: var(--accent-ink); display: flex; align-items: center; }
  .kit-card h3 { font-size: var(--text-h3); }
  .kit-card p:not(.kit-sample) { color: var(--ink-soft); font-size: var(--text-sm); }
  .kit-note { margin-top: var(--space-6); color: var(--muted); font-size: var(--text-sm); max-width: 48rem; }
</style>
