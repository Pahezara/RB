---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { site, team, sectors, credentials, directors } from '../data/site';

/* [CONTENT] About: title and description. */
const title = 'About Reliance Business Partners | Business Support Sri Lanka';
const description =
  'Meet Reliance Business Partners, established in 2018, supporting businesses with accounting, corporate administration, systems and advisory services.';

/* "Import and export", ... "NGOs" -> a sentence-case list for the prose. */
const sectorList = sectors.map((s) => (s === 'NGOs' ? s : s.toLowerCase()));
---
<Base title={title} description={description} overHero>
  <PageHero
    variant="photo"
    image="colombo-golden"
    eyebrow="About Reliance Business Partners"
    title="Practical support, <em>for the long run.</em>"
    lede={`Founded in ${site.founded}, we bring the professional services a business needs under one roof, so you have one team to call.`}
    crumbs={[{ label: 'Home', href: '/' }, { label: 'About' }]}
  />

  {/* ------------------------------------------------------------ WHO WE ARE */}
  <section class="section" aria-labelledby="firm-h">
    <div class="container story">
      <div>
        <p class="eyebrow">Who we are</p>
        <h2 id="firm-h" class="story-h">From the records a business keeps <em>to the decisions it makes.</em></h2>
      </div>
      <div class="story-body">
        <p class="lede">
          We support entrepreneurs and organisations that need dependable finance,
          corporate administration, business advice and operational support.
        </p>
        <p>
          Our work connects the records a business maintains with the decisions its
          owners and managers need to make. From building an accounting function to
          documenting procedures or preparing a business plan, we focus on practical
          work that supports the next stage of the business.
        </p>
        <p>
          {site.legalName} is affiliated with <a href={site.affiliate.href} rel="noopener">{site.affiliate.name}</a> ({site.affiliate.role}). Tax and assurance work is conducted through Synergy Advisors and Sanjeewa Associates, and each provider’s role is made clear before an engagement begins.
        </p>
      </div>
    </div>

    <div class="container">
      <dl class="figures">
        {credentials.map((c) => (
          <div class="stat">
            <dt class="visually-hidden">{c.label}</dt>
            <dd>
              <span class="stat-n tnum">{c.n}</span>
              <span class="stat-l" aria-hidden="true">{c.label}</span>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  {/* ------------------------------------------------------------ VISION + MISSION */}
  <section class="section band--dark on-invert vv" aria-labelledby="vision-h">
    <div class="container">
      <div class="vmv">
        <div class="vm">
          <p class="eyebrow">Our vision</p>
          <h2 id="vision-h" class="vm-quote">{site.vision}</h2>
        </div>
        <div class="vm vm--mission">
          <p class="eyebrow">Our mission</p>
          <p class="vm-text">{site.mission}</p>
        </div>
      </div>
      <p class="tagline-line">{site.tagline} <span>&middot; {site.taglineSub}</span></p>
    </div>
  </section>

  {/* ------------------------------------------------------------ VALUES */}
  <section class="section" aria-labelledby="values-h">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">Our values</p>
          <h2 id="values-h">Seven commitments that <em>guide how we work.</em></h2>
        </div>
        <p class="intro">What a client can expect from us on every engagement, large or small.</p>
      </div>
      <ul class="values">
        {site.values.map((v, i) => (
          <li class="value">
            <span class="value-top">
              <span class="icon-tile"><Icon name={v.icon} /></span>
              <span class="value-n tnum">{String(i + 1).padStart(2, '0')}</span>
            </span>
            <h3>{v.name}</h3>
            <p>{v.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ------------------------------------------------------------ THE TEAM */}
  <section class="section band" aria-labelledby="team-h">
    <div class="container team">
      <div>
        <p class="eyebrow">The team</p>
        <h2 id="team-h">{team.total} people, <em>four grades.</em></h2>
        <p class="lede team-lede">
          Qualified accountants at the core, supported by managers and associates, and
          led by {directors.length} directors.
        </p>
        <a class="link-arrow team-link" href="/management/">Meet the directors <Icon name="arrow-right" size={16} stroke={2} /></a>
      </div>
      <div class="team-viz">
        <div class="team-bar" aria-hidden="true">
          {team.rows.map((r, i) => (
            <span class={`seg seg-${i}`} style={`flex-grow:${r.n}`}><span class="seg-n">{r.n}</span></span>
          ))}
        </div>
        <dl class="rows team-rows">
          {team.rows.map((r, i) => (
            <div>
              <dt><span class={`key key-${i}`} aria-hidden="true"></span>{r.role}</dt>
              <dd class="tnum">{r.n}</dd>
            </div>
          ))}
          <div class="total-row">
            <dt>Total</dt>
            <dd class="tnum">{team.total}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------ SECTORS */}
  <section class="section" aria-labelledby="sect-h">
    <div class="container sect">
      <div>
        <p class="eyebrow">Businesses we support</p>
        <h2 id="sect-h">Fifteen sectors the firm <em>already knows.</em></h2>
        <p class="sect-p">
          Our corporate profile identifies experience across {sectorList.slice(0, -1).join(', ')} and {sectorList[sectorList.length - 1]}.
        </p>
        <a class="link-arrow sect-link" href="/industries/">How we work with each <Icon name="arrow-right" size={16} stroke={2} /></a>
      </div>
      <ul class="chips sect-chips">
        {sectors.map((s) => <li>{s}</li>)}
      </ul>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .story { display: grid; gap: var(--space-6); }
  @media (min-width: 64rem) { .story { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-9); } }
  .story-h { max-width: 18ch; }
  .story-body { display: grid; gap: var(--space-5); color: var(--ink-soft); }
  .story-body .lede { color: var(--ink); max-width: none; }

  .figures {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6) var(--space-5);
    margin: clamp(3rem, 2rem + 3vw, 5rem) 0 0;
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
  }
  @media (min-width: 52rem) { .figures { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .figures dd { margin: 0; display: grid; gap: var(--space-2); }

  /* ------------------------------------------------------------ vision + mission */
  .vmv { display: grid; gap: var(--space-7); }
  @media (min-width: 64rem) { .vmv { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: var(--space-9); align-items: start; } }
  .vm-quote { font-size: clamp(1.4rem, 1.1rem + 1.2vw, 2rem); line-height: 1.14; font-weight: 600; color: var(--ink-invert); }
  .vm--mission { padding: var(--pad-card); background: var(--surface-invert-2); border: 1px solid var(--line-invert); border-radius: var(--r-lg); }
  .vm-text { font-size: var(--text-lede); line-height: 1.6; color: var(--ink-invert); }
  .tagline-line {
    margin-top: var(--space-7);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line-invert);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--ink-invert);
  }
  .tagline-line span { color: var(--accent-lift); }

  /* ------------------------------------------------------------ values */
  .values { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4); }
  @media (min-width: 40rem) { .values { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) {
    .values { grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--space-5); }
    .value { grid-column: span 3; }
    .value:nth-child(n + 5) { grid-column: span 4; }
  }
  .value {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--pad-card);
    background: var(--surface-raised);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
  }
  .value-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-2); }
  .value-n { font-size: var(--text-xs); font-weight: 700; letter-spacing: var(--tracking-eyebrow); color: var(--muted); }
  .value h3 { font-size: var(--text-h4); font-family: var(--font-sans); font-weight: 700; letter-spacing: -0.01em; }
  .value p { color: var(--ink-soft); font-size: var(--text-sm); }

  /* ------------------------------------------------------------ team */
  .team { display: grid; gap: var(--space-7); align-items: center; }
  @media (min-width: 64rem) { .team { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: var(--space-9); } }
  .team-lede { margin-top: var(--space-5); }
  .team-link { margin-top: var(--space-4); }
  .team-bar { display: flex; height: 4.5rem; border-radius: var(--r-md); overflow: hidden; margin-bottom: var(--space-6); box-shadow: var(--shadow-1); }
  .seg { display: flex; align-items: flex-end; padding: var(--space-2) var(--space-3); min-width: 0; }
  .seg + .seg { border-left: 2px solid var(--surface); }
  .seg-n { font-family: var(--font-display); font-weight: 600; font-size: 1.6rem; line-height: 1; }
  /* Darkest for the most senior grade. Each label measured against its own
     fill in check-contrast's registry. */
  .seg-0, .key-0 { background: var(--surface-invert); color: var(--ink-invert); }
  .seg-1, .key-1 { background: var(--surface-invert-2); color: var(--ink-invert); }
  .seg-2, .key-2 { background: var(--accent); color: var(--ink-on-accent); }
  .seg-3, .key-3 { background: var(--accent-tint); color: var(--ink); }
  .team-rows dt { display: flex; align-items: center; gap: var(--space-3); }
  .key { width: 0.9rem; height: 0.9rem; border-radius: 3px; flex: none; }
  .key-3 { box-shadow: inset 0 0 0 1px var(--line-strong); }
  .total-row dt, .total-row dd { font-weight: 700; color: var(--ink); }

  /* ------------------------------------------------------------ sectors */
  .sect { display: grid; gap: var(--space-6); align-items: start; }
  @media (min-width: 64rem) { .sect { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: var(--space-9); } }
  .sect-p { margin-top: var(--space-5); color: var(--ink-soft); }
  .sect-link { margin-top: var(--space-4); }
</style>
