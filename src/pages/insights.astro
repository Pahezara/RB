---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { usefulLinks } from '../data/site';

const title = 'Insights and Useful Links | Reliance Business Partners';
const description =
  'Official sources for doing business in Sri Lanka and the UAE: company registration, labour, EPF, foreign exchange, Port City, Customs and NMRA.';

/* Articles live in src/content/insights/ once the firm publishes them. Until
   then the page leads with the official sources, and no placeholder post is
   ever shown: an empty "coming soon" list says less than nothing. */
const posts = Object.values(
  import.meta.glob<{ frontmatter: { title: string; date: string; summary: string } ; url?: string }>('../content/insights/*.md', { eager: true }),
).sort((a, b) => b.frontmatter.date.localeCompare(a.frontmatter.date));

const host = (u: string) => new URL(u).hostname.replace(/^www\./, '');
---
<Base title={title} description={description} overHero>
  <PageHero
    variant="plain"
    eyebrow="Insights"
    title="Useful sources for <em>doing business well.</em>"
    lede="The official websites our clients most often need, from company registration and employment to foreign exchange, Port City and Customs. Each opens the authority’s own site."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Insights' }]}
  />

  {posts.length > 0 && (
    <section class="section" aria-labelledby="posts-h">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">From the firm</p>
          <h2 id="posts-h">Latest <em>insights.</em></h2>
        </div>
        <ul class="posts">
          {posts.map((p) => (
            <li class="post">
              <time class="post-date" datetime={p.frontmatter.date}>{new Date(p.frontmatter.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</time>
              <h3>{p.frontmatter.title}</h3>
              <p>{p.frontmatter.summary}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class:list={['section', posts.length > 0 && 'band']} aria-labelledby="links-h">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">Links to important sites</p>
          <h2 id="links-h">Go straight to <em>the source.</em></h2>
        </div>
        <p class="intro">
          Rules, rates and forms change. When a decision depends on one, check the
          authority’s current position, or ask us to.
        </p>
      </div>
      <ul class="links">
        {usefulLinks.map((l) => (
          <li>
            <a class="link link-plain" href={l.href} rel="noopener" target="_blank">
              <span class="link-host">{host(l.href)}</span>
              <span class="link-name">{l.name}</span>
              <span class="link-note">{l.note}</span>
              <span class="link-go" aria-hidden="true"><Icon name="arrow-up-right" size={18} stroke={2} /></span>
              <span class="visually-hidden">(opens in a new tab)</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand
    title="Not sure which rule <em>applies to you?</em>"
    text="Tell us what you are planning. We will identify the registrations, approvals and filings involved, and who is responsible for each."
  />
</Base>

<style>
  .posts { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4); }
  @media (min-width: 52rem) { .posts { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .post { padding: var(--pad-card); background: var(--surface-raised); border: 1px solid var(--line); border-radius: var(--r-md); display: grid; gap: var(--space-2); }
  .post-date { font-size: var(--text-xs); font-weight: 700; color: var(--accent-ink); }
  .post h3 { font-size: var(--text-h4); }
  .post p { color: var(--muted); font-size: var(--text-sm); }

  .links { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4); }
  @media (min-width: 40rem) { .links { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .links { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-5); } }
  .link {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-2);
    height: 100%;
    padding: var(--pad-card);
    padding-right: calc(var(--pad-card) + 2.5rem);
    background: var(--surface-raised);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    color: var(--ink);
    transition: transform var(--dur-control) var(--ease-out), box-shadow var(--dur-control) var(--ease-out), border-color var(--dur-hover);
  }
  .link:hover { transform: translate3d(0, -3px, 0); box-shadow: var(--shadow-2); border-color: var(--line-strong); color: var(--ink); }
  .link-host { font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.02em; color: var(--accent-ink); }
  .link-name { font-size: var(--text-h4); font-weight: 700; line-height: 1.3; letter-spacing: -0.01em; }
  .link-note { color: var(--muted); font-size: var(--text-sm); }
  .link-go {
    position: absolute;
    top: var(--pad-card);
    right: var(--pad-card);
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--r-pill);
    background: var(--accent-tint);
    color: var(--accent-ink);
    transition: transform var(--dur-control) var(--ease-out);
  }
  .link:hover .link-go { transform: rotate(45deg); }
</style>
