---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Estimator from '../components/Estimator.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import {
  site, packages, packageMatrix, ongoingFees, extras, annualRetainer, steps,
} from '../data/site';

const title = 'Incorporation packages — Reliance Business Partners';
const description =
  'Company incorporation in Sri Lanka: Basic LKR 36,000, Advanced LKR 45,500, Premium LKR 60,000 for one director, and exactly what is in each.';

const money = (n: number) => n.toLocaleString('en-US');
---
<Base title={title} description={description} overHero>
  <PageHero
    eyebrow="Corporate secretarial"
    title="Three packages, <em>priced in full.</em>"
    lede="Each price is for a company with one director, and every additional director is added at the package's own published rate. There is nothing else to find out later."
    image="svc-secretarial"
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Packages' }]}
  >
    <a class="btn btn--primary btn--lg" href="#tiers">See the packages <Icon name="arrow-right" size={18} stroke={2} /></a>
    <a class="btn btn--ghost btn--lg" href="#estimate">Price your own</a>
  </PageHero>

  {/* ------------------------------------------------------------ THE THREE TIERS */}
  <section id="tiers" class="section" aria-labelledby="tiers-h">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">Incorporation packages</p>
          <h2 id="tiers-h">Choose how much of the <em>paperwork</em> you want done for you.</h2>
        </div>
        <p class="intro">
          All three get the company incorporated, registered for tax and ready to
          open a bank account, with the first year's retainer included. The
          difference is how complete the statutory record is on day one.
        </p>
      </div>

      <ol class="tiers">
        {packages.map((p, i) => {
          const full = i === packages.length - 1;
          return (
            <li class:list={['tier', full && 'tier--full on-invert']}>
              {full && <p class="tier-flag">The most complete</p>}
              <p class="tier-name">{p.name}</p>
              <p class="tier-price display"><span class="tier-cur">LKR</span>{money(p.price)}</p>
              <p class="tier-for">for a company with one director</p>
              <p class="tier-sum">{p.summary}</p>
              <a class:list={['btn', 'btn--block', full ? 'btn--primary' : 'btn--dark']} href="/contact/">
                Start with {p.name} <Icon name="arrow-right" size={18} stroke={2} />
              </a>
              <p class="tier-inc">{p.includes.length} items included</p>
              <ul class="ticks tier-list">
                {p.includes.map((line) => <li>{line}</li>)}
              </ul>
              <p class="tier-add">+ LKR {money(p.perDirector)} for each additional director</p>
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  {/* ------------------------------------------------------------ SIDE BY SIDE */}
  <section class="section band" aria-labelledby="compare-h">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">Side by side</p>
          <h2 id="compare-h">What changes <em>between them.</em></h2>
        </div>
        <p class="intro">
          The first four lines and the last are in all three. Everything else is
          what you are choosing between.
        </p>
      </div>

      {/* A horizontally scrolling table with no hint is a table most phone
          users never scroll. The note is shown only where the table actually
          overflows, and it is real text rather than a fading edge, because a
          gradient is not an instruction. */}
      <p class="table-hint">Scroll sideways to compare all three.</p>

      <div class="table-wrap">
        <table class="matrix">
          <caption class="visually-hidden">What each incorporation package includes</caption>
          <thead>
            <tr>
              <th scope="col">Included</th>
              {packages.map((p) => (
                <th scope="col">
                  <span class="th-name">{p.name}</span>
                  <span class="th-price">LKR {money(p.price)}</span>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {packageMatrix.map((rowItem) => (
              <tr>
                <th scope="row">
                  {rowItem.label}
                  {rowItem.wordingVaries && <span class="marker" aria-hidden="true">*</span>}
                </th>
                {rowItem.in.map((has, i) => (
                  <td class:list={[has ? 'yes' : 'no']}>
                    <span class="visually-hidden">{has ? 'Included in' : 'Not in'} {packages[i].name}</span>
                    <span aria-hidden="true" class="mark">{has ? '' : '–'}</span>
                  </td>
                ))}
              </tr>
            ))}
            <tr class="foot-row">
              <th scope="row">Each additional director</th>
              {packages.map((p) => <td>LKR {money(p.perDirector)}</td>)}
            </tr>
          </tbody>
        </table>
      </div>

      <p class="note">
        <span aria-hidden="true">*</span> The firm's fee sheet words this line
        differently between packages: Form 18 and Form 19 are specified as{' '}
        <em>certified</em> copies on Advanced and as plain copies on Premium. The
        difference is flagged rather than smoothed over. Ask us which applies to
        your filing and we will confirm it in writing.
      </p>
    </div>
  </section>

  {/* ------------------------------------------------------------ THE SEQUENCE */}
  <section class="section" aria-labelledby="seq-h">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">What happens</p>
          <h2 id="seq-h">Four steps from <em>idea to bank account.</em></h2>
        </div>
        <p class="intro">Every package runs the same sequence. The difference is only in what you are holding at the end of it.</p>
      </div>
      <ol class="steps">
        {steps.map((s) => (
          <li class="step">
            <span class="step-n">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.detail}</p>
            <p class="step-meta">{s.who}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ------------------------------------------------------------ YOUR OWN FIGURE */}
  <div class="est-band band"><Estimator overlap={false} /></div>

  {/* ------------------------------------------------------------ AFTERWARDS */}
  <section class="section" aria-labelledby="ongoing-h">
    <div class="container split">
      <div>
        <div class="section-head">
          <p class="eyebrow">Afterwards</p>
          <h2 id="ongoing-h">What is charged <em>once the company exists.</em></h2>
          <p class="intro">
            The first year retainer is inside all three packages. These are the
            things that can be billed after that, each at a published rate.
          </p>
        </div>
        <dl class="rows fee-rows">
          {ongoingFees.map((f) => (
            <div>
              <dt>
                {f.label}
                <span class="fee-detail">{f.detail}</span>
              </dt>
              <dd>{f.amount}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="side">
        <div class="solid-panel">
          <span class="icon-tile"><Icon name="laptop" /></span>
          <h3>Systems for day one</h3>
          <p class="muted">Two things a new company usually needs the week it starts trading. Both are starting prices.</p>
          <dl class="rows fee-rows side-rows">
            {extras.map((e) => (
              <div>
                <dt>{e.name}</dt>
                <dd>from LKR {money(e.price)}{e.kind === 'monthly' ? ' / month' : ''}</dd>
              </div>
            ))}
          </dl>
        </div>

        <div class="solid-panel panel-dark on-invert">
          <span class="icon-tile"><Icon name="clock" /></span>
          <h3>Year two onwards</h3>
          <p>
            The annual retainer is <strong>LKR {money(annualRetainer)}</strong>,
            charged when your Form 15 is filed. It is the only thing that recurs
            automatically.
          </p>
          <div class="stack">
            <a class="btn btn--primary btn--block" href="/contact/">Start an enquiry <Icon name="arrow-right" size={18} stroke={2} /></a>
            <a class="btn btn--ghost btn--block tnum" href={site.phoneHref}>{site.phone}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    title="Ready to register? <em>Tell us the name.</em>"
    text="Name approval is the first filing, and the first thing that can come back. Send the name you want and the number of directors, and we will tell you exactly what happens next."
  />
</Base>

<style>
  /* ------------------------------------------------------------ tiers */
  .tiers { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-5); align-items: stretch; }
  @media (min-width: 60rem) { .tiers { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .tier {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: clamp(1.5rem, 1.2rem + 1vw, 2.25rem);
    background: var(--surface-raised);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    overflow: hidden;
  }
  /* The fullest package is set dark. It marks the most COMPLETE option, not a
     recommended one: the firm has not said which it recommends, so the site
     does not either. */
  .tier--full { background: var(--surface-invert); border-color: transparent; color: var(--ink-invert); box-shadow: var(--shadow-3); }
  .tier--full::before { content: ""; position: absolute; inset: 0 0 auto 0; height: 4px; background: var(--brand-ramp); }
  .tier-flag {
    align-self: flex-start;
    padding: 0.3rem 0.75rem;
    border-radius: var(--r-pill);
    background: oklch(100% 0 0 / 0.08);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--accent-lift);
  }
  .tier-name { font-weight: 700; font-size: var(--text-h4); }
  .tier-price { font-size: clamp(2.75rem, 2.2rem + 2vw, 3.6rem); line-height: 1; letter-spacing: var(--tracking-display); }
  .tier-cur { font-family: var(--font-sans); font-size: max(0.8rem, 0.3em); font-weight: 700; letter-spacing: 0.06em; color: var(--muted); vertical-align: 0.75em; margin-inline-end: 0.3em; }
  .tier--full .tier-cur { color: var(--muted-invert); }
  .tier-for { font-size: var(--text-xs); font-weight: 700; letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; color: var(--muted); }
  .tier--full .tier-for { color: var(--muted-invert); }
  .tier-sum { color: var(--ink-soft); font-size: var(--text-sm); min-height: 3.2em; }
  .tier--full .tier-sum { color: var(--muted-invert); }
  .tier .btn { margin-block: var(--space-2); }
  .tier-inc {
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--accent-ink);
  }
  .tier--full .tier-inc { border-color: var(--line-invert); color: var(--accent-lift); }
  .tier-list { font-size: var(--text-sm); gap: var(--space-2); }
  .tier-add { margin-top: auto; padding-top: var(--space-4); font-size: var(--text-sm); color: var(--muted); }
  .tier--full .tier-add { color: var(--muted-invert); }

  /* ------------------------------------------------------------ matrix */
  .table-hint { margin-bottom: var(--space-3); color: var(--muted); font-size: var(--text-sm); font-weight: 600; }
  @media (min-width: 40rem) { .table-hint { display: none; } }
  .table-wrap {
    /* position: relative is load-bearing, not decoration. Without it the sticky
       header cells are laid out against the root rather than against this
       scroller, and the document picks up horizontal overflow at 360px even
       though the wrapper is visibly clipping. */
    position: relative;
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--surface-raised);
    box-shadow: var(--shadow-1);
  }
  .matrix { border-collapse: collapse; width: 100%; min-width: 34rem; }
  .matrix th, .matrix td { padding: var(--space-4) var(--space-5); border-bottom: 1px solid var(--line); text-align: left; font-size: var(--text-sm); }
  .matrix thead th { position: sticky; top: 0; background: var(--surface-invert); color: var(--ink-invert); vertical-align: bottom; }
  .matrix thead th:not(:first-child) { text-align: center; }
  .th-name { display: block; font-family: var(--font-display); font-weight: 600; font-size: 1.35rem; }
  .th-price { display: block; font-weight: 600; color: var(--muted-invert); font-size: var(--text-xs); }
  .matrix tbody th { font-weight: 600; color: var(--ink); }
  .matrix tbody tr:hover th, .matrix tbody tr:hover td { background: var(--surface-sunken); }
  .matrix td { text-align: center; }
  .matrix tbody tr:last-child th, .matrix tbody tr:last-child td { border-bottom: 0; }
  /* The tick is drawn, not typed: a check glyph renders differently in every
     fallback font, and at this size the difference shows. */
  .yes .mark {
    display: inline-block;
    width: 1.35rem;
    height: 1.35rem;
    border-radius: var(--r-pill);
    background: var(--accent-tint);
    position: relative;
    vertical-align: middle;
  }
  .yes .mark::after {
    content: "";
    position: absolute;
    left: 0.43rem;
    top: 0.33rem;
    width: 0.38rem;
    height: 0.62rem;
    border-right: 2px solid var(--accent-ink);
    border-bottom: 2px solid var(--accent-ink);
    transform: rotate(40deg);
  }
  .no { color: var(--muted); }
  .marker { color: var(--accent-ink); margin-inline-start: 2px; }
  .foot-row th, .foot-row td { background: var(--surface-sunken); font-weight: 700; }
  .note { margin-top: var(--space-4); color: var(--muted); font-size: var(--text-sm); max-width: var(--measure); }

  /* ------------------------------------------------------------ estimator band */
  .est-band :global(.estimate) { padding-block: var(--section-y); }

  /* ------------------------------------------------------------ afterwards */
  /* minmax(0, …) on every track, not 1fr. A bare 1fr floors at the column's
     min-content width, so a single long figure can widen the grid past its
     container. */
  .split { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-7); align-items: start; }
  @media (min-width: 60rem) { .split { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: var(--space-9); } }
  .split .section-head { margin-bottom: var(--space-6); }
  .fee-rows dt { display: grid; gap: var(--space-1); max-width: 34ch; }
  .fee-detail { font-weight: 400; color: var(--muted); font-size: var(--text-sm); }
  /* NOT nowrap, and start-aligned. "LKR 5,000 virtually, LKR 7,500 in person"
     is 310px wide unbroken; the amounts are kept atomic by non-breaking spaces
     inside the figures (see ongoingFees in site.ts) and the sentence wraps. */
  .fee-rows dd { font-weight: 700; color: var(--ink); text-align: start; }
  .side { display: grid; gap: var(--space-4); }
  .side .solid-panel { display: grid; gap: var(--space-3); padding: clamp(1.5rem, 1.2rem + 1vw, 2rem); }
  .side h3 { margin: var(--space-2) 0 0; }
  .side .muted { font-size: var(--text-sm); }
  .side-rows { border-top: 0; margin-top: var(--space-2); }
  .side-rows > *:first-child { padding-top: 0; }
  .side-rows > *:last-child { border-bottom: 0; padding-bottom: 0; }
  .side-rows dd { color: var(--muted); }
  .panel-dark { background: var(--surface-invert); border-color: transparent; color: var(--ink-invert); }
  .panel-dark p { color: var(--muted-invert); font-size: var(--text-sm); }
  .panel-dark strong { color: var(--ink-invert); }
  .panel-dark .stack { margin-top: var(--space-3); }
</style>
