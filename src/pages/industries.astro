---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import { industries, serviceLines } from '../data/site';

const title = 'Industries — Reliance Business Partners';
const description =
  'The fourteen sectors Reliance Business Partners lists as its expertise, from import and export to hotels, manufacturing, agriculture and online commerce.';

const svc = (slug: string) => serviceLines.find((s) => s.slug === slug)!;
const sectorCount = industries.reduce((n, i) => n + i.sectors.length, 0);
---
<Base title={title} description={description} overHero>
  <PageHero
    eyebrow="Sectorial expertise"
    title={`${sectorCount === 14 ? 'Fourteen' : sectorCount} sectors, <em>six families.</em>`}
    lede="The industries whose books, filings and seasons the firm has worked in. This is not a client list: it is the ground the firm already knows, and the services that usually carry the weight in each."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Industries' }]}
  >
    <a class="btn btn--primary btn--lg" href="/contact/">Talk about your sector <Icon name="arrow-right" size={18} stroke={2} /></a>

    {/* All six families at a glance, each tile a jump to its section. The
        photographs carry no type: the label sits on its own solid chip. */}
    <ul class="mosaic" slot="figure">
      {industries.map((ind, i) => (
        <li class={`tile-${i + 1}`}>
          <a class="mosaic-a link-plain" href={`#${ind.slug}`}>
            <span class="mosaic-img"><Img slug={ind.image} sizes="(min-width: 64rem) 12rem, 33vw" alt="" loading={i === 0 ? "eager" : "lazy"} /></span>
            <span class="mosaic-chip"><Icon name={ind.icon} size={16} /><span class="mosaic-label">{ind.short}</span></span>
          </a>
        </li>
      ))}
    </ul>
  </PageHero>

  {/* A jump bar: all six families, one tap away. */}
  <nav class="jump" aria-label="Industry families">
    <div class="container">
      <ul>
        {industries.map((ind) => (
          <li><a class="link-plain" href={`#${ind.slug}`}><Icon name={ind.icon} size={18} /> {ind.short}</a></li>
        ))}
      </ul>
    </div>
  </nav>

  <section class="section" aria-label="The six industry families">
    <div class="container">
      <ol class="families">
        {industries.map((ind, i) => (
          <li class:list={['family', i % 2 === 1 && 'family--flip']} id={ind.slug}>
            <div class="media fam-media">
              <Img slug={ind.image} sizes="(min-width: 64rem) 38rem, 100vw" />
            </div>
            <div class="fam-body">
              <p class="fam-n tnum">{String(i + 1).padStart(2, '0')}</p>
              <h2 class="fam-h">{ind.title}</h2>
              <ul class="chips fam-sectors" aria-label="Sectors in this family">
                {ind.sectors.map((s) => <li>{s}</li>)}
              </ul>
              <p class="fam-blurb">{ind.blurb}</p>
              <p class="fam-label">Where the firm usually starts</p>
              <ul class="fam-svcs">
                {ind.services.map((slug) => {
                  const s = svc(slug);
                  return (
                    <li>
                      <a class="fam-svc link-plain" href={`/services/${s.slug}/`}>
                        <span class="icon-tile"><Icon name={s.icon} /></span>
                        <span>{s.title}</span>
                        <Icon name="arrow-right" size={16} stroke={2} class="fam-go" />
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <CtaBand
    title="Your sector is not on the list? <em>Ask anyway.</em>"
    text="The fourteen are where the firm has worked most. The six service lines apply to almost any business, and the first conversation costs nothing."
  />
</Base>

<style>
  /* ------------------------------------------------------------ hero mosaic */
  .mosaic {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
  }
  /* A gentle stagger: the middle column sits lower, so the grid reads as a set
     of photographs laid down rather than a table of them. */
  @media (min-width: 40rem) { .mosaic li:nth-child(3n + 2) { transform: translate3d(0, 1.75rem, 0); } }
  .mosaic-a { position: relative; display: block; border-radius: var(--r-md); overflow: hidden; box-shadow: var(--shadow-3); }
  .mosaic-img { display: block; aspect-ratio: 3 / 4; }
  .mosaic-img :global(picture), .mosaic-img :global(img) { width: 100%; height: 100%; }
  .mosaic-img :global(img) { object-fit: cover; transition: transform var(--dur-slow, 600ms) var(--ease-out); }
  .mosaic-a:hover .mosaic-img :global(img) { transform: scale(1.06); }
  .mosaic-chip {
    position: absolute;
    left: var(--space-2);
    right: var(--space-2);
    bottom: var(--space-2);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.25rem;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--r-sm);
    background: var(--surface-raised);
    color: var(--ink);
    font-size: var(--text-xs);
    font-weight: 700;
    line-height: 1.2;
  }
  .mosaic-chip :global(svg) { flex: none; color: var(--accent-ink); }
  /* On a phone the tile is too narrow for a word: the chip keeps the icon and
     the label stays for screen readers, which read it as the link's name. */
  @media (max-width: 39.99rem) {
    .mosaic-chip { left: auto; right: var(--space-2); width: 2.25rem; justify-content: center; padding: 0; }
    .mosaic-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .mosaic-img { aspect-ratio: 1; }
  }

  .jump {
    position: sticky;
    top: var(--header-h);
    z-index: 50;
    background: var(--surface-raised);
    border-bottom: 1px solid var(--line);
  }
  .jump ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--space-1);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .jump ul::-webkit-scrollbar { display: none; }
  .jump a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 52px;
    padding-inline: var(--space-3);
    white-space: nowrap;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink-soft);
    border-bottom: 2px solid transparent;
  }
  .jump a:hover { color: var(--ink); border-bottom-color: var(--accent); }
  .jump a :global(svg) { flex: none; color: var(--accent-ink); }
  @media (min-width: 64rem) { .jump ul { justify-content: space-between; } }

  .families { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(4.5rem, 3rem + 5vw, 8rem); }
  .family {
    display: grid;
    gap: var(--space-6);
    align-items: center;
    scroll-margin-top: calc(var(--header-h) + 52px + var(--space-6));
  }
  @media (min-width: 64rem) {
    .family { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: var(--space-9); }
    .family--flip { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); }
    .family--flip .fam-media { order: 2; }
  }
  .fam-media { aspect-ratio: 4 / 3; border-radius: var(--r-lg); box-shadow: var(--shadow-2); }
  .fam-media :global(picture) { height: 100%; }
  .fam-n { font-family: var(--font-display); font-size: 1.5rem; color: var(--accent-ink); margin-bottom: var(--space-3); }
  .fam-h { font-size: var(--text-h2); }
  .fam-sectors { margin-top: var(--space-5); }
  .fam-blurb { margin-top: var(--space-5); font-size: var(--text-lede); line-height: 1.55; color: var(--ink-soft); }
  .fam-label {
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
  }
  .fam-svcs { list-style: none; margin: var(--space-3) 0 0; padding: 0; display: grid; gap: var(--space-2); }
  .fam-svc {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3);
    border-radius: var(--r-sm);
    border: 1px solid var(--line);
    background: var(--surface-raised);
    color: var(--ink);
    font-weight: 600;
    transition: border-color var(--dur-hover) var(--ease-out), transform var(--dur-hover) var(--ease-out);
  }
  .fam-svc:hover { border-color: var(--ink); transform: translate3d(4px, 0, 0); color: var(--ink); }
  .fam-svc :global(.fam-go) { margin-left: auto; color: var(--accent-ink); }
  .fam-svc .icon-tile { width: 2.5rem; height: 2.5rem; }
</style>
