---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
const title = 'Page not found — Reliance Business Partners';
const description =
  'That page does not exist. Here are the main parts of the Reliance Business Partners site, and how to reach the firm directly.';
---
<Base title={title} description={description}>
  <section class="section">
    <div class="container prose stack">
      <p class="eyebrow">404</p>
      <h1>That page does not exist.</h1>
      <p>
        The link may be old, or the address may have a typo in it. These are the places most people are looking for.
      </p>
      <ul class="ticks">
        <li><a href="/packages/">Incorporation packages and prices</a></li>
        <li><a href="/#estimate">The fee estimator</a></li>
        <li><a href="/services/">What we work on</a></li>
        <li><a href="/about/">About the firm</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
      <p>
        Or call <a class="tnum" href={site.phoneHref}>{site.phone}</a> and tell us what you were looking for.
      </p>
    </div>
  </section>
</Base>
