---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { site, serviceLines, engagement, packages } from '../data/site';

/* A mailto LINK, not a form action. Links are not submissions, so no browser
   warns about them, and the prefilled body asks for what a form would. */
const mailtoBody = `What I need help with:


My name:

My company, if it already exists:

A number or e-mail to reply to:
`;

const mailtoHref =
  `mailto:${site.email}` +
  `?subject=${encodeURIComponent('Enquiry')}` +
  `&body=${encodeURIComponent(mailtoBody)}`;

/* A plain search link, opened only when the visitor taps it. No map is
   embedded, so nothing third-party loads on this page. */
const fullAddress = `${site.address.street}, ${site.address.locality}, Sri Lanka`;
const mapsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(fullAddress)}`;

const money = (n: number) => n.toLocaleString('en-US');

const title = 'Contact — Reliance Business Partners';
const description =
  'Call or e-mail Reliance Business Partners at No. 464, High Level Road, Gangodawila, Nugegoda. Tell us what you need and we will tell you what it costs.';
---
<Base title={title} description={description} overHero>
  <PageHero
    eyebrow="Contact"
    title="Tell us what you <em>need.</em>"
    lede="Describe it in your own words. You do not need the accounting term for it, and the first conversation costs nothing."
    image="contact"
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Contact' }]}
  >
    <a class="btn btn--primary btn--lg tnum" href={site.phoneHref}><Icon name="phone" size={18} stroke={2} /> Call {site.phone}</a>
    <a class="btn btn--ghost btn--lg" href={mailtoHref}><Icon name="mail" size={18} stroke={2} /> Write an e-mail</a>
  </PageHero>

  {/*
    NOT a form.

    A form with action="mailto:" makes the browser warn that the submission is
    not secure, because the target is not HTTPS, and it then fails outright on
    most phones. So the enquiry is a set of direct actions instead: they work on
    every device, with no JavaScript and no third-party service holding the
    client's messages. The e-mail action carries a prefilled subject and body,
    so it asks for the same things a form would have.
  */}
  <section class="section" aria-labelledby="ways-h">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Three ways in</p>
        <h2 id="ways-h">Each one reaches <em>the same people.</em></h2>
      </div>

      <ul class="ways">
        <li class="way way--call on-invert">
          <span class="way-icon"><Icon name="phone-call" size={22} /></span>
          <h3 class="way-h">Call</h3>
          <a class="way-big tnum link-plain" href={site.phoneHref}>{site.phone}</a>
          <p class="way-note">The quickest way to find out which package fits, or what a piece of work will cost.</p>
          <a class="btn btn--primary btn--block way-btn" href={site.phoneHref}>Call now <Icon name="arrow-right" size={18} stroke={2} /></a>
        </li>
        <li class="way">
          <span class="way-icon"><Icon name="mail" size={22} /></span>
          <h3 class="way-h">Write</h3>
          <a class="way-big way-big--mail link-plain" href={`mailto:${site.email}`}>{site.email}</a>
          <p class="way-note">The button opens your e-mail with the four questions already in it. Fill in what you know.</p>
          <a class="btn btn--dark btn--block way-btn" href={mailtoHref}>Start an e-mail <Icon name="arrow-right" size={18} stroke={2} /></a>
        </li>
        <li class="way">
          <span class="way-icon"><Icon name="map-pin" size={22} /></span>
          <h3 class="way-h">Visit</h3>
          <address class="way-addr">
            <span>{site.address.street}</span>
            <span>{site.address.locality}</span>
            <span>Sri Lanka</span>
          </address>
          <p class="way-note">Call ahead, so the person you need is in the office when you arrive.</p>
          <a class="btn btn--secondary btn--block way-btn" href={mapsHref} rel="noopener">Open in Maps <Icon name="arrow-up-right" size={18} stroke={2} /></a>
        </li>
      </ul>
    </div>
  </section>

  {/* What to say, and what happens once you have said it. */}
  <section class="section band" aria-labelledby="tell-h">
    <div class="container tell">
      <div class="tell-card">
        <p class="eyebrow">Before you call</p>
        <h2 id="tell-h">What to <em>tell us.</em></h2>
        <ul class="ticks tell-list">
          <li>Your name, and a number or e-mail we can reply to.</li>
          <li>What you need, in your own words.</li>
          <li>Whether the company already exists, or is being set up.</li>
          <li>Any date or filing deadline that already applies.</li>
        </ul>
        <p class="tell-foot">
          You do not need documents ready. Working out what is actually needed is
          part of the first conversation.
        </p>
      </div>

      <div>
        <p class="eyebrow">After you call</p>
        <h2 class="next-h">What happens <em>next.</em></h2>
        <ol class="next">
          {engagement.map((e) => (
            <li>
              <span class="step-n">{e.n}</span>
              <div>
                <h3>{e.title}</h3>
                <p>{e.detail}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  {/* Shortcuts for the visitor who already knows roughly what they want. */}
  <section class="section" aria-labelledby="route-h">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">Already know what you need?</p>
          <h2 id="route-h">Go straight <em>to it.</em></h2>
        </div>
        <p class="intro">
          Registering a company is the one piece of work with every fee published.
          The estimator adds up the package, the directors and any extras.
        </p>
      </div>

      <div class="routes">
        <a class="route route--feature link-plain on-invert" href="/packages/">
          <span class="route-k">Company incorporation</span>
          <span class="route-price display tnum"><span class="route-cur">From LKR</span> {money(packages[0].price)}</span>
          <span class="route-go">Compare the packages <Icon name="arrow-right" size={18} stroke={2} /></span>
          <Icon name="file-signature" size={168} stroke={1} class="route-deco" />
        </a>
        <a class="route route--est link-plain" href="/#estimate">
          <span class="route-k">Fee estimator</span>
          <span class="route-t">The package, the directors and any extras, added up.</span>
          <span class="route-go">Open the estimator <Icon name="arrow-right" size={18} stroke={2} /></span>
        </a>
        <ul class="route-svcs">
          {serviceLines.map((s) => (
            <li>
              <a class="route-svc link-plain" href={`/services/${s.slug}/`}>
                <Icon name={s.icon} size={20} />
                <span>{s.title}</span>
                <Icon name="arrow-right" size={16} stroke={2} class="route-arrow" />
              </a>
            </li>
          ))}
        </ul>
      </div>

      <p class="elsewhere">
        The firm is also on <a href={site.social.linkedin} rel="noopener">LinkedIn</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  /* ------------------------------------------------------------ three ways */
  .ways { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4); }
  @media (min-width: 64rem) { .ways { grid-template-columns: 1.15fr 1fr 1fr; gap: var(--space-5); } }
  .way {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: clamp(1.5rem, 1.2rem + 1vw, 2.25rem);
    background: var(--surface-raised);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    min-width: 0;
  }
  .way--call {
    background: var(--surface-invert);
    border-color: var(--surface-invert);
    position: relative;
    overflow: hidden;
  }
  .way--call::before { content: ""; position: absolute; inset: 0 0 auto 0; height: 4px; background: var(--brand-ramp); }
  .way-icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--r-sm);
    background: var(--accent-tint);
    color: var(--accent-ink);
    margin-bottom: var(--space-3);
  }
  .way--call .way-icon { background: var(--surface-invert-2); color: var(--accent-lift); }
  .way-h {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
  }
  .way--call .way-h { color: var(--muted-invert); }
  .way-big {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.35rem + 1.3vw, 2.4rem);
    line-height: 1.1;
    letter-spacing: var(--tracking-tight);
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .way-big:hover { color: var(--accent-ink); }
  /* One line, always: a phone number broken after "22" reads as two numbers. */
  .way--call .way-big { color: var(--ink-invert); font-size: clamp(1.6rem, 1.1rem + 2.2vw, 2.5rem); white-space: nowrap; }
  .way--call .way-big:hover { color: var(--accent-lift); }
  .way-big--mail { font-size: clamp(1.6rem, 1.3rem + 1vw, 2.1rem); }
  .way-addr { font-style: normal; display: grid; font-family: var(--font-display); font-size: 1.45rem; line-height: 1.3; }
  .way-note { color: var(--ink-soft); font-size: var(--text-sm); }
  .way--call .way-note { color: var(--muted-invert); }
  .way-btn { margin-top: auto; }
  .way-note { margin-bottom: var(--space-3); }

  /* ------------------------------------------------------------ tell / next */
  .tell { display: grid; gap: var(--space-8); align-items: start; }
  @media (min-width: 64rem) { .tell { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-9); } }
  .tell-card {
    padding: clamp(1.5rem, 1.2rem + 1.4vw, 2.75rem);
    background: var(--surface-raised);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-1);
  }
  .tell-list { margin-top: var(--space-6); }
  .tell-foot { margin-top: var(--space-6); padding-top: var(--space-5); border-top: 1px solid var(--line); color: var(--muted); font-size: var(--text-sm); }
  .next-h { margin-bottom: var(--space-6); }
  .next { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-6); position: relative; }
  .next li { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--space-5); position: relative; }
  /* The rule joins the numerals, and stops at the last one. */
  .next li:not(:last-child)::before {
    content: "";
    position: absolute;
    left: 1.5rem;
    top: 3.25rem;
    bottom: calc(-1 * var(--space-6) + 0.25rem);
    width: 1px;
    background: var(--line-strong);
  }
  .next h3 { font-size: var(--text-h4); font-family: var(--font-sans); font-weight: 700; letter-spacing: 0; margin-top: 0.6rem; }
  .next p { margin-top: var(--space-2); color: var(--ink-soft); font-size: var(--text-sm); }

  /* ------------------------------------------------------------ routes */
  .routes { display: grid; gap: var(--space-4); }
  @media (min-width: 52rem) { .routes { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 72rem) { .routes { grid-template-columns: 1.1fr 0.9fr 1.3fr; gap: var(--space-5); } }
  .route {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: clamp(1.5rem, 1.2rem + 1vw, 2.25rem);
    border-radius: var(--r-lg);
    min-height: 15rem;
    transition: transform var(--dur-control) var(--ease-out), box-shadow var(--dur-control) var(--ease-out);
  }
  .route:hover { transform: translate3d(0, -4px, 0); box-shadow: var(--shadow-2); }
  .route--feature { background: var(--surface-invert); color: var(--ink-invert); position: relative; overflow: hidden; }
  .route--feature:hover { color: var(--ink-invert); }
  /* The service's own icon, drawn large and faint into the corner. */
  .route--feature :global(.route-deco) {
    position: absolute;
    right: -1.5rem;
    bottom: -1.5rem;
    color: var(--surface-invert-2);
    pointer-events: none;
  }
  .route--feature .route-k, .route--feature .route-price, .route--feature .route-go { position: relative; }
  .route--est { background: var(--accent-tint); color: var(--ink); }
  .route--est:hover { color: var(--ink); }
  .route-k { font-size: var(--text-xs); font-weight: 700; letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; color: var(--accent-ink); }
  .route--feature .route-k { color: var(--accent-lift); }
  .route-price { font-size: clamp(2.4rem, 1.9rem + 1.8vw, 3.4rem); line-height: 1; letter-spacing: var(--tracking-display); }
  .route-cur { font-family: var(--font-sans); font-size: max(0.8rem, 0.3em); font-weight: 700; letter-spacing: 0.06em; color: var(--muted-invert); vertical-align: 0.9em; }
  .route-t { font-family: var(--font-display); font-size: var(--text-h3); line-height: 1.2; letter-spacing: var(--tracking-tight); }
  .route-go { margin-top: auto; display: inline-flex; align-items: center; gap: var(--space-2); font-weight: 700; font-size: var(--text-sm); }
  .route-go :global(svg) { transition: transform var(--dur-hover) var(--ease-out); }
  .route:hover .route-go :global(svg) { transform: translate3d(4px, 0, 0); }

  .route-svcs {
    list-style: none;
    margin: 0;
    padding: var(--space-2) var(--space-5);
    background: var(--surface-raised);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    display: grid;
    align-content: center;
  }
  @media (min-width: 52rem) and (max-width: 71.99rem) { .route-svcs { grid-column: 1 / -1; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-6); } }
  .route-svc {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 3rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-weight: 600;
    font-size: var(--text-sm);
  }
  .route-svcs li:last-child .route-svc { border-bottom: 0; }
  @media (min-width: 52rem) and (max-width: 71.99rem) { .route-svcs li:nth-last-child(2) .route-svc { border-bottom: 0; } }
  .route-svc :global(svg) { color: var(--accent-ink); flex: none; }
  .route-svc :global(.route-arrow) { margin-left: auto; transition: transform var(--dur-hover) var(--ease-out); }
  .route-svc:hover { color: var(--accent-ink); }
  .route-svc:hover :global(.route-arrow) { transform: translate3d(4px, 0, 0); }

  .elsewhere { margin-top: var(--space-7); color: var(--muted); font-size: var(--text-sm); }
</style>
