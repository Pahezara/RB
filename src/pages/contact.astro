---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { site, engagement, whatsappHref } from '../data/site';
import { categories, services } from '../data/services';

/* [CONTENT] Contact Us. */
const title = 'Contact Reliance Business Partners | Discuss Your Business';
const description =
  'Contact RBPL in Nugegoda to discuss company registration, accounting, payroll, systems, business advisory or investment support.';

const fullAddress = `${site.address.street}, ${site.address.locality}, Sri Lanka`;
const mapsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(fullAddress)}`;
const wa = whatsappHref('Hello Reliance Business Partners, I would like to discuss my requirements.');

/* Each service slug maps to its menu category, so a visitor arriving from a
   service page ("?service=payroll") lands with the right group selected. */
const serviceMap = Object.fromEntries(services.map((s) => [s.slug, { category: s.category, title: s.title }]));

/* [CONTENT] "Common questions". */
const questions = [
  { q: 'Can I engage you for one service?', a: 'Yes. Individual services or combined engagements can be scoped.' },
  { q: 'Do you work with international businesses?', a: 'Yes. Tell us your location and reporting needs so we can scope the support required.' },
];
---
<Base title={title} description={description} overHero>
  <PageHero
    eyebrow="Contact Us"
    title="Tell us what your business <em>needs next.</em>"
    lede="Share a brief outline of your requirement and the stage your business has reached. We will discuss the appropriate scope and the information needed to prepare a proposal."
    image="contact"
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Contact Us' }]}
  >
    <a class="btn btn--primary btn--lg" href={wa} target="_blank" rel="noopener"><Icon name="message-circle" size={18} stroke={2} /> Discuss on WhatsApp</a>
    <a class="btn btn--ghost btn--lg tnum" href={site.phoneHref}><Icon name="phone" size={18} stroke={2} /> {site.phone}</a>
  </PageHero>

  <section class="section" aria-labelledby="form-h">
    <div class="container contact">
      {/*
        THE ENQUIRY FORM. It has no server to post to (see DECISIONS D10), so on
        submit it writes the enquiry into the visitor's own e-mail app, or into
        WhatsApp if that is the contact method they chose, ready to send. Nothing
        is sent to, or stored by, this website. Without JavaScript the button
        stays disabled and the note beneath it gives the direct routes, because
        a plain GET would put the visitor's details into the address bar.
      */}
      <form class="enquiry" id="enquiry" novalidate aria-labelledby="form-h" data-email={site.email} data-wa={site.whatsapp}>
        <h2 id="form-h">Send an enquiry</h2>
        <p class="form-lede">Fields marked <span aria-hidden="true">*</span><span class="visually-hidden">with an asterisk</span> are required.</p>

        <div class="grid2">
          <div class="field">
            <label for="f-name">Full name <span class="req" aria-hidden="true">*</span></label>
            <input id="f-name" name="name" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="f-email">Business email <span class="req" aria-hidden="true">*</span></label>
            <input id="f-email" name="email" type="email" autocomplete="email" required />
          </div>
          <div class="field">
            <label for="f-company">Company name</label>
            <input id="f-company" name="company" autocomplete="organization" />
          </div>
          <div class="field">
            <label for="f-country">Country <span class="req" aria-hidden="true">*</span></label>
            <input id="f-country" name="country" autocomplete="country-name" required />
          </div>
          <div class="field">
            <label for="f-phone">Phone with country code</label>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" placeholder="+94 …" />
          </div>
          <div class="field">
            <label for="f-service">Service required <span class="req" aria-hidden="true">*</span></label>
            <select id="f-service" name="service" required>
              <option value="">Choose a service area</option>
              {categories.map((c) => <option value={c.slug}>{c.title}</option>)}
              <option value="other">Other</option>
            </select>
          </div>
          <div class="field field--wide">
            <label for="f-stage">Business stage</label>
            <select id="f-stage" name="stage">
              <option value="">Choose one, if it helps</option>
              <option>Planning to start</option>
              <option>Recently established</option>
              <option>Established and operating</option>
              <option>Expanding or entering a new market</option>
              <option>Raising funds, selling or restructuring</option>
            </select>
          </div>
          <div class="field field--wide">
            <label for="f-desc">Brief description <span class="req" aria-hidden="true">*</span></label>
            <textarea id="f-desc" name="description" rows="6" required aria-describedby="f-desc-hint"></textarea>
            <p class="hint" id="f-desc-hint">
              Tell us your objective, the country involved and any important timing.
              Please do not include bank details, identity documents or confidential
              transaction files in this initial enquiry.
            </p>
          </div>
          <fieldset class="field field--wide method">
            <legend>Preferred contact method</legend>
            <div class="radios">
              <label><input type="radio" name="prefer" value="Email" checked /> Email</label>
              <label><input type="radio" name="prefer" value="Phone" /> Phone</label>
              <label><input type="radio" name="prefer" value="WhatsApp" /> WhatsApp</label>
            </div>
          </fieldset>
        </div>

        <p class="notice">
          We use the information you provide to respond to your enquiry and discuss the
          services you request. Read our <a href="/privacy/">Privacy Notice</a> for more information.
        </p>

        <div class="submit-row">
          <button class="btn btn--primary btn--lg" type="submit" disabled data-submit>Send My Enquiry <Icon name="send" size={18} stroke={2} /></button>
          <p class="how" data-how>Your enquiry opens in your email app, ready to send.</p>
        </div>
        <p class="status" role="status" aria-live="polite" data-status></p>
        <noscript>
          <p class="status status--show">
            This form needs JavaScript. Please e-mail <a href={`mailto:${site.email}`}>{site.email}</a>, call {site.phone}, or message us on WhatsApp.
          </p>
        </noscript>
      </form>

      <aside class="side" aria-label="Contact details">
        <div class="card-dark on-invert">
          <p class="eyebrow">Reach us directly</p>
          <a class="big tnum link-plain" href={site.phoneHref}>{site.phone}</a>
          <a class="line link-plain" href={`mailto:${site.email}`}><Icon name="mail" size={18} /> {site.email}</a>
          <a class="line link-plain" href={wa} target="_blank" rel="noopener"><Icon name="message-circle" size={18} /> WhatsApp</a>
        </div>
        <div class="card-plain">
          <p class="side-k">Office</p>
          <address>
            <strong>{site.legalName}</strong>
            <span>{site.address.street}</span>
            <span>{site.address.locality}</span>
            <span>Sri Lanka</span>
          </address>
          <a class="btn btn--secondary btn--block" href={mapsHref} rel="noopener" target="_blank">Open in Maps <Icon name="arrow-up-right" size={18} stroke={2} /></a>
        </div>
        <div class="card-plain">
          <p class="side-k">Common questions</p>
          <dl class="qa">
            {questions.map((x) => (
              <div>
                <dt>{x.q}</dt>
                <dd>{x.a}</dd>
              </div>
            ))}
          </dl>
        </div>
      </aside>
    </div>
  </section>

  <section class="section band" aria-labelledby="next-h">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">After you get in touch</p>
          <h2 id="next-h">What happens <em>next.</em></h2>
        </div>
        <p class="intro">
          Registering a company? The <a href="/packages/">packages</a> and the{' '}
          <a href="/#estimate">instant quotation</a> give you the professional fee now.
        </p>
      </div>
      <ol class="steps steps--3">
        {engagement.map((e) => (
          <li class="step">
            <span class="step-n">{e.n}</span>
            <h3>{e.title}</h3>
            <p>{e.detail}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>

<script define:vars={{ serviceMap }}>
  const form = document.getElementById('enquiry');
  if (form) {
    const submit = form.querySelector('[data-submit]');
    const status = form.querySelector('[data-status]');
    const how = form.querySelector('[data-how]');
    submit.disabled = false;

    // Arriving from a service page: select its group and name it in the brief.
    const q = new URLSearchParams(location.search).get('service');
    if (q && serviceMap[q]) {
      form.elements.namedItem('service').value = serviceMap[q].category;
      form.elements.namedItem('description').value = `I am interested in: ${serviceMap[q].title}.\n\n`;
    }

    const methodNote = () => {
      const m = form.elements.namedItem('prefer').value;
      how.textContent = m === 'WhatsApp'
        ? 'Your enquiry opens in WhatsApp, ready to send.'
        : 'Your enquiry opens in your email app, ready to send.';
    };
    form.addEventListener('change', methodNote);
    methodNote();

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      status.classList.remove('status--error', 'status--show');
      if (!form.checkValidity()) {
        const bad = form.querySelector(':invalid');
        status.textContent = 'Please complete the required fields marked with an asterisk.';
        status.classList.add('status--error', 'status--show');
        bad && bad.focus();
        return;
      }
      const f = new FormData(form);
      const sel = form.elements.namedItem('service');
      const service = sel.options[sel.selectedIndex].text;
      const lines = [
        'Enquiry from the RBPL website',
        '',
        `Name: ${f.get('name')}`,
        `Business email: ${f.get('email')}`,
        f.get('company') ? `Company: ${f.get('company')}` : null,
        `Country: ${f.get('country')}`,
        f.get('phone') ? `Phone: ${f.get('phone')}` : null,
        `Service required: ${service}`,
        f.get('stage') ? `Business stage: ${f.get('stage')}` : null,
        `Preferred contact: ${f.get('prefer')}`,
        '',
        'Brief description:',
        String(f.get('description')).trim(),
      ].filter((l) => l !== null).join('\n');

      try {
        if (f.get('prefer') === 'WhatsApp') {
          const url = `https://wa.me/${form.dataset.wa}?text=${encodeURIComponent(lines)}`;
          // Not 'noopener' in the features: with it, window.open returns null
          // even on success, and the fallback would open WhatsApp twice.
          const w = window.open(url, '_blank');
          if (w) w.opener = null; else location.href = url;
        } else {
          location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent('Website enquiry: ' + service)}&body=${encodeURIComponent(lines)}`;
        }
        status.textContent = 'Thank you. Your enquiry is ready to send. Once you send it, our team will review your requirements and contact you using the details provided.';
        status.classList.add('status--show');
      } catch {
        status.textContent = `We could not send your enquiry. Please try again or email ${form.dataset.email}.`;
        status.classList.add('status--error', 'status--show');
      }
    });
  }
</script>

<style>
  .contact { display: grid; gap: var(--space-7); align-items: start; }
  @media (min-width: 64rem) { .contact { grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.9fr); gap: var(--space-8); } }

  .enquiry {
    padding: clamp(1.5rem, 1.2rem + 1.4vw, 2.75rem);
    background: var(--surface-raised);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-1);
  }
  .enquiry h2 { font-size: var(--text-h3); }
  .form-lede { margin-top: var(--space-2); color: var(--muted); font-size: var(--text-sm); }
  .grid2 { display: grid; gap: var(--space-5); margin-top: var(--space-6); }
  @media (min-width: 40rem) {
    .grid2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .field--wide { grid-column: 1 / -1; }
  }
  .field { display: grid; gap: var(--space-2); min-width: 0; }
  .field label, .method legend { font-size: var(--text-sm); font-weight: 650; color: var(--ink); }
  .req { color: var(--accent-ink); }
  .field input, .field select, .field textarea {
    width: 100%;
    min-height: 48px;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-sm);
    background: var(--surface-raised);
    color: var(--ink);
    font-size: 1rem;
    transition: border-color var(--dur-hover) var(--ease-out), box-shadow var(--dur-hover) var(--ease-out);
  }
  .field textarea { resize: vertical; line-height: 1.5; }
  .field input:focus-visible, .field select:focus-visible, .field textarea:focus-visible { outline: none; border-color: var(--ink); box-shadow: 0 0 0 3px var(--focus-ring); }
  .hint { font-size: var(--text-xs); color: var(--muted); line-height: 1.5; }
  .method { border: 0; padding: 0; margin: 0; }
  .radios { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); margin-top: var(--space-2); }
  .radios label { display: inline-flex; align-items: center; gap: var(--space-2); min-height: var(--tap-min); font-weight: 500; cursor: pointer; }
  .radios input { width: 1.15rem; height: 1.15rem; min-height: 0; accent-color: var(--accent-deep); }
  .notice { margin-top: var(--space-6); font-size: var(--text-xs); color: var(--muted); line-height: 1.55; }
  .submit-row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-5); margin-top: var(--space-5); }
  .how { font-size: var(--text-xs); color: var(--muted); }
  .status { display: none; margin-top: var(--space-4); padding: var(--space-4); border-radius: var(--r-sm); background: var(--accent-tint); color: var(--ink); font-size: var(--text-sm); }
  .status--show { display: block; }
  .status--error { background: var(--surface-raised); border: 1px solid var(--danger); color: var(--danger); }

  .side { display: grid; gap: var(--space-4); }
  @media (min-width: 64rem) { .side { position: sticky; top: calc(var(--header-h) + var(--space-6)); } }
  .card-dark {
    display: grid;
    gap: var(--space-2);
    padding: var(--pad-card);
    background: var(--surface-invert);
    border-radius: var(--r-lg);
    position: relative;
    overflow: hidden;
  }
  .card-dark::before { content: ""; position: absolute; inset: 0 0 auto 0; height: 4px; background: var(--brand-ramp); }
  .big { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.2rem); letter-spacing: var(--tracking-tight); color: var(--ink-invert); white-space: nowrap; min-height: var(--tap-min); display: inline-flex; align-items: center; }
  .big:hover { color: var(--accent-lift); }
  .line { display: inline-flex; align-items: center; gap: var(--space-2); min-height: var(--tap-min); color: var(--ink-invert); font-weight: 600; }
  .line :global(svg) { color: var(--accent-lift); }
  .line:hover { color: var(--accent-lift); }
  .card-plain { display: grid; gap: var(--space-4); padding: var(--pad-card); background: var(--surface-raised); border: 1px solid var(--line); border-radius: var(--r-lg); }
  .side-k { font-size: var(--text-xs); font-weight: 700; letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; color: var(--accent-ink); }
  address { font-style: normal; display: grid; gap: 2px; color: var(--ink-soft); }
  address strong { color: var(--ink); }
  .qa { margin: 0; display: grid; gap: var(--space-4); }
  .qa dt { font-weight: 700; }
  .qa dd { margin: var(--space-1) 0 0; color: var(--ink-soft); font-size: var(--text-sm); }

  @media (min-width: 68rem) { .steps--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); --cols: 3; } }
</style>
