---
import { site, serviceLines } from '../data/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/glass.css';
import '../styles/components.css';

interface Props {
  title: string;
  description: string;
  /** Set on the home page so the header can sit over the hero. */
  overHero?: boolean;
}
const { title, description, overHero = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;

// Per-page OG image. The slug mirrors the route, and scripts/make-og.mjs writes
// exactly these files, so the two cannot drift apart silently.
const ogSlug = Astro.url.pathname.replace(/^\/|\/$/g, '').replace(/\//g, '-') || 'default';
const ogImage = new URL(`/og/${ogSlug}.jpg`, site.url).href;

/*
 * JSON-LD. AccountingService rather than the generic ProfessionalService,
 * because that is what the firm is.
 *
 * There is no openingHoursSpecification and no postal code. Neither exists in
 * the business profile or in anything else the client has supplied, and a
 * plausible guess in structured data is worse than an absent field: search
 * engines will publish it as fact.
 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AccountingService',
  name: site.legalName,
  alternateName: site.shortName,
  slogan: site.tagline,
  url: site.url,
  telephone: site.phone,
  email: site.email,
  foundingDate: String(site.founded),
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.locality,
    addressRegion: site.address.region,
    addressCountry: site.address.country,
  },
  areaServed: { '@type': 'Country', name: 'Sri Lanka' },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Business services',
    itemListElement: serviceLines.map((s) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: s.title, description: s.blurb },
    })),
  },
  sameAs: [site.social.linkedin],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/icon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/icon-512.png" sizes="512x512" type="image/png" />
    <link rel="apple-touch-icon" href="/icon-180.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#051e35" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header overHero={overHero} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
