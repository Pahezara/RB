---
import { site, serviceLines } from '../data/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/glass.css';
import '../styles/components.css';
import '../styles/motion.css';

interface Props {
  title: string;
  description: string;
  /** Set on the home page so the header can sit over the hero. */
  overHero?: boolean;
}
const { title, description, overHero = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;

// Per-page OG image. The slug mirrors the route, and scripts/make-og.mjs writes
// exactly these files, so the two cannot drift apart silently.
const ogSlug = Astro.url.pathname.replace(/^\/|\/$/g, '').replace(/\//g, '-') || 'default';
const ogImage = new URL(`/og/${ogSlug}.jpg`, site.url).href;

/*
 * JSON-LD. AccountingService rather than the generic ProfessionalService,
 * because that is what the firm is.
 *
 * There is no openingHoursSpecification and no postal code. Neither exists in
 * the business profile or in anything else the client has supplied, and a
 * plausible guess in structured data is worse than an absent field: search
 * engines will publish it as fact.
 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AccountingService',
  name: site.legalName,
  alternateName: site.shortName,
  slogan: site.tagline,
  url: site.url,
  telephone: site.phone,
  email: site.email,
  foundingDate: String(site.founded),
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.locality,
    addressRegion: site.address.region,
    addressCountry: site.address.country,
  },
  areaServed: { '@type': 'Country', name: 'Sri Lanka' },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Business services',
    itemListElement: serviceLines.map((s) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: s.title, description: s.blurb },
    })),
  },
  sameAs: [site.social.linkedin],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/icon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/icon-512.png" sizes="512x512" type="image/png" />
    <link rel="apple-touch-icon" href="/icon-180.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#04152a" />

    {/* Inter, for every device that is not an Apple one (those use the system
        San Francisco and never request it). Preloaded so that it arrives
        before first paint and font-display: optional has nothing to fall back
        from. */}
    <link rel="preload" href="/fonts/inter-latin-opsz.woff2" as="font" type="font/woff2" crossorigin />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header overHero={overHero} />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      /* Scroll reveal. Blocks that start below the fold fade and rise into place
         as they come into view, siblings in a grid a beat apart. Anything
         already on screen is left alone, so nothing on the first screen ever
         flashes; with this script blocked, or under reduced motion, nothing is
         hidden at all. The styles are in src/styles/motion.css. */
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduce && 'IntersectionObserver' in window) {
        const SEL = [
          '.section-head', '.story-body', '.card', '.tile', '.line', '.family',
          '.tier', '.step', '.director', '.way', '.route', '.route-svcs',
          '.cover', '.rel > li', '.others > li', '.credit', '.kit-card',
          '.faq', '.faq-side', '.figures', '.values', '.team-viz', '.vv-quote',
          '.board-grid > li', '.ind-grid > li', '.pillars > li', '.tell-card',
          '.next', '.mini-pkg', '.matrix', '.table-wrap', '.estimate',
          '.cta-card', '.go > li', '.legal-body > *', '.sect-chips',
          '.fee-list', '.panel', '.solid-panel', '.marquee', '.vision-quote',
        ].join(',');
        const all = Array.from(document.querySelectorAll<HTMLElement>(SEL));
        // Only the outermost match animates: a card inside a revealed row must
        // not rise a second time.
        const els = all.filter((el) =>
          !el.parentElement?.closest(SEL) &&
          !el.closest('.site-header, .page-hero, .hero, .site-footer'));
        const fold = window.innerHeight * 0.92;
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            e.target.classList.add('rv-in');
            io.unobserve(e.target);
          }
        }, { rootMargin: '0px 0px -6% 0px', threshold: 0.06 });
        const seen = new Map<Element, number>();
        for (const el of els) {
          if (el.getBoundingClientRect().top < fold) continue;
          const group = el.closest('ul, ol, .grid') ?? el.parentElement!;
          const i = seen.get(group) ?? 0;
          seen.set(group, i + 1);
          el.style.setProperty('--rv-delay', `${Math.min(i, 5) * 70}ms`);
          el.classList.add('rv');
          io.observe(el);
        }
        // Printing, or a jump to the end with the keyboard, must never find a
        // block still waiting to appear.
        const showAll = () => els.forEach((el) => el.classList.add('rv-in'));
        window.addEventListener('beforeprint', showAll);
      }
    </script>
  </body>
</html>
